sceNpTrophy: report no required disk space once the trophy set is installed.

GetRequiredDiskSpace always answered 1 MB. Firmware answers 0 after the first RegisterContext installed the set;
Resistance 3 reads a non-zero answer as "not installed" and shows its install prompt and install pass on every boot.
RegisterContext now writes the trophy file (the HLE's record of an installed set) and GetRequiredDiskSpace checks it.
The registration test also builds again: cellSysutil.c defines g_ps3_guest_caller and calls two more hooks.

Upstream: not proposed yet. The fixture's three pump stubs and the dropped g_ps3_guest_caller are PR #607 (rebase when it merges).
---

diff --git a/libs/network/sceNpTrophy.c b/libs/network/sceNpTrophy.c
index d956e6dd..eb577c36 100644
--- a/libs/network/sceNpTrophy.c
+++ b/libs/network/sceNpTrophy.c
@@ -41,2 +41,5 @@
 static int s_trophy_initialized = 0;
+
+/* Disk space a trophy set needs before it is installed (typical pack size). */
+#define TROPHY_PACK_SIZE ((u64)(1024 * 1024))
 static char s_storage_path[512] = "gamedata/trophies";
@@ -173,2 +176,16 @@ static void trophy_load(TrophyContext* ctx)
 
+/* The saved file doubles as the installed trophy set: firmware installs the
+ * set on the first sceNpTrophyRegisterContext and it stays installed. */
+static int trophy_installed(const TrophyContext* ctx)
+{
+    char filepath[1024];
+    FILE* fp;
+
+    trophy_get_filepath(&ctx->commId, filepath, sizeof(filepath));
+    fp = fopen(filepath, "r");
+    if (!fp) return 0;
+    fclose(fp);
+    return 1;
+}
+
 static u32 trophy_count_unlocked(TrophyContext* ctx)
@@ -338,2 +355,6 @@ s32 sceNpTrophyRegisterContext(SceNpTrophyContext context,
     s_contexts[context].registered = 1;
+    /* Registration installs the set; record it so the next boot's
+     * sceNpTrophyGetRequiredDiskSpace reports nothing left to install. */
+    if (!trophy_installed(&s_contexts[context]))
+        trophy_save(&s_contexts[context]);
 
@@ -385,4 +406,9 @@ s32 sceNpTrophyGetRequiredDiskSpace(SceNpTrophyContext context,
      * boot bails. (Same LE-write class as the cellUserInfo fix.) */
-    *reqSpace = ps3_bswap64((u64)(1024 * 1024)); /* 1 MB, big-endian */
-    printf("[sceNpTrophy] GetRequiredDiskSpace(ctx=%d) -> 1MB\n", context);
+    /* Once the set is installed nothing more is required. Resistance 3 reads
+     * a non-zero answer as "trophies not installed" and puts up its install
+     * prompt and install pass on every boot. */
+    u64 required = trophy_installed(&s_contexts[context]) ? 0 : TROPHY_PACK_SIZE;
+    *reqSpace = ps3_bswap64(required); /* big-endian */
+    printf("[sceNpTrophy] GetRequiredDiskSpace(ctx=%d) -> %llu bytes\n",
+           context, (unsigned long long)required);
     return CELL_OK;
diff --git a/libs/network/tests/test_trophy_registration.c b/libs/network/tests/test_trophy_registration.c
index cdbee09e..ea9356b5 100644
--- a/libs/network/tests/test_trophy_registration.c
+++ b/libs/network/tests/test_trophy_registration.c
@@ -15,3 +15,5 @@ void spu_lockline_lock(void) {}
 void spu_lockline_unlock(void) {}
-ps3_guest_caller_fn g_ps3_guest_caller;
+void cellMsgDialog_tick(void) {}
+void np_psnr_pump(void) {}
+void ps3_np_eula_tick(void) {}   /* cellSysutil.c: the PSN terms check (#542) */
 static unsigned calls;
@@ -35,2 +37,4 @@ int main(void)
     assert(sceNpTrophyCreateHandle((void*)0x204) == CELL_OK);
+    assert(sceNpTrophyGetRequiredDiskSpace(1, 1, (void*)0x208, 0) == CELL_OK);
+    assert(vm_read64(0x208) == TROPHY_PACK_SIZE);
     assert(sceNpTrophyRegisterContext(1, 1, 0x300, 0xCAFE, 0) == SCE_NP_TROPHY_ERROR_UNKNOWN);
@@ -39,2 +43,5 @@ int main(void)
     assert(calls == 1 && s_contexts[1].registered);
+    /* Registration installed the set: nothing more to install. */
+    assert(sceNpTrophyGetRequiredDiskSpace(1, 1, (void*)0x208, 0) == CELL_OK);
+    assert(vm_read64(0x208) == 0);
     cellSysutilCheckCallback(); assert(calls == 2);
