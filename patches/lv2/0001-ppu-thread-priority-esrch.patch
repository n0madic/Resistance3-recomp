sys_ppu_thread_get_priority: answer ESRCH for a thread that has exited.

lv2 does that whether or not the thread was joined, and titles poll it to learn that a worker is done. Resistance 3's
boot state machine waits for its save-data "Check Thread" this way; with CELL_OK it stayed in state 3 forever and the
screen stayed black after the Insomniac logo. The thread is created without SYS_PPU_THREAD_CREATE_JOINABLE: since
the pin frees the slot of such a thread when it ends (#409), the table no longer knows it, and the query took the
"thread not spawned here" answer (CELL_OK, priority 1000). Any id up to the highest one sys_ppu_thread_create has
handed out is now a thread that ended (ESRCH), joinable or not; ids above it keep the default answer.

test_ppu_thread_slots covers the freed slot, the never-created id, the live main thread and a finished joinable thread.

Upstream: not proposed yet.

---

diff --git a/runtime/syscalls/sys_ppu_thread.c b/runtime/syscalls/sys_ppu_thread.c
index c64b0b8..cfa2488 100644
--- a/runtime/syscalls/sys_ppu_thread.c
+++ b/runtime/syscalls/sys_ppu_thread.c
@@ -91,2 +91,6 @@ static int find_free_slot(void)
 
+/* The highest thread id sys_ppu_thread_create has handed out. A free slot at or below it belonged to a thread that
+ * has ended; above it, the id was never a thread of this table. Under the table lock. */
+static uint64_t s_thread_id_hwm;
+
 /* Find thread by ID. The ID is the index + 1 (0 is invalid). */
@@ -385,2 +389,3 @@ int64_t sys_ppu_thread_create(ppu_context* ctx)
     t->ctx.thread_id = thread_id;
+    if (thread_id > s_thread_id_hwm) s_thread_id_hwm = thread_id;
 
@@ -1126,2 +1131,8 @@ int64_t sys_ppu_thread_get_priority(ppu_context* ctx)
     ppu_thread_info* t = find_thread(tid);
+    if (!t && tid >= 1 && tid <= s_thread_id_hwm) {
+        /* A thread that ended and freed its slot (created without SYS_PPU_THREAD_CREATE_JOINABLE): lv2 answers
+         * ESRCH, as for the FINISHED joinable one below. */
+        table_unlock();
+        return (int64_t)(int32_t)CELL_ESRCH;
+    }
     if (!t) {
@@ -1146,2 +1157,9 @@ int64_t sys_ppu_thread_get_priority(ppu_context* ctx)
     }
+    if (t->state == PPU_THREAD_STATE_FINISHED) {
+        /* lv2 answers ESRCH once the thread has exited, joined or not. Titles poll
+         * this to learn that a worker is done: Resistance 3's boot state machine
+         * waits for its save-data "Check Thread" that way and never left state 3. */
+        table_unlock();
+        return (int64_t)(int32_t)CELL_ESRCH;
+    }
 
diff --git a/tests/test_ppu_thread_slots.c b/tests/test_ppu_thread_slots.c
index 331ef88..9a1d074 100644
--- a/tests/test_ppu_thread_slots.c
+++ b/tests/test_ppu_thread_slots.c
@@ -35,2 +35,10 @@ static int64_t create(uint64_t flags, uint64_t* tid)
 }
+/* sys_ppu_thread_get_priority(tid); *prio is the answer written for a thread the table does not know. */
+static int64_t get_priority(uint64_t tid)
+{
+    ppu_context ctx; memset(&ctx, 0, sizeof(ctx));
+    ctx.gpr[3] = tid;
+    ctx.gpr[4] = 0x200;
+    return sys_ppu_thread_get_priority(&ctx);
+}
 static int used_slots(void)       /* slots other than main that are not FREE */
@@ -64,2 +72,5 @@ int main(void)
 
+    /* 0. An id this table never handed out is not a finished thread: the sane-default answer stays. */
+    EXPECT_EQ(get_priority(PPU_THREAD_MAX), 0);
+
     /* 1. More than PPU_THREAD_MAX non-joinable threads, one after the other: every create succeeds and the slots
@@ -76,2 +87,6 @@ int main(void)
     EXPECT_EQ(ok, 3 * PPU_THREAD_MAX);
+    /* ...and asking for the priority of one that ended answers ESRCH, though its slot is free (a title polls this to
+     * learn that a worker is done). */
+    EXPECT_EQ(get_priority(2), (int64_t)(int32_t)CELL_ESRCH);
+    EXPECT_EQ(get_priority(1), 0);                           /* main is live */
     for (int i = 0; i < 1000 && used_slots(); i++) { struct timespec ts = { 0, 1000000 }; nanosleep(&ts, NULL); }
@@ -93,2 +108,3 @@ int main(void)
     EXPECT_EQ(create(0, NULL), (int64_t)(int32_t)CELL_EAGAIN);
+    EXPECT_EQ(get_priority(5), (int64_t)(int32_t)CELL_ESRCH);   /* a finished joinable thread, not yet joined */
 
