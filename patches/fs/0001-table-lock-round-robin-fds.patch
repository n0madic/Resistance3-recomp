 #include <sys/stat.h>
@@ -211,11 +212,34 @@ static char  g_dir_path[FS_MAX][1024];   /* host path per open dir (for readdir
 
-static int fd_alloc_file(FILE* f)
+/* The tables are shared by every guest thread. A title's I/O threads open and
+ * close descriptors while others seek and read (Resistance 3's FIOS scheduler
+ * and media threads cycle one fd hundreds of times a level), so a lookup and
+ * its use must not straddle a close: that dereferenced a freed FILE. Recursive,
+ * because the handlers call one another's helpers. */
+static std::recursive_mutex g_fs_lock;
+#define FS_LOCKED() std::lock_guard<std::recursive_mutex> fs_guard_(g_fs_lock)
+
+/* Hand descriptors out round-robin rather than lowest-free: a late call on a
+ * just-closed number would otherwise reach whatever file reopened it at once. */
+static int fd_alloc_slot(void)
 {
-    for (int i = 3; i < FS_MAX; i++) if (!g_files[i] && !g_dirs[i]) { g_files[i] = f; return i; }
+    static int next = 3;
+    for (int k = 0; k < FS_MAX - 3; k++) {
+        const int i = 3 + (next - 3 + k) % (FS_MAX - 3);
+        if (!g_files[i] && !g_dirs[i]) { next = i + 1 < FS_MAX ? i + 1 : 3; return i; }
+    }
     return -1;
 }
+static int fd_alloc_file(FILE* f)
+{
+    FS_LOCKED();
+    const int i = fd_alloc_slot();
+    if (i >= 0) g_files[i] = f;
+    return i;
+}
 static int fd_alloc_dir(DIR* d)
 {
-    for (int i = 3; i < FS_MAX; i++) if (!g_files[i] && !g_dirs[i]) { g_dirs[i] = d; return i; }
-    return -1;
+    FS_LOCKED();
+    const int i = fd_alloc_slot();
+    if (i >= 0) g_dirs[i] = d;
+    return i;
 }
