cellFs: serialize the descriptor tables; hand descriptors out round-robin.

Every handler looked an fd up in g_files and then used the FILE* unlocked. Resistance 3's FIOS threads open and close
one descriptor hundreds of times per level while others seek and read on it, and a close landing between the lookup
and the use crashed in ftello on the freed stream. The handlers now hold one recursive lock while they touch the
tables (the AIO completion callback runs outside it). Descriptors are also allocated round-robin instead of
lowest-free, so a late call on a number that was just closed cannot reach a file that reopened it at once.

Upstream #430 (v0.18.0) allocates and releases under a lock and reads each slot once, which keeps a close from
handing a reader NULL; a reader's snapshot can still be fclose'd under it, which is this crash. So the handlers keep
holding g_fs_lock for as long as they use the slot, and allocation (under #430's g_fd_lock) goes round-robin.

Upstream: not proposed yet.
---

diff --git a/runtime/ppu/ppu_fs.cpp b/runtime/ppu/ppu_fs.cpp
index f73907c2..69e57773 100644
--- a/runtime/ppu/ppu_fs.cpp
+++ b/runtime/ppu/ppu_fs.cpp
@@ -236,2 +236,23 @@ static char  g_dir_path[FS_MAX][1024];   /* host path per open dir (for readdir
 static std::mutex g_fd_lock;
+/* A snapshot alone does not stop a close from freeing the FILE while another
+ * thread still reads through it (Resistance 3's FIOS scheduler and media
+ * threads cycle one fd hundreds of times a level; a close between the lookup
+ * and the use crashed in ftello on the freed stream). So every handler also
+ * holds g_fs_lock for as long as it uses its slot. Recursive, because the
+ * handlers call one another's helpers. */
+static std::recursive_mutex g_fs_lock;
+#define FS_LOCKED() std::lock_guard<std::recursive_mutex> fs_guard_(g_fs_lock)
+
+/* Hand descriptors out round-robin rather than lowest-free: a late call on a
+ * just-closed number would otherwise reach whatever file reopened it at once.
+ * Called under g_fd_lock. */
+static int fd_alloc_slot(void)
+{
+    static int next = 3;
+    for (int k = 0; k < FS_MAX - 3; k++) {
+        const int i = 3 + (next - 3 + k) % (FS_MAX - 3);
+        if (!g_files[i] && !g_dirs[i]) { next = i + 1 < FS_MAX ? i + 1 : 3; return i; }
+    }
+    return -1;
+}
 static int fd_alloc_file(FILE* f)
@@ -239,9 +260,8 @@ static int fd_alloc_file(FILE* f)
     std::lock_guard<std::mutex> hold(g_fd_lock);
-    for (int i = 3; i < FS_MAX; i++)
-        if (!g_files[i] && !g_dirs[i]) {
-            g_fd_dir[i] = 0;
-            __atomic_store_n(&g_files[i], f, __ATOMIC_RELEASE);
-            return i;
-        }
-    return -1;
+    const int i = fd_alloc_slot();
+    if (i >= 0) {
+        g_fd_dir[i] = 0;
+        __atomic_store_n(&g_files[i], f, __ATOMIC_RELEASE);
+    }
+    return i;
 }
@@ -250,5 +270,5 @@ static int fd_alloc_dir(DIR* d)
     std::lock_guard<std::mutex> hold(g_fd_lock);
-    for (int i = 3; i < FS_MAX; i++)
-        if (!g_files[i] && !g_dirs[i]) { __atomic_store_n(&g_dirs[i], d, __ATOMIC_RELEASE); return i; }
-    return -1;
+    const int i = fd_alloc_slot();
+    if (i >= 0) __atomic_store_n(&g_dirs[i], d, __ATOMIC_RELEASE);
+    return i;
 }
