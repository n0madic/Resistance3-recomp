sys_ppu_thread: a thread that has exited is gone, and its id is not reused at once (open upstream PR, imported as is).

Resistance 3 creates its save-data "Check Thread", "Auto Load Thread" and "SysUtilThread()" in turn, all without
SYS_PPU_THREAD_CREATE_JOINABLE, and polls the id (sys_ppu_thread_get_priority) until it answers ESRCH to learn that the
worker ended. The pin frees such a thread's slot when it ends (#409), answered CELL_OK for the freed id, and handed the
same id to the next thread at once: black screen after the Insomniac logo, then a first level load that never ended.
The PR answers ESRCH for an exited thread whose slot was freed and hands slots out next-fit; it replaces our former
lv2/0001 and lv2/0002 (0001 also answered ESRCH for a finished joinable thread that was not joined yet; lv2 keeps such
a thread until the join, as the PR does). Tests in test_ppu_thread_slots.c.

Scripted run: boot passes the logo, a new game and Continue reach gameplay.

Upstream: PR #415 (drop this file when the pin contains it).

---

diff --git a/runtime/syscalls/sys_ppu_thread.c b/runtime/syscalls/sys_ppu_thread.c
index c64b0b8d..d96b269d 100644
--- a/runtime/syscalls/sys_ppu_thread.c
+++ b/runtime/syscalls/sys_ppu_thread.c
@@ -79,12 +79,19 @@ static void table_unlock(void)
 #endif
 }
 
-/* Find a free slot. Returns index or -1. Must be called under lock. */
+/* Find a free slot. Returns index or -1. Must be called under lock.
+ * The thread id is the slot + 1. A title that polls sys_ppu_thread_get_priority(id) until it returns ESRCH (to see a
+ * worker finish) only gets its answer if the next thread does not take that slot, and so that id, at once. So the
+ * search continues after the slot used last (next-fit): an id comes back only after the other slots were used. */
 static int find_free_slot(void)
 {
-    for (int i = 0; i < PPU_THREAD_MAX; i++) {
-        if (g_ppu_threads[i].state == PPU_THREAD_STATE_FREE)
+    static int s_next = 0;
+    for (int n = 0; n < PPU_THREAD_MAX; n++) {
+        int i = (s_next + n) % PPU_THREAD_MAX;
+        if (g_ppu_threads[i].state == PPU_THREAD_STATE_FREE) {
+            s_next = (i + 1) % PPU_THREAD_MAX;
             return i;
+        }
     }
     return -1;
 }
@@ -1124,6 +1131,12 @@ int64_t sys_ppu_thread_get_priority(ppu_context* ctx)
 
     table_lock();
     ppu_thread_info* t = find_thread(tid);
+    if (!t && tid >= 1 && tid <= PPU_THREAD_MAX && g_ppu_threads[tid - 1].entry_addr != 0) {
+        /* A thread created by sys_ppu_thread_create that has exited and been freed (the slot keeps its entry address):
+         * it is gone (ESRCH). */
+        table_unlock();
+        return (int64_t)(int32_t)CELL_ESRCH;
+    }
     if (!t) {
         /* The main thread (and any thread we didn't spawn via sys_ppu_thread_create)
          * isn't in our table. Returning ESRCH here is fatal for engines that query
diff --git a/tests/test_ppu_thread_slots.c b/tests/test_ppu_thread_slots.c
index 331ef889..64c5c064 100644
--- a/tests/test_ppu_thread_slots.c
+++ b/tests/test_ppu_thread_slots.c
@@ -62,6 +62,35 @@ int main(void)
     g_ppu_thread_entry_trampoline = guest_entry;
     ppu_thread_register_main();
 
+    /* 0. A thread that has exited is gone: get_priority on its id returns ESRCH, and its id is not handed to the next
+     *    thread at once (the title's poll needs that). An id nobody created (and the main thread) keeps the default answer. */
+    {
+        int32_t* out = (int32_t*)(vm_base + 0x200);
+        ppu_context ctx; memset(&ctx, 0, sizeof(ctx));
+        ctx.gpr[3] = 40; ctx.gpr[4] = 0x200;                   /* an id nothing created */
+        EXPECT_EQ(sys_ppu_thread_get_priority(&ctx), 0);
+        EXPECT_EQ(__builtin_bswap32((uint32_t)*out), 1000);
+        uint64_t a = 0, b = 0;
+        EXPECT_EQ(create(0, &a), 0);
+        settle();
+        for (int i = 0; i < 1000 && used_slots(); i++) { struct timespec ts = { 0, 1000000 }; nanosleep(&ts, NULL); }
+        ctx.gpr[3] = a;
+        EXPECT_EQ(sys_ppu_thread_get_priority(&ctx), (int64_t)(int32_t)CELL_ESRCH);
+        EXPECT_EQ(create(0, &b), 0);
+        EXPECT_EQ(b != a, 1);                                  /* first-fit gave the exited thread's id back */
+        settle();
+        for (int i = 0; i < 1000 && used_slots(); i++) { struct timespec ts = { 0, 1000000 }; nanosleep(&ts, NULL); }
+        uint64_t j = 0;
+        EXPECT_EQ(create(1, &j), 0);
+        settle();
+        ctx.gpr[3] = j;
+        EXPECT_EQ(sys_ppu_thread_get_priority(&ctx), 0);       /* joinable and not joined yet: still there */
+        ctx.gpr[4] = 0x300;
+        EXPECT_EQ(sys_ppu_thread_join(&ctx), 0);
+        ctx.gpr[4] = 0x200;
+        EXPECT_EQ(sys_ppu_thread_get_priority(&ctx), (int64_t)(int32_t)CELL_ESRCH);
+    }
+
     /* 1. More than PPU_THREAD_MAX non-joinable threads, one after the other: every create succeeds and the slots
      *    come back (create flags 0, nobody joins). */
     int ok = 0;
