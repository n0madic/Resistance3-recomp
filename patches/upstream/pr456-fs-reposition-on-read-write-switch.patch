cellFs: reposition the stream when a fd switches between read and write (open upstream PR, imported as is).

C requires an fseek between a read and a write on one stream. Without it, on macOS a write right after a read lands
where the stdio read buffer ended, not at the file position the guest sees (the PR's test at the pin: 2 of 9 checks
fail, the file grows to 528 bytes instead of 512). Resistance 3's FIOS disk cache (cache/BCES01118) reads and writes
the same descriptors.

Test: runtime/ppu/tests/test_fs_rw_switch.cpp (tools/test_ppu_fs_rw_switch.py), in the PR.

Upstream: PR #456 (drop this file when the pin contains it).

---

diff --git a/runtime/ppu/ppu_fs.cpp b/runtime/ppu/ppu_fs.cpp
index 4d54b72b..6508777a 100644
--- a/runtime/ppu/ppu_fs.cpp
+++ b/runtime/ppu/ppu_fs.cpp
@@ -208,11 +208,28 @@ static FILE* g_files[FS_MAX];
 static uint8_t g_fd_usm[FS_MAX];
 static char    g_fd_path[FS_MAX][192];   /* guest path per fd (diagnostics) */   /* 1 if this fd is an open .usm movie (read tracker) */
 static DIR*  g_dirs[FS_MAX];
+/* Last transfer direction on each fd's stream: 0 none, 1 read, 2 write.
+ *
+ * C allows a read after a write on one stream only once it has been flushed or
+ * repositioned, and a write after a read only once it has been repositioned;
+ * otherwise the result is undefined. cellFs has no such rule, so a title may
+ * write and then read on one fd with nothing in between. FIOS does exactly
+ * that with its HDD cache: it writes a 512-byte header into a new cache.idx
+ * and reads on. On the MSVC CRT that read returned 3584 bytes of stale buffer
+ * and the header never reached the file (size still 0), so the index never
+ * validated and FIOS rebuilt it for good -- ICO stayed on a black screen.
+ * fs_set_dir() repositions in place (SEEK_CUR 0) when the direction changes. */
+static uint8_t g_fd_dir[FS_MAX];
+static void fs_set_dir(int fd, uint8_t dir)
+{
+    if (g_fd_dir[fd] && g_fd_dir[fd] != dir) FS_SEEK64(g_files[fd], 0, SEEK_CUR);
+    g_fd_dir[fd] = dir;
+}
 static char  g_dir_path[FS_MAX][1024];   /* host path per open dir (for readdir stat) */
 
 static int fd_alloc_file(FILE* f)
 {
-    for (int i = 3; i < FS_MAX; i++) if (!g_files[i] && !g_dirs[i]) { g_files[i] = f; return i; }
+    for (int i = 3; i < FS_MAX; i++) if (!g_files[i] && !g_dirs[i]) { g_files[i] = f; g_fd_dir[i] = 0; return i; }
     return -1;
 }
 static int fd_alloc_dir(DIR* d)
@@ -399,7 +416,7 @@ static void cellFsClose(ppu_context* ctx)
         fprintf(stderr, "[fs] close fd=%d  (by %s)\n", fd, w); }
     if (fd >= 0 && fd < FS_MAX && g_files[fd]) {
         if (g_fd_usm[fd] && getenv("PS3_FSLOG_READS")) fprintf(stderr, "[USMRD] CLOSE usm fd=%d\n", fd);
-        fclose(g_files[fd]); g_files[fd] = nullptr; g_fd_usm[fd] = 0;
+        fclose(g_files[fd]); g_files[fd] = nullptr; g_fd_usm[fd] = 0; g_fd_dir[fd] = 0;
     }
     ctx->gpr[3] = CELL_OK;
 }
@@ -437,6 +454,7 @@ static void cellFsRead(ppu_context* ctx)
     long fpos_before = ftell(g_files[fd]);
     if (ppu_vm_size && (uint64_t)buf + nbytes > ppu_vm_size) nbytes = ppu_vm_size - buf;
     fs_prefault(buf, nbytes);
+    fs_set_dir(fd, 1);
     size_t n = fread(vm_base + buf, 1, (size_t)nbytes, g_files[fd]);   /* raw bytes, no swap */
     /* PS3_FSLOG_EOF=<fd>,<bytes>: report end-of-file past <bytes> on one descriptor.
      * The intro cinematic is 28 seconds and this port renders it at a few frames
@@ -504,6 +522,7 @@ static void cellFsWrite(ppu_context* ctx)
     uint32_t nwr_ptr = (uint32_t)ctx->gpr[6];
     if (fd < 0 || fd >= FS_MAX || !g_files[fd]) { ctx->gpr[3] = (uint64_t)(int64_t)CELL_FS_EIO; return; }
     fs_prefault(buf, nbytes);   /* kernel READS the buffer; same reserved-page trap */
+    fs_set_dir(fd, 2);
     size_t n = fwrite(vm_base + buf, 1, (size_t)nbytes, g_files[fd]);
     /* DIAGNOSTIC (PS3_FSLOG_BT=1): dump the guest back-chain when the game logs the
      * render-config failure, to locate setScreenRenderTargetInternal & the config obj. */
diff --git a/runtime/ppu/tests/test_fs_rw_switch.cpp b/runtime/ppu/tests/test_fs_rw_switch.cpp
new file mode 100644
index 00000000..9533b5f7
--- /dev/null
+++ b/runtime/ppu/tests/test_fs_rw_switch.cpp
@@ -0,0 +1,143 @@
+/*
+ * ps3recomp - cellFs read after write, and write after read, on one fd
+ * (ppu_fs.cpp).
+ *
+ * ppu_fs.cpp keeps each file as a stdio stream. C leaves a read right after a
+ * write (with no flush or seek between them) undefined, and the same for a
+ * write right after a read; cellFs has no such rule. FIOS creates its HDD
+ * cache index, writes a 512-byte header and reads on: on the MSVC CRT the read
+ * returned 3584 bytes of stale buffer and the header never reached the file.
+ * This fixture drives cellFsOpen / cellFsWrite / cellFsRead / cellFsFstat /
+ * cellFsLseek through that sequence and checks what the guest and the host
+ * file see. The undefined case shows on the MSVC CRT; other C libraries may
+ * pass either way.
+ *
+ *   tools/test_ppu_fs_rw_switch.py [--exe-out PATH]
+ *   test_fs_rw_switch [DIR]      (DIR: where the test file goes; default the
+ *                                 system temp directory)
+ */
+#include "ppu_fs.cpp"
+#ifdef _WIN32
+#  include <windows.h>
+#endif
+
+/* ---- link stubs: nothing on the paths this test drives calls them ---- */
+extern "C" {
+uint8_t* vm_base = nullptr;
+uint32_t ppu_vm_size = 0;
+void vm_write32(uint64_t a, uint32_t v) { uint32_t be = __builtin_bswap32(v); memcpy(vm_base + a, &be, 4); }
+void vm_write64(uint64_t a, uint64_t v) { uint64_t be = __builtin_bswap64(v); memcpy(vm_base + a, &be, 8); }
+void ppu_guest_caller(char* out, size_t n) { if (n) out[0] = 0; }
+void ps3_vfs_ps3game_fallback(char* path, size_t cap) { (void)path; (void)cap; }
+void ydkj_host_bt(const char* tag) { (void)tag; }
+void ps3_hle_register_ctx(uint32_t, const char*, void (*)(ppu_context*)) {}
+}
+ps3_guest_caller_fn g_ps3_guest_caller = nullptr;
+const char* edat_resolve(const char* host_path, char* buf, size_t cap) { (void)buf; (void)cap; return host_path; }
+
+static uint32_t rd32(uint32_t a) { uint32_t v; memcpy(&v, vm_base + a, 4); return __builtin_bswap32(v); }
+static uint64_t rd64(uint32_t a) { uint64_t v; memcpy(&v, vm_base + a, 8); return __builtin_bswap64(v); }
+
+static int fails = 0;
+#define CHECK(c, ...) do { printf((c) ? "[PASS] " : "[FAIL] "); printf(__VA_ARGS__); printf("\n"); \
+                           if (!(c)) fails++; } while (0)
+
+/* Guest memory layout used below. */
+enum : uint32_t { PATH = 0x100, FDP = 0x500, NP = 0x508, POSP = 0x510, STATB = 0x600,
+                  WBUF = 0x1000, RBUF = 0x2000 /* 64 KB read buffer */ };
+
+static uint64_t fs_write(uint32_t fd, uint32_t buf, uint64_t n)
+{
+    ppu_context ctx; memset(&ctx, 0, sizeof ctx);
+    ctx.gpr[3] = fd; ctx.gpr[4] = buf; ctx.gpr[5] = n; ctx.gpr[6] = NP;
+    cellFsWrite(&ctx);
+    return rd64(NP);
+}
+static uint64_t fs_read(uint32_t fd, uint32_t buf, uint64_t n)
+{
+    ppu_context ctx; memset(&ctx, 0, sizeof ctx);
+    ctx.gpr[3] = fd; ctx.gpr[4] = buf; ctx.gpr[5] = n; ctx.gpr[6] = NP;
+    cellFsRead(&ctx);
+    return rd64(NP);
+}
+static uint64_t fs_seek(uint32_t fd, int64_t off)
+{
+    ppu_context ctx; memset(&ctx, 0, sizeof ctx);
+    ctx.gpr[3] = fd; ctx.gpr[4] = (uint64_t)off; ctx.gpr[5] = 0 /* SET */; ctx.gpr[6] = POSP;
+    cellFsLseek(&ctx);
+    return rd64(POSP);
+}
+static uint64_t fs_size(uint32_t fd)
+{
+    ppu_context ctx; memset(&ctx, 0, sizeof ctx);
+    ctx.gpr[3] = fd; ctx.gpr[4] = STATB;
+    cellFsFstat(&ctx);
+    return rd64(STATB + 0x24);
+}
+
+int main(int argc, char** argv)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    static uint8_t mem[0x20000];
+    vm_base = mem; ppu_vm_size = sizeof mem;
+
+    const char* dir = argc > 1 ? argv[1] : NULL;
+#ifdef _WIN32
+    char tmp[MAX_PATH];
+    if (!dir) { DWORD n = GetTempPathA(sizeof tmp, tmp); if (n && n < sizeof tmp) { tmp[n - 1] = 0; dir = tmp; } }
+#endif
+    if (!dir) dir = getenv("TMPDIR");
+    if (!dir) dir = "/tmp";
+    char host[1100];
+    snprintf(host, sizeof host, "%s/ps3recomp_fs_rw_switch.idx", dir);
+    remove(host);
+
+    ppu_vfs_root = dir;
+    strcpy((char*)mem + PATH, "/dev_hdd1/ps3recomp_fs_rw_switch.idx");
+
+    /* FIOS's open: O_RDWR | O_CREAT on a file that does not exist yet. */
+    ppu_context ctx; memset(&ctx, 0, sizeof ctx);
+    ctx.gpr[3] = PATH; ctx.gpr[4] = 0x42; ctx.gpr[5] = FDP;
+    cellFsOpen(&ctx);
+    const uint32_t fd = rd32(FDP);
+    CHECK((uint32_t)ctx.gpr[3] == 0, "cellFsOpen(O_RDWR|O_CREAT) returns CELL_OK (fd %u)", fd);
+    if ((uint32_t)ctx.gpr[3] != 0) { printf("FAIL (could not create %s)\n", host); return 1; }
+
+    /* Write a 512-byte header, then read straight on: the file ends at the
+     * header, so the read finds nothing and the header stays written. */
+    /* CHECK evaluates its condition twice: every call that moves the file
+     * runs once, before it. */
+    memset(mem + WBUF, 0xAB, 512);
+    const uint64_t wrote = fs_write(fd, WBUF, 512);
+    CHECK(wrote == 512, "cellFsWrite writes the 512-byte header (%llu)", (unsigned long long)wrote);
+    memset(mem + RBUF, 0xEE, 0x10000);
+    const uint64_t got = fs_read(fd, RBUF, 0x10000);
+    CHECK(got == 0, "cellFsRead right after the write reads %llu bytes at end of file (want 0)",
+          (unsigned long long)got);
+    const uint64_t size = fs_size(fd);
+    CHECK(size == 512, "cellFsFstat after the read: size %llu (want 512)", (unsigned long long)size);
+
+    /* Read the header back, then write right after the read: the write lands
+     * where the read stopped. */
+    const uint64_t pos = fs_seek(fd, 0);
+    CHECK(pos == 0, "cellFsLseek back to 0");
+    const uint64_t back = fs_read(fd, RBUF, 16);
+    CHECK(back == 16 && mem[RBUF] == 0xAB && mem[RBUF + 15] == 0xAB, "cellFsRead returns the header bytes");
+    memset(mem + WBUF, 0xCD, 16);
+    const uint64_t wrote2 = fs_write(fd, WBUF, 16);
+    CHECK(wrote2 == 16, "cellFsWrite right after the read writes 16 bytes");
+
+    memset(&ctx, 0, sizeof ctx); ctx.gpr[3] = fd;
+    cellFsClose(&ctx);
+
+    /* What reached the host file. */
+    uint8_t disk[600]; size_t dn = 0;
+    if (FILE* f = fopen(host, "rb")) { dn = fread(disk, 1, sizeof disk, f); fclose(f); }
+    CHECK(dn == 512, "host file is %zu bytes (want 512)", dn);
+    CHECK(dn >= 32 && disk[0] == 0xAB && disk[15] == 0xAB && disk[16] == 0xCD && disk[31] == 0xCD &&
+          (dn < 33 || disk[32] == 0xAB),
+          "host file: header, then the 16 bytes written after the read at offset 16");
+    remove(host);
+    printf("%s (%d failed)\n", fails ? "FAIL" : "PASS", fails);
+    return fails ? 1 : 0;
+}
diff --git a/tools/test_ppu_fs_rw_switch.py b/tools/test_ppu_fs_rw_switch.py
new file mode 100644
index 00000000..c24ed9f9
--- /dev/null
+++ b/tools/test_ppu_fs_rw_switch.py
@@ -0,0 +1,88 @@
+#!/usr/bin/env python3
+"""cellFs read after write, and write after read, on one fd (runtime/ppu/ppu_fs.cpp).
+
+ppu_fs.cpp keeps files as stdio streams, and C leaves a read straight after a
+write (or a write straight after a read) undefined unless the stream is
+flushed or repositioned in between; cellFs has no such rule. FIOS writes a
+header into its new HDD cache index and reads on: on the MSVC CRT the read
+returned stale buffer bytes and the header never reached the file, so the
+cache never validated. This builds runtime/ppu/tests/test_fs_rw_switch.cpp
+(which includes ppu_fs.cpp) against a ppu_recomp.h made from the lifter's own
+HEADER_PREAMBLE and runs it.
+
+The undefined case shows on the MSVC CRT (clang++ or clang-cl on Windows);
+other C libraries may pass on both sides.
+
+It needs a host C++ compiler (under CI=1 a missing one fails instead of
+skipping).
+
+Usage:
+    python3 tools/test_ppu_fs_rw_switch.py [--exe-out PATH] [--build-only]
+"""
+
+import argparse
+import importlib.util
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+TOOLS = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(TOOLS)
+FIXTURE = os.path.join(ROOT, "runtime", "ppu", "tests", "test_fs_rw_switch.cpp")
+INCLUDE_DIRS = ["include", "runtime/ppu", "runtime/memory", "runtime", "libs", "."]
+
+
+def _cxx():
+    return (shutil.which(os.environ.get("CXX", "c++")) or shutil.which("g++")
+            or shutil.which("clang++"))
+
+
+def _stub_header():
+    spec = importlib.util.spec_from_file_location(
+        "ppu_lifter", os.path.join(TOOLS, "ppu_lifter.py"))
+    lifter = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(lifter)
+    return lifter.HEADER_PREAMBLE
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--exe-out", help="keep the built test program at this path")
+    ap.add_argument("--build-only", action="store_true",
+                    help="build (for another machine, e.g. a Windows target) and stop")
+    args = ap.parse_args()
+
+    cxx = _cxx()
+    if cxx is None:
+        if os.environ.get("CI"):
+            print("FAIL: no C++ compiler found")
+            return 1
+        print("skip test_ppu_fs_rw_switch: no C++ compiler")
+        return 0
+    with tempfile.TemporaryDirectory() as td:
+        with open(os.path.join(td, "ppu_recomp.h"), "w") as fh:
+            fh.write(_stub_header())
+        exe = args.exe_out or os.path.join(td, "test_fs_rw_switch")
+        cmd = [cxx, "-std=gnu++17", "-w", "-I" + td]
+        cmd += ["-I" + os.path.join(ROOT, d) for d in INCLUDE_DIRS]
+        cmd += ["-o", exe, FIXTURE]
+        if "mingw" in os.path.basename(cxx):
+            cmd += ["-static"]
+        r = subprocess.run(cmd, capture_output=True, text=True)
+        if r.returncode != 0:
+            print("FAIL: fixture did not build")
+            print((r.stdout + r.stderr)[-4000:])
+            return 1
+        if args.build_only:
+            print(f"built {exe}")
+            return 0
+        r = subprocess.run([exe, td], capture_output=True, text=True)
+        sys.stdout.write(r.stdout)
+        sys.stderr.write(r.stderr)
+        return r.returncode
+
+
+if __name__ == "__main__":
+    sys.exit(main())
