rsx dispatch: every completing ATTR0 encoding emits an immediate vertex (open upstream PR, imported as is).

Only the DATA3F and DATA4F position writes emitted a vertex. Resistance 3 draws its Bink movie frames (and other
full-screen passes) as BEGIN_END(QUADS) groups whose position is SET_VERTEX_DATA2F_M attribute 0 (0x1880/0x1884), so
each such group reached the draw engine with no vertices and was dropped: movie audio and subtitles over a black
picture. The PR covers the same eight forms as our former gcm-rsx/0001, with tests in test_rsx_draw_engine.c.

Scripted run: the intro movie shows its picture.

Upstream: PR #463 (drop this file when the pin contains it).

---

diff --git a/libs/video/rsx_dispatch.c b/libs/video/rsx_dispatch.c
index 7350528d..d281db71 100644
--- a/libs/video/rsx_dispatch.c
+++ b/libs/video/rsx_dispatch.c
@@ -327,11 +327,23 @@ void rsx_dispatch_method(rsx_dispatch* rsx, u32 method, u32 arg)
         (method >= 0x0A80 && method < 0x0B00))
         vtx_const_fold(rsx, method, arg);
 
-    /* Completing a floating-point position emits a register-based vertex.
-     * Other attributes update the current values copied with that position.
-     * Keep these writes as ordinary constant state outside BEGIN/END. */
-    if (rsx->in_begin_end && (method == 0x1508 || method == 0x1C0C) &&
-        rsx->sink.immediate_vertex)
+    /* Completing a position emits a register-based vertex: the last word of
+     * ATTR0 in any of its immediate encodings. Other attributes update the
+     * current values copied with that position. Keep these writes as ordinary
+     * constant state outside BEGIN/END.
+     *
+     * Only the float encodings used to count (DATA3F's Z, DATA4F's W).
+     * Resistance's movie player sends its quad as DATA2S positions, so every
+     * movie frame drew nothing and the cutscenes played on a black screen. */
+    if (rsx->in_begin_end && rsx->sink.immediate_vertex &&
+        (method == 0x1508 ||    /* DATA3F  Z            */
+         method == 0x1C0C ||    /* DATA4F  W            */
+         method == 0x1884 ||    /* DATA2F  Y            */
+         method == 0x1E40 ||    /* DATA1F  X            */
+         method == 0x1900 ||    /* DATA2S  (one word)   */
+         method == 0x1940 ||    /* DATA4UB (one word)   */
+         method == 0x1984 ||    /* DATA4S  second word  */
+         method == 0x0A84))     /* SCALED4S second word */
         rsx->sink.immediate_vertex(rsx->sink.user, rsx);
 
     /* Transform program upload window: word goes to instruction slot
diff --git a/libs/video/tests/test_rsx_draw_engine.c b/libs/video/tests/test_rsx_draw_engine.c
index aee6109f..36d2c99c 100644
--- a/libs/video/tests/test_rsx_draw_engine.c
+++ b/libs/video/tests/test_rsx_draw_engine.c
@@ -1541,6 +1541,52 @@ static void test_immediate_compositor(void)
     CHECK(stub.n_draw == 5 && stub.captured_vertices[1][3] == 0 &&
           stub.captured_vertices[1][35] == 0,
           "explicit all-zero DATA4F preserves position W and attribute alpha");
+    /* Resistance's movie player: a QUADS group whose positions are DATA2S on
+     * ATTR0 (0x1900, x in the low half), each vertex's ATTR1 written first and
+     * the colour/UV set once as constants. The single ATTR0 word completes the
+     * position, as on hardware; only DATA3F/DATA4F positions used to emit, and
+     * every movie frame drew nothing. */
+    m(M_BEGIN_END, 8u);
+    m(0x1C20, f32_bits(1)); m(0x1C24, f32_bits(1)); m(0x1C28, f32_bits(1)); m(0x1C2C, f32_bits(1));
+    m(0x1898, f32_bits(1)); m(0x189C, f32_bits(0.9f));
+    const u32 quad[4] = { 0x00000000u, 0x02D00000u, 0x02D00500u, 0x00000500u };
+    for (u32 i = 0; i < 4; i++) { m(0x1904, quad[i]); m(0x1900, quad[i]); }
+    m(M_BEGIN_END, 0);
+    CHECK(stub.n_draw == 6 && stub.draw_vertices == 4 && stub.draw_indices == 6,
+          "DATA2S positions emit a vertex each (draws %d, %u verts)",
+          stub.n_draw, stub.draw_vertices);
+    CHECK(stub.captured_vertices[2][0] == 1280 && stub.captured_vertices[2][1] == 720 &&
+          stub.captured_vertices[2][3] == 1 && stub.captured_vertices[2][4] == 1280,
+          "DATA2S position is (x low half, y high half, 0, 1) with ATTR1 current");
+    /* The other single-word encodings of ATTR0 complete a position too, and a
+     * two-word one completes on its last word only. */
+    m(M_BEGIN_END, 5u);
+    for (u32 i = 0; i < 3; i++) m(0x1940, 0x01020304u);           /* DATA4UB */
+    m(M_BEGIN_END, 0);
+    CHECK(stub.n_draw == 7 && stub.draw_vertices == 3, "DATA4UB ATTR0 emits per write");
+    m(M_BEGIN_END, 5u);
+    for (u32 i = 0; i < 3; i++) { m(0x1880, f32_bits(1)); m(0x1884, f32_bits(2)); } /* DATA2F */
+    m(M_BEGIN_END, 0);
+    CHECK(stub.n_draw == 8 && stub.draw_vertices == 3, "DATA2F ATTR0 emits on its Y word");
+    m(M_BEGIN_END, 5u);
+    for (u32 i = 0; i < 3; i++) m(0x1E40, f32_bits((float)i));    /* DATA1F */
+    m(M_BEGIN_END, 0);
+    CHECK(stub.n_draw == 9 && stub.draw_vertices == 3, "DATA1F ATTR0 emits per write");
+    m(M_BEGIN_END, 5u);
+    for (u32 i = 0; i < 3; i++) { m(0x1980, 0x00020001u); m(0x1984, 0x00010000u); } /* DATA4S */
+    m(M_BEGIN_END, 0);
+    CHECK(stub.n_draw == 10 && stub.draw_vertices == 3 &&
+          stub.captured_vertices[2][0] == 1 && stub.captured_vertices[2][1] == 2 &&
+          stub.captured_vertices[2][3] == 1,
+          "DATA4S ATTR0 emits on its second word only (%u verts)", stub.draw_vertices);
+    m(M_BEGIN_END, 5u);
+    for (u32 i = 0; i < 3; i++) { m(0x0A80, 0x7FFF7FFFu); m(0x0A84, 0x7FFF0000u); } /* SCALED4S */
+    m(M_BEGIN_END, 0);
+    CHECK(stub.n_draw == 11 && stub.draw_vertices == 3,
+          "SCALED4S ATTR0 emits on its second word only (%u verts)", stub.draw_vertices);
+    /* Outside BEGIN/END the same writes are only current values. */
+    m(0x1900, 0x00100010u); m(0x1940, 0x01020304u);
+    CHECK(stub.n_draw == 11, "ATTR0 writes outside BEGIN/END do not draw");
     engine_down();
 }
 
