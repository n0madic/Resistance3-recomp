rsx_draw_engine: a compressed texture is never a render target's output (open upstream PR, imported as is).

Resistance 3: after leaving a mission for the main menu the menu was unreadable -- the 1024x1024 DXT1 paper atlas at
local 0x037A1B00 was bound as the level's 128x80 bloom history target left at that address (the menu atlases and the
level's post-processing targets share local memory). With this PR a DXT1/3/5 unit looks up neither colour nor depth
targets and uploads from guest memory; it replaces gcm-rsx/0017, which did the same. Checked with a scripted run
(boot, Continue, comic skip, pause, quit to menu): the menu frame is the boot one.

Upstream: PR #508 (drop this file when the pin contains it).

---

diff --git a/libs/video/rsx_draw_engine.c b/libs/video/rsx_draw_engine.c
index f99986b3..e8507841 100644
--- a/libs/video/rsx_draw_engine.c
+++ b/libs/video/rsx_draw_engine.c
@@ -2089,7 +2089,18 @@ static u32 sink_bind_textures(const u32* target_slots, u32 n_targets,
         eng_decode_sampler(t.filter, t.wrap, t.control0, &samplers[u]);
 
         int sampled = -1, own = 0, surface_at = -1;
-        for (u32 i = 0; i < g.n_surfaces; i++) {
+        /* DXT data is never a render target's output: no surface colour
+         * format is block-compressed, so whatever a compressed texture names
+         * came from memory. Matching it against a target at the same offset
+         * found the current colour target and dropped the draw as an
+         * incompatible feedback read (a 16x16 DXT1 texture over a 1280x720
+         * target in Resistance: Fall of Man). Neither colour nor depth
+         * surfaces are looked up for it. */
+        const u32 base_fmt = t.format & RSX_TEX_FMT_BASE_MASK & ~(u32)RSX_TEX_FMT_UNNORM;
+        const int compressed = base_fmt == RSX_TEX_FMT_DXT1 ||
+                               base_fmt == RSX_TEX_FMT_DXT23 ||
+                               base_fmt == RSX_TEX_FMT_DXT45;
+        for (u32 i = 0; i < g.n_surfaces && !compressed; i++) {
             if (!g.surfaces[i].handle || g.surfaces[i].location != t.location ||
                 g.surfaces[i].offset != t.offset)
                 continue;
@@ -2101,11 +2112,10 @@ static u32 sink_bind_textures(const u32* target_slots, u32 n_targets,
             sampled = (int)i;
             break;
         }
-        const u32 base_fmt = t.format & RSX_TEX_FMT_BASE_MASK & ~(u32)RSX_TEX_FMT_UNNORM;
         /* The depth at this address, when it was written after any colour
          * there: a depth-only pass names its zeta as a colour target too. */
         int zsrc = -1;
-        for (u32 i = 0; i < g.n_zdepths; i++) {
+        for (u32 i = 0; i < g.n_zdepths && !compressed; i++) {
             const eng_zdepth* z = &g.zdepths[i];
             if (z->location != t.location || z->offset != t.offset || !z->depth_serial)
                 continue;
diff --git a/libs/video/tests/test_color_feedback_engine.c b/libs/video/tests/test_color_feedback_engine.c
index d2d870d8..c322ef76 100644
--- a/libs/video/tests/test_color_feedback_engine.c
+++ b/libs/video/tests/test_color_feedback_engine.c
@@ -29,6 +29,8 @@ int main(void){vm_base=calloc(1,GUEST_BYTES);ppu_vm_size=GUEST_BYTES;
  up();m(M_COLOR_TARGET,CELL_GCM_SURFACE_TARGET_MRT1);m(M_CONTEXT_DMA_COLOR_B,DMA_LOCAL);m(M_COLOR_B_OFFSET,0x50000);m(0x021C,1024);for(u32 a=0;a<0x20;a+=4)m(M_TEX_UNIT+0x20+a,rsx_dsp_reg(&g.rsx,M_TEX_UNIT+a));m(0x1844,1024);m(M_TEX_UNIT+0x20,0x50000);nt=eng_current_target_set(targets);memset(tx,0,sizeof tx);T(nt==2&&sink_bind_textures(targets,nt,ENG_INVALID,3,tx,ss)==3&&copies==2&&tx[0]!=tx[1],"MRT feedback snapshots every owned member independently");down();
  up();feedback_backend.surface_view=NULL;draw_triangle();T(copies==1&&stub.n_draw==1&&stub.bound_tex[0]==snapshot_seen,"absent view allows identity copy");down();
  up();feedback_backend.surface_view=NULL;m(M_TEX_UNIT+0x10,0xAA6C);draw_triangle();T(copies==1&&!stub.n_draw,"absent remap view rejects instead of silently changing channels");down();
+ /* A compressed texture over the current target is memory, not feedback. */
+ up();m(M_TEX_UNIT+4,1|(2<<4)|(0xA6<<8)|(1<<16));m(M_TEX_UNIT+0x18,(16<<16)|16);draw_triangle();T(copies==0&&stub.n_draw==1,"DXT1 at the target's offset uploads from memory instead of dropping the draw");down();
  /* Independently newer depth at the same address keeps its established route. */
  up();nt=eng_current_target_set(targets);u32 zs=eng_zdepth_get(RSX_LOCATION_LOCAL,0x40000,256,256);g.zdepths[zs].depth_serial=2;g.zdepths[zs].had_write=1;g.zdepths[zs].snapshot_valid=0;m(M_TEX_UNIT+4,1|(2<<4)|(0xB0<<8)|(1<<16));memset(tx,0,sizeof tx);T(sink_bind_textures(targets,nt,ENG_INVALID,1,tx,ss)==1&&copies==0&&stub.n_depth_snapshot==1,"newer depth wins over own color metadata");down();
  /* Full physical layouts and matching formats, without reinterpretation. */
