Metal backend: Cmd+Q, and no system alert for key presses.

The window has no menu bar of its own, so Cmd+Q went nowhere: the main menu now has "Quit <title>", which ends the process
the way closing the window does. The pad polls the keyboard itself, so key events have no consumer: the window would answer
each one with the system alert sound. The message pump drops key down/up events and lets only Command shortcuts reach the menu.

Upstream: not proposed.

---

diff --git a/libs/video/rsx_metal_backend.m b/libs/video/rsx_metal_backend.m
index 32f0b95..e0694f8 100644
--- a/libs/video/rsx_metal_backend.m
+++ b/libs/video/rsx_metal_backend.m
@@ -581,2 +581,12 @@ static void window_close_observer_start(NSWindow* window)
 
+/* Cmd+Q: the window has no menu bar of its own, so the keystroke went nowhere. It asks the host to stop
+ * the way closing the window does; the pump reports it. */
+@interface RsxQuitTarget : NSObject
+- (void)quit:(id)sender;
+@end
+@implementation RsxQuitTarget
+- (void)quit:(id)sender { (void)sender; atomic_store(&s_closed, 1); }
+@end
+static RsxQuitTarget* s_quit_target;
+
 static int create_window_impl(const char* title)
@@ -585,4 +595,24 @@ static int create_window_impl(const char* title)
     [NSApp setActivationPolicy:NSApplicationActivationPolicyRegular];
+    {
+        s_quit_target = [RsxQuitTarget new];
+        NSMenu* bar = [NSMenu new];
+        NSMenuItem* appItem = [NSMenuItem new];
+        [bar addItem:appItem];
+        NSMenu* appMenu = [NSMenu new];
+        NSString* quitTitle = [@"Quit " stringByAppendingString:[NSString stringWithUTF8String:(title ? title : "ps3recomp")]];
+        NSMenuItem* quit = [[NSMenuItem alloc] initWithTitle:quitTitle action:@selector(quit:) keyEquivalent:@"q"];
+        [quit setTarget:s_quit_target];
+        [appMenu addItem:quit];
+        [appItem setSubmenu:appMenu];
+        [NSApp setMainMenu:bar];
+    }
 
+    /* PS3RECOMP_METAL_WINDOW=<w>x<h>: initial content size in points (default: the game's size). */
     NSRect frame = NSMakeRect(0, 0, (CGFloat)s_width, (CGFloat)s_height);
+    {
+        unsigned ww = 0, wh = 0;
+        const char* ws = getenv("PS3RECOMP_METAL_WINDOW");
+        if (ws && sscanf(ws, "%ux%u", &ww, &wh) == 2 && ww >= 160 && wh >= 90 && ww <= 16384 && wh <= 16384)
+            frame.size = NSMakeSize((CGFloat)ww, (CGFloat)wh);
+    }
     s_window = [[NSWindow alloc]
@@ -3984,2 +4014,9 @@ static int pump_messages_impl(void)
             if (!ev) break;
+            /* The pad reads the keyboard by polling, so key events have no consumer here: the window would
+             * answer each with the system alert sound. Only Command shortcuts (Cmd+Q) reach the menu. */
+            if ([ev type] == NSEventTypeKeyDown || [ev type] == NSEventTypeKeyUp) {
+                if ([ev type] == NSEventTypeKeyDown && ([ev modifierFlags] & NSEventModifierFlagCommand))
+                    [[NSApp mainMenu] performKeyEquivalent:ev];
+                continue;
+            }
             [NSApp sendEvent:ev];
