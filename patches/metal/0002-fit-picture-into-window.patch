Metal backend: the picture is fitted into the resizable window, letterboxed.

The window is resizable (the toolkit creates it so), but the drawable stayed at the game's size and the compositor stretched
it. The message pump now records the window's content size in device pixels; the present path sizes the drawable to it, and the
display pass fits the game picture into it at its own aspect ratio, centred, the rest black. A picture shown at other than its
own size is sampled linearly, one shown at its size stays point-sampled. PS3RECOMP_METAL_WINDOW=<w>x<h> (quit-menu-and-key-events)
sets the initial size.

Upstream: not proposed yet.

---

diff --git a/libs/video/rsx_metal_backend.m b/libs/video/rsx_metal_backend.m
index e0694f8..1e4e57e 100644
--- a/libs/video/rsx_metal_backend.m
+++ b/libs/video/rsx_metal_backend.m
@@ -84,2 +84,5 @@
 #endif
+/* The window's content size in device pixels, kept current by the message pump (main thread) and read
+ * by the present path, which sizes the drawable to it. 0 until the first pump. */
+static volatile u32        s_win_px_w, s_win_px_h;
 static int                 s_ready;
@@ -3573,3 +3576,4 @@ static void eng_encode_records(id<MTLCommandBuffer> cb, id<MTLBuffer> stage)
  * PS3_SHARPEN this pass sharpens it as it samples. Either one that is off or
- * fails is skipped. */
+ * fails is skipped. The picture keeps its aspect ratio: it is fitted into the drawable and
+ * centred, and the rest is black (letterbox). */
 static void eng_blit_to_display(id<MTLCommandBuffer> cb, id<MTLTexture> src,
@@ -3596,3 +3600,4 @@ static void eng_blit_to_display(id<MTLCommandBuffer> cb, id<MTLTexture> src,
     rp.colorAttachments[0].texture     = dst;
-    rp.colorAttachments[0].loadAction  = MTLLoadActionDontCare;
+    rp.colorAttachments[0].loadAction  = MTLLoadActionClear;
+    rp.colorAttachments[0].clearColor  = MTLClearColorMake(0.0, 0.0, 0.0, 1.0);
     rp.colorAttachments[0].storeAction = MTLStoreActionStore;
@@ -3600,5 +3605,11 @@ static void eng_blit_to_display(id<MTLCommandBuffer> cb, id<MTLTexture> src,
     if (!e) return;
+    const double dw = (double)[dst width], dh = (double)[dst height];
+    const double sw = (double)[src width], sh = (double)[src height];
+    const double fit = fmin(dw / sw, dh / sh);
+    const double vw = floor(sw * fit + 0.5), vh = floor(sh * fit + 0.5);
+    [e setViewport:(MTLViewport){floor((dw - vw) * 0.5), floor((dh - vh) * 0.5), vw, vh, 0.0, 1.0}];
     [e setRenderPipelineState:s_eng_blit_pso];
     [e setFragmentTexture:src atIndex:0];
-    [e setFragmentSamplerState:s_eng_point_sampler atIndex:0];
+    const int scaled = (vw != sw || vh != sh);
+    [e setFragmentSamplerState:(scaled ? s_default_sampler : s_eng_point_sampler) atIndex:0];
     /* The video out's gamma (cellVideoOutSetGamma, the title's brightness
@@ -3640,2 +3651,10 @@ static void eng_encode_and_commit(id<MTLTexture> present_dst)
             } else {
+                /* The drawable is the window's size in device pixels, so the compositor does not
+                 * stretch it; eng_blit_to_display fits the game picture into it. */
+                const u32 ww = s_win_px_w, wh = s_win_px_h;
+                const CGSize cur = s_layer.drawableSize;
+                if (ww && wh && ((u32)cur.width != ww || (u32)cur.height != wh)) {
+                    s_layer.drawableSize = CGSizeMake((CGFloat)ww, (CGFloat)wh);
+                    fprintf(stderr, "[RSX metal] drawable %ux%u (window)\n", ww, wh);
+                }
                 drawable = [s_layer nextDrawable];
@@ -4023,2 +4042,8 @@ static int pump_messages_impl(void)
         }
+        if (s_window) {
+            NSView* v = [s_window contentView];
+            const NSSize px = [v convertSizeToBacking:[v bounds].size];
+            s_win_px_w = (u32)px.width;
+            s_win_px_h = (u32)px.height;
+        }
     }
