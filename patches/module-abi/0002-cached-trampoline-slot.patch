diff --git a/runtime/spu/tests/test_spu_module_tramp_slot.c b/runtime/spu/tests/test_spu_module_tramp_slot.c
new file mode 100644
index 0000000..311a2e8
--- /dev/null
+++ b/runtime/spu/tests/test_spu_module_tramp_slot.c
@@ -0,0 +1,86 @@
+/* Lifted code built as a separate module queues its transfers through the context's cached trampoline slot
+ * (spu_context.tramp_slot), else through spu_tramp_slot(); spu_run_with_halt binds the slot to the running
+ * thread and spu_drain_call rebinds one left by another thread. Built with tools/test_spu_module_tramp_slot.py. */
+#include "../spu_context.h"
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+/* Link-only boundaries outside the SPU runtime (as in test_spu_interpreter_handoff.c). */
+void spu_thread_publish_ctx(uint32_t tid, void* c) { (void)tid; (void)c; abort(); }
+void ppu_resv_break_store(uint64_t ea) { (void)ea; abort(); }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; abort(); }
+unsigned long long ps3_ms_now(void) { return 0; }
+uint32_t g_ww_lo = 0xFFFFFFFFu, g_ww_hi;
+int g_resv_store_active;
+uint32_t g_barrier_sync_watch;
+uint32_t g_ydkj_real_spurs_ea, g_ydkj_real_taskset_ea, g_ydkj_real_taskid;
+void spurs_ef_set_from_spu(uint32_t ea, uint16_t bits) { (void)ea; (void)bits; abort(); }
+void ydkj_wake_all_event_flags(void) { abort(); }
+void spurs_pm_build_context(spu_context* c, uint32_t a, uint32_t b, uint32_t d) {
+    (void)c; (void)a; (void)b; (void)d; abort();
+}
+uint32_t g_spu_image_src_ea, g_spu_image_ls_start, g_spu_image_span;
+extern int spu_run_with_halt(void (*)(spu_context*), spu_context*);
+extern void m_queue_target(spu_context*);
+extern void m_target(spu_context*);
+extern int m_target_runs;
+
+static int passed, failed;
+static void check(int ok, const char* what)
+{
+    if (ok) passed++; else { failed++; printf("FAIL: %s\n", what); }
+}
+static spu_context* fresh(void)
+{
+    spu_context* c = (spu_context*)calloc(1, sizeof *c);
+    if (!c) { puts("out of memory"); exit(1); }
+    spu_context_init(c, 0);
+    return c;
+}
+static void (**s_thread_slot)(spu_context*);
+static void* run_on_thread(void* arg)
+{
+    spu_run_with_halt(m_queue_target, (spu_context*)arg);
+    s_thread_slot = &g_spu_trampoline_fn;
+    return NULL;
+}
+
+int main(void)
+{
+    spu_context* c = fresh();
+    check(c->tramp_slot == NULL, "a new context has no cached slot");
+    g_spu_trampoline_fn = 0;
+    m_queue_target(c);
+    check(g_spu_trampoline_fn == m_target, "without a cached slot the module queues through the accessor");
+
+    void (*other)(spu_context*) = 0;
+    g_spu_trampoline_fn = 0;
+    c->tramp_slot = &other;
+    m_queue_target(c);
+    check(other == m_target && !g_spu_trampoline_fn, "a cached slot takes the module's transfer");
+
+    spu_context* r = fresh();
+    m_target_runs = 0;
+    spu_run_with_halt(m_queue_target, r);
+    check(r->tramp_slot == &g_spu_trampoline_fn && m_target_runs == 1,
+          "spu_run_with_halt binds the slot to its thread and runs the queued transfer");
+
+    c->pc = 0x100; g_spu_trampoline_fn = 0;
+    spu_drain_call(c, 0x100);
+    check(c->tramp_slot == &g_spu_trampoline_fn, "spu_drain_call rebinds a slot of another thread");
+
+    spu_context* t = fresh();
+    pthread_t th;
+    m_target_runs = 0;
+    if (pthread_create(&th, NULL, run_on_thread, t) || pthread_join(th, NULL)) { puts("pthread failed"); return 1; }
+    check(t->tramp_slot == s_thread_slot && s_thread_slot != &g_spu_trampoline_fn && m_target_runs == 1,
+          "a run on another thread binds that thread's slot");
+    spu_run_with_halt(m_queue_target, t);
+    check(t->tramp_slot == &g_spu_trampoline_fn && m_target_runs == 2, "the next run on this thread rebinds it here");
+
+    printf("SPU module trampoline slot: %d passed, %d failed\n", passed, failed);
+    return failed != 0;
+}
