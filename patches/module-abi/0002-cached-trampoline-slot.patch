@@ -0,0 +1,7 @@
+/* The "module" side of test_spu_module_tramp_slot.c: built with -DSPU_MODULE_ACCESSORS, as a separately loaded
+ * lift is, so g_spu_trampoline_fn here is the context's cached slot or the host's accessor. */
+#include "../spu_context.h"
+
+int m_target_runs;
+void m_target(spu_context* ctx) { (void)ctx; m_target_runs++; }
+void m_queue_target(spu_context* ctx) { ctx->pc = 0x200; g_spu_trampoline_fn = m_target; }
diff --git a/tools/test_spu_module_tramp_slot.py b/tools/test_spu_module_tramp_slot.py
new file mode 100644
index 0000000..ef5d3a1
--- /dev/null
+++ b/tools/test_spu_module_tramp_slot.py
@@ -0,0 +1,37 @@
+#!/usr/bin/env python3
+"""A lift built as a separate module (SPU_MODULE_ACCESSORS) queues its trampoline transfers through the context's
+cached slot, bound to the running thread by spu_run_with_halt (runtime/spu/tests/test_spu_module_tramp_slot.c)."""
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+SPU = ROOT / 'runtime/spu'
+SOURCES = ['spu_channels.c', 'spu_drain.c', 'spu_lockstep.c', 'spu_coherency.c',
+           'spu_workload.c', 'spurs_policy.c', 'spurs_job.c', 'spu_tsp_weak.c',
+           'spu_vm_pagemap.c', 'spurs_policy_blob_weak.c', 'spu_interp.c']
+
+
+def main() -> int:
+    cc = os.environ.get('CC', 'cc')
+    inc = ['-I' + str(ROOT / 'include'), '-I' + str(SPU), '-I' + str(ROOT / 'runtime/platform')]
+    with tempfile.TemporaryDirectory(prefix='spu-tramp-slot-') as tmp:
+        out = Path(tmp)
+        subprocess.run([cc, '-std=gnu17', '-O2', '-w', '-DSPU_MODULE_ACCESSORS', *inc, '-c',
+                        str(SPU / 'tests/test_spu_module_tramp_slot_lift.c'), '-o', str(out / 'lift.o')], check=True)
+        subprocess.run([cc, '-std=gnu17', '-O1', '-w', *inc, str(SPU / 'tests/test_spu_module_tramp_slot.c'),
+                        str(out / 'lift.o'), *[str(SPU / name) for name in SOURCES],
+                        str(ROOT / 'runtime/platform/win32_compat.c'), '-pthread', '-lm', '-o', str(out / 'test')],
+                       check=True)
+        env = {k: v for k, v in os.environ.items() if not k.startswith(('SPU_', 'SPURS_'))}
+        r = subprocess.run([str(out / 'test')], capture_output=True, text=True, timeout=30, env=env)
+    print(r.stdout.strip())
+    if r.returncode:
+        print(r.stderr[-2000:], file=sys.stderr)
+    return r.returncode
+
+
+if __name__ == '__main__':
+    sys.exit(main())
