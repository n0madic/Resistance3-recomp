diff --git a/libs/video/rsx_fp_decompiler.h b/libs/video/rsx_fp_decompiler.h
index 670e886..3861242 100644
--- a/libs/video/rsx_fp_decompiler.h
+++ b/libs/video/rsx_fp_decompiler.h
@@ -94,2 +94,11 @@ int rsx_fp_apply_unnorm_scale(char* hlsl, u32 hlsl_size, u32 unnorm_mask,
 
+/* WPOS on an antialiased surface held at its sample resolution (sx x sy
+ * samples a pixel, as in guest memory). The RSX runs the program once a pixel
+ * and WPOS is that pixel's window position; the host shades each sample and
+ * SV_POSITION counts samples. Rewrites the program's WPOS to the centre of the
+ * pixel its sample belongs to. Returns 1 when patched, 0 when there is nothing
+ * to do (a 1x1 grid, or no WPOS read), or -1 without mutation when the entry
+ * point is not found, the grid is already applied, or the buffer is short. */
+int rsx_fp_apply_wpos_grid(char* hlsl, u32 capacity, u32 sx, u32 sy);
+
 /* Decode NV4097_SET_ALPHA_REF for the active surface color format. Ordinary
diff --git a/libs/video/tests/test_fp_decompiler.c b/libs/video/tests/test_fp_decompiler.c
index 650c021..37ce797 100644
--- a/libs/video/tests/test_fp_decompiler.c
+++ b/libs/video/tests/test_fp_decompiler.c
@@ -522,2 +522,49 @@ int main(void)
 
+    /* WPOS on an antialiased target held at its sample grid: every sample
+     * reads the centre of its pixel. A perspective-corrected texcoord keeps
+     * reading w from the same SV_POSITION, which the rewrite leaves alone. */
+    {
+        u8 prog[32];
+        put_word(prog + 0, OPC(0x01) | OUTMASK_ALL | INSRC(0));            /* MOV r0, WPOS */
+        put_word(prog + 4, T_INPUT | SWZ_IDENT | EXEC_ALWAYS);
+        put_word(prog + 8, 0);
+        put_word(prog + 12, 0);
+        put_word(prog + 16, OPC(0x17) | OUTMASK_ALL | OUTREG(1) | INSRC(6) | TEXU(0) | END);
+        put_word(prog + 20, T_INPUT | SWZ_IDENT | EXEC_ALWAYS);              /* TEX r1, TC2 */
+        put_word(prog + 24, 0);
+        put_word(prog + 28, 1u << 31);
+        u32 nk = 0;
+        rsx_fp_decompile_buffered_ex(prog, sizeof prog, CTRL_32BIT, 0, hlsl, sizeof hlsl, &nk);
+        char before[sizeof hlsl];
+        memcpy(before, hlsl, sizeof hlsl);
+
+        check_true("wpos_grid_1x1_noop", rsx_fp_apply_wpos_grid(hlsl, sizeof hlsl, 1, 1) == 0 &&
+                                         !strcmp(before, hlsl));
+        check_true("wpos_grid_short_buffer",
+                   rsx_fp_apply_wpos_grid(hlsl, (u32)strlen(hlsl) + 8, 2, 1) == -1 &&
+                   !strcmp(before, hlsl));
+        check_true("wpos_grid_2x1", rsx_fp_apply_wpos_grid(hlsl, sizeof hlsl, 2, 1) == 1);
+        check("wpos_grid_first_line", hlsl,
+              "float4 main(PSInput input) : SV_TARGET {\n"
+              "    input.position.xy = floor(input.position.xy / float2(2, 1)) + 0.5;\n");
+        check("wpos_grid_inv_w_kept", hlsl, "_rsx_inv_w(input.position)");
+        check_true("wpos_grid_once", rsx_fp_apply_wpos_grid(hlsl, sizeof hlsl, 2, 1) == -1);
+
+        /* Two colour exports: the PSOutput entry point. */
+        put_word(prog + 16, OPC(0x01) | OUTMASK_ALL | OUTREG(2) | INSRC(0) | END); /* MOV r2, WPOS */
+        put_word(prog + 28, 0);
+        rsx_fp_decompile_buffered_ex(prog, sizeof prog, CTRL_32BIT, 0, hlsl, sizeof hlsl, &nk);
+        check_true("wpos_grid_mrt_2x2", rsx_fp_apply_wpos_grid(hlsl, sizeof hlsl, 2, 2) == 1);
+        check("wpos_grid_mrt_line", hlsl,
+              "PSOutput main(PSInput input) {\n"
+              "    input.position.xy = floor(input.position.xy / float2(2, 2)) + 0.5;\n");
+
+        /* No WPOS read: byte-identical. */
+        put_word(prog + 0, OPC(0x01) | OUTMASK_ALL | INSRC(1) | END);      /* MOV r0, COL0 */
+        rsx_fp_decompile_buffered_ex(prog, 16, CTRL_32BIT, 0, hlsl, sizeof hlsl, &nk);
+        memcpy(before, hlsl, sizeof hlsl);
+        check_true("wpos_grid_no_wpos_noop", rsx_fp_apply_wpos_grid(hlsl, sizeof hlsl, 2, 2) == 0 &&
+                                             !strcmp(before, hlsl));
+    }
+
     printf("\n===========================================\n");
diff --git a/libs/video/tests/test_rsx_draw_engine.c b/libs/video/tests/test_rsx_draw_engine.c
index 11aecbd..690dd48 100644
--- a/libs/video/tests/test_rsx_draw_engine.c
+++ b/libs/video/tests/test_rsx_draw_engine.c
@@ -16,2 +16,3 @@
 #include "rsx_primitives.h"   /* RSX_PRIMITIVE_* */
+#include "rsx_test_programs.h"
 
@@ -1431,2 +1432,69 @@ static void test_antialiased_surface(void)
 
+/* A guest program pair whose fragment program reads WPOS (MOV r0, WPOS), on
+ * targets of each sample grid: WPOS must count pixels, not the samples the
+ * target is held at. */
+#define WPOS_FP_OFFSET 0x00030000u       /* main memory */
+static char g_wpos_ps[65536];
+static u32 wpos_capture_pipeline(void* u, const char* vs, const char* ps,
+                                 const rsx_be_render_state* rs,
+                                 const rsx_vertex_layout_plan* layout,
+                                 u32 stride, rsx_be_format rt, u32 rt_count)
+{
+    snprintf(g_wpos_ps, sizeof g_wpos_ps, "%s", ps ? ps : "");
+    return stub_pipeline_create(u, vs, ps, rs, layout, stride, rt, rt_count);
+}
+
+static void test_antialiased_wpos(void)
+{
+    printf("-- WPOS on an antialiased surface\n");
+    static const struct { u32 aa; const char* line; } cases[] = {
+        { 0, NULL },
+        { 3, "    input.position.xy = floor(input.position.xy / float2(2, 1)) + 0.5;\n" },
+        { 4, "    input.position.xy = floor(input.position.xy / float2(2, 2)) + 0.5;\n" },
+        { 5, "    input.position.xy = floor(input.position.xy / float2(2, 2)) + 0.5;\n" },
+    };
+    engine_up();
+    rsx_draw_backend be = g_stub_backend;
+    be.pipeline_create = wpos_capture_pipeline;
+    rsx_draw_engine_set_backend(&be);
+    u8 vp[16];
+    rsx_test_vp_mov_out(vp, 0, RSX_TEST_VP_SWZ_IDENT, 0, 1);
+    m(0x1E9C, 0);                                    /* TRANSFORM_PROGRAM_LOAD */
+    for (u32 i = 0; i < 4; i++) { u32 w; memcpy(&w, vp + i * 4, 4); m(0xB80 + i * 4, w); }
+    m(0x1EA0, 0);                                    /* TRANSFORM_PROGRAM_START */
+    rsx_test_fp_instr(vm_base + WPOS_FP_OFFSET,
+                      RSX_TEST_FP_OPC(RSX_TEST_FP_OP_MOV) | RSX_TEST_FP_MASK_XYZW |
+                      RSX_TEST_FP_INSRC(0) | RSX_TEST_FP_END,
+                      RSX_TEST_FP_SRC_INPUT | RSX_TEST_FP_SWZ_IDENT);
+    m(0x08E4, WPOS_FP_OFFSET | 2u);                  /* SHADER_PROGRAM, main */
+    m(0x1D60, 0x40u);                                /* SHADER_CONTROL: fp32 exports */
+    u32 handles[4];
+    for (u32 i = 0; i < sizeof cases / sizeof cases[0]; i++) {
+        m(M_SURFACE_FORMAT, 8u | (cases[i].aa << 12));
+        const int before = stub.n_pipeline_create;
+        draw_triangle();
+        handles[i] = stub.bound_pipeline;
+        /* SQUARE_ROTATED_4 has SQUARE_CENTERED_4's 2x2 grid, and its pipeline. */
+        const int built = cases[i].aa == 5 ? 0 : 1;
+        CHECK(stub.n_pipeline_create == before + built && stub.n_draw &&
+              strstr(g_wpos_ps, "(input.position)."),
+              "antialias %u: the WPOS program draws (%d new pipeline)", cases[i].aa, built);
+        if (cases[i].line)
+            CHECK(strstr(g_wpos_ps, cases[i].line) != NULL,
+                  "antialias %u: WPOS is the centre of the pixel, not of the sample", cases[i].aa);
+        else
+            CHECK(strstr(g_wpos_ps, "input.position.xy =") == NULL,
+                  "antialias 0: WPOS is the host position as before");
+    }
+    CHECK(handles[0] != handles[1] && handles[1] != handles[2] && handles[2] == handles[3],
+          "the sample grid is part of the pipeline key");
+    m(M_SURFACE_FORMAT, 8u | (3u << 12));
+    const int before = stub.n_pipeline_create;
+    draw_triangle();
+    CHECK(stub.n_pipeline_create == before && stub.bound_pipeline == handles[1],
+          "back on the 2x1 grid, its pipeline is reused");
+    m(0x08E4, 0);
+    engine_down();
+}
+
 /* ---- 10. a zeta or a target read in a texture format of its own --------- */
@@ -1670,2 +1738,3 @@ int main(void)
     test_antialiased_surface();
+    test_antialiased_wpos();
     test_depth_read_as_color();
