+# ps3recomp - tests/gcm_nv0039
+#
+# NV0039 buffer copies (subchannel 1, GCM_SUBCH1_2D=1) through the cellGcm FIFO
+# walker, with no graphics backend and no lifted game: copies that fit land line
+# by line, copies whose span wraps 32 bits or leaves the guest window are
+# dropped. Built with the runtime (PS3RECOMP_BUILD_TESTS).
+#
+#   ctest --test-dir build-tests -R gcm_nv0039 --output-on-failure
+
+add_executable(test_gcm_nv0039
+    main.c
+    "${PROJECT_SOURCE_DIR}/runtime/host/host_stubs.c"
+)
+target_link_libraries(test_gcm_nv0039 PRIVATE ps3recomp_runtime)
+if(NOT WIN32)
+    target_link_libraries(test_gcm_nv0039 PRIVATE m)
+endif()
+target_include_directories(test_gcm_nv0039 PRIVATE
+    "${PROJECT_SOURCE_DIR}/libs/video"
+    "${PROJECT_SOURCE_DIR}/include"
+    "${PROJECT_SOURCE_DIR}/runtime"
+)
+# The runtime carries C++, so the C++ driver does the final link.
+set_target_properties(test_gcm_nv0039 PROPERTIES LINKER_LANGUAGE CXX)
+add_test(NAME gcm_nv0039 COMMAND test_gcm_nv0039)
diff --git a/tests/gcm_nv0039/main.c b/tests/gcm_nv0039/main.c
new file mode 100644
index 0000000..c7cdde3
--- /dev/null
+++ b/tests/gcm_nv0039/main.c
@@ -0,0 +1,208 @@
+/*
+ * ps3recomp - tests/gcm_nv0039
+ *
+ * NV0039 (memory-to-memory buffer copy, libgcm's subchannel 1) through the
+ * cellGcm FIFO walker, with GCM_SUBCH1_2D=1 and no graphics backend. A small
+ * command ring is built in guest memory and drained with cellGcm_rsx_process_fifo.
+ *
+ *   - a packed and a pitched copy between IO-mapped main memory land, line by
+ *     line, and touch nothing past the last line;
+ *   - copies whose span does not fit are dropped, not run: a line count and pitch
+ *     whose span wraps 32 bits (strided and packed), a range whose end wraps the
+ *     32-bit IO space, and local memory the test's guest window does not back.
+ *     Each of these runs in a child process: a copy that is not dropped runs
+ *     gigabytes past the guest window and kills it, which reads as a FAIL here
+ *     instead of a crash of the whole test.
+ *
+ * Exit code 0 when every check passes.
+ */
+#include "cellGcmSys.h"
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+extern void cellGcm_rsx_process_fifo(void);
+extern void vm_write32(uint64_t addr, uint32_t v);
+extern uint32_t vm_read32(uint64_t addr);
+extern uint32_t ppu_vm_size;
+extern uint32_t ppu_hle_inject_base;
+
+uint8_t* vm_base = NULL;
+
+#define IO_ADDR    0x00100000u      /* command buffer + IO window, io 0 */
+#define IO_SIZE    0x00200000u
+#define CMD_SIZE   0x00010000u
+#define HEAP_BASE  0x00400000u
+
+#define MAIN_DMA   0xFEED0001u      /* CELL_GCM_CONTEXT_DMA_MEMORY_HOST_BUFFER */
+#define LOCAL_DMA  0xFEED0000u      /* CELL_GCM_CONTEXT_DMA_MEMORY_FRAME_BUFFER */
+#define SRC_OFF    0x00020000u      /* IO offsets of the copies, inside the window */
+#define DST_OFF    0x00090000u
+#define SENTINEL   0xA5u
+
+static void gw32(uint32_t ea, uint32_t v)
+{
+    uint8_t* p = vm_base + ea;
+    p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v;
+}
+
+static uint32_t g_heap = HEAP_BASE;
+static u32 host_alloc(u32 size, u32 align)
+{
+    if (!align) align = 4;
+    g_heap = (g_heap + align - 1u) & ~(align - 1u);
+    u32 r = g_heap;
+    g_heap += size;
+    return r;
+}
+static void host_w32(u32 ea, u32 v) { gw32(ea, v); }
+
+static uint32_t g_head, g_cdata, g_ctrl;
+static void emit_word(uint32_t v) { gw32(IO_ADDR + g_head, v); g_head += 4; }
+static void emit1(uint32_t m, uint32_t d)          /* one subchannel-1 method */
+{
+    emit_word((1u << 18) | (1u << 13) | (m & 0x1FFCu));
+    emit_word(d);
+}
+
+static int g_fail;
+#define CHECK(c, ...) do { if (c) printf("[PASS] " __VA_ARGS__); \
+                           else { g_fail++; printf("[FAIL] " __VA_ARGS__); } printf("\n"); } while (0)
+
+typedef struct {
+    uint32_t dma_in, dma_out, off_in, off_out, pitch_in, pitch_out, len, lines;
+} copy_t;
+
+static void emit_copy(const copy_t* c)
+{
+    emit1(0x0184, c->dma_in);
+    emit1(0x0188, c->dma_out);
+    emit1(0x030C, c->off_in);
+    emit1(0x0310, c->off_out);
+    emit1(0x0314, c->pitch_in);
+    emit1(0x0318, c->pitch_out);
+    emit1(0x031C, c->len);
+    emit1(0x0320, c->lines);
+    emit1(0x0324, 0x101u);                           /* FORMAT: 1-byte in/out */
+    emit1(0x0328, 0);                                /* BUFFER_NOTIFY: run it */
+}
+
+/* Hands the ring up to g_head to the walker and drains it. */
+static void run_ring(void)
+{
+    gw32(g_cdata + 0x8, IO_ADDR + g_head);           /* context current */
+    vm_write32(g_ctrl + 0, g_head);                  /* put */
+    cellGcm_rsx_process_fifo();
+}
+
+static void fill_src(void)
+{
+    for (uint32_t i = 0; i < 0x10000u; i++) vm_base[IO_ADDR + SRC_OFF + i] = (uint8_t)(i * 7u + 1u);
+}
+static void fill_dst(void) { memset(vm_base + IO_ADDR + DST_OFF, SENTINEL, IO_SIZE - DST_OFF); }
+
+/* dst line i: the source's line i, then sentinel bytes up to the next line. */
+static int copied(const copy_t* c, uint32_t extent)
+{
+    const uint32_t pin = c->pitch_in ? c->pitch_in : c->len, pout = c->pitch_out ? c->pitch_out : c->len;
+    const uint8_t* d = vm_base + IO_ADDR + DST_OFF;
+    const uint8_t* s = vm_base + IO_ADDR + SRC_OFF;
+    for (uint32_t o = 0; o < extent; o++) {
+        const uint32_t line = o / pout, col = o % pout;
+        const uint8_t want = (line < c->lines && col < c->len) ? s[line * pin + col] : SENTINEL;
+        if (d[o] != want) return 0;
+    }
+    return 1;
+}
+
+static int dst_untouched(uint32_t extent)
+{
+    const uint8_t* d = vm_base + IO_ADDR + DST_OFF;
+    for (uint32_t o = 0; o < extent; o++) if (d[o] != SENTINEL) return 0;
+    return 1;
+}
+
+/* A copy that must be dropped, run in a child: it exits 0 when the walker drained
+ * the ring and the destination (as far as the window goes) still holds sentinels. */
+static void check_dropped(const char* what, const copy_t* c)
+{
+    fill_dst();
+    const uint32_t head0 = g_head;
+    emit_copy(c);
+    const uint32_t put = g_head;
+    g_head = head0;                                  /* the parent's ring stays where it was */
+    const pid_t pid = fork();
+    if (pid == 0) {
+        g_head = put;
+        run_ring();
+        const int ok = vm_read32(g_ctrl + 4) == put && dst_untouched(IO_SIZE - DST_OFF);
+        _exit(ok ? 0 : 1);
+    }
+    int st = 0;
+    if (pid < 0 || waitpid(pid, &st, 0) != pid) { g_fail++; printf("[FAIL] %s: fork/wait\n", what); return; }
+    if (WIFSIGNALED(st))
+        CHECK(0, "%s: dropped (the copy ran and the walker died on signal %d)", what, WTERMSIG(st));
+    else
+        CHECK(WIFEXITED(st) && WEXITSTATUS(st) == 0, "%s: dropped, destination untouched (child exit %d)",
+              what, WIFEXITED(st) ? WEXITSTATUS(st) : -1);
+}
+
+int main(void)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    setenv("GCM_SUBCH1_2D", "1", 1);                 /* subchannel 1 = the 2D engines */
+    /* Up to the HLE inject window, where cellGcmSetupContext puts the control
+     * register and the offset tables; calloc is lazy, so this costs address
+     * space rather than memory. Local memory (0xC0000000) is past its end. */
+    const uint32_t vm_size = ppu_hle_inject_base + 0x10000u;
+    vm_base = (uint8_t*)calloc(1, vm_size);
+    if (!vm_base) { printf("[FAIL] guest VM alloc\n"); return 1; }
+    ppu_vm_size = vm_size;
+
+    u32 ctx_out = host_alloc(4, 4);
+    g_cdata = cellGcmSetupContext(ctx_out, CMD_SIZE, IO_SIZE, IO_ADDR, host_alloc, host_w32);
+    g_ctrl = (uint32_t)(uintptr_t)cellGcmGetControlRegister();
+    g_head = 0;
+
+    /* Copies that fit: packed, then pitched (in 0x30, out 0x50). */
+    const copy_t packed  = { MAIN_DMA, MAIN_DMA, SRC_OFF, DST_OFF, 0, 0, 0x40, 8 };
+    const copy_t pitched = { MAIN_DMA, MAIN_DMA, SRC_OFF, DST_OFF, 0x30, 0x50, 0x20, 6 };
+    fill_src();
+    fill_dst();
+    emit_copy(&packed);
+    run_ring();
+    CHECK(vm_read32(g_ctrl + 4) == g_head, "packed copy: walker drained the ring (get 0x%X, put 0x%X)",
+          vm_read32(g_ctrl + 4), g_head);
+    CHECK(copied(&packed, 0x40 * 8 + 0x100), "packed copy: 8 lines of 0x40, nothing past them");
+    fill_dst();
+    emit_copy(&pitched);
+    run_ring();
+    CHECK(copied(&pitched, 0x50 * 6 + 0x100), "pitched copy: 6 lines of 0x20, pitch 0x30 -> 0x50");
+
+    /* Spans past 4 GB that wrap to a few bytes in 32 bits: 0x10000 * 0x10000 + 0x10 = 0x10, and
+     * 0x100 * 0x1000000 = 0. */
+    check_dropped("strided span wrapping 32 bits",
+                  &(copy_t){ MAIN_DMA, MAIN_DMA, SRC_OFF, DST_OFF, 0x10000, 0x10000, 0x10, 0x10001 });
+    check_dropped("packed span wrapping 32 bits",
+                  &(copy_t){ MAIN_DMA, MAIN_DMA, SRC_OFF, DST_OFF, 0, 0, 0x100, 0x1000000 });
+    /* A span that fits in 32 bits but runs off the end of IO space: offset + 0xFFFFFFF0 - 1
+     * wraps to an offset in the same mapped page, at the same distance from the start. */
+    check_dropped("IO range wrapping the 32-bit IO space",
+                  &(copy_t){ MAIN_DMA, MAIN_DMA, SRC_OFF, DST_OFF, 0, 0, 0xFFFFFFF0u, 1 });
+    /* Local memory is in range of its context but not backed here (past ppu_vm_size). */
+    check_dropped("local memory past the backed guest window",
+                  &(copy_t){ MAIN_DMA, LOCAL_DMA, SRC_OFF, 0x1000, 0, 0, 0x100, 4 });
+
+    /* The parent's walker still copies after the dropped ones were only ever run in children. */
+    fill_dst();
+    emit_copy(&pitched);
+    run_ring();
+    CHECK(copied(&pitched, 0x50 * 6 + 0x100), "pitched copy again after the dropped ones");
+
+    printf("[gcm_nv0039] %s (%d failed)\n", g_fail ? "FAIL" : "PASS", g_fail);
+    free(vm_base);
+    return g_fail ? 1 : 0;
+}
