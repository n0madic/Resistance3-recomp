rsx dispatch: emit an immediate-mode vertex on attribute 0 in every SET_VERTEX_DATA* form.

Only the DATA3F (0x1508) and DATA4F (0x1C0C) position writes emitted a vertex. Resistance 3 draws its Bink movie
frames (and other full-screen passes) as BEGIN_END(QUADS) groups whose position is SET_VERTEX_DATA2F_M attribute 0
(0x1880/0x1884), so every such group reached the draw engine with no vertices and was dropped as empty: movie audio
and subtitles played over a black picture. The vertex now completes on the last word of attribute 0 in each form
vtx_const_fold already decodes (1F, 2F, 3F, 4F, 2S, 4UB, 4S, SCALED4S).

Upstream: not proposed yet.

---

diff --git a/libs/video/rsx_dispatch.c b/libs/video/rsx_dispatch.c
index 62e9052..b4d8d86 100644
--- a/libs/video/rsx_dispatch.c
+++ b/libs/video/rsx_dispatch.c
@@ -306,2 +306,24 @@ static void vtx_const_fold(rsx_dispatch* rsx, u32 m, u32 arg)
 
+/* The method writing the last word of attribute 0 in each SET_VERTEX_DATA*
+ * form: the write that emits an immediate-mode vertex. Resistance 3 draws its
+ * Bink movie and full-screen passes as QUADS with a DATA2F position (0x1884);
+ * only the 3F and 4F forms emitted, so those groups reached the sink with no
+ * vertices and the movie never drew. */
+static int vtx_completes_position(u32 m)
+{
+    switch (m) {
+    case 0x1E40:    /* DATA1F */
+    case 0x1884:    /* DATA2F */
+    case 0x1508:    /* DATA3F */
+    case 0x1C0C:    /* DATA4F */
+    case 0x1900:    /* DATA2S */
+    case 0x1940:    /* DATA4UB */
+    case 0x1984:    /* DATA4S */
+    case 0x0A84:    /* DATA_SCALED4S */
+        return 1;
+    default:
+        return 0;
+    }
+}
+
 void rsx_dispatch_method(rsx_dispatch* rsx, u32 method, u32 arg)
@@ -328,6 +350,7 @@ void rsx_dispatch_method(rsx_dispatch* rsx, u32 method, u32 arg)
 
-    /* Completing a floating-point position emits a register-based vertex.
-     * Other attributes update the current values copied with that position.
-     * Keep these writes as ordinary constant state outside BEGIN/END. */
-    if (rsx->in_begin_end && (method == 0x1508 || method == 0x1C0C) &&
+    /* Completing a position (attribute 0) emits a register-based vertex, in
+     * whichever SET_VERTEX_DATA* form it was written. Other attributes update
+     * the current values copied with that position. Keep these writes as
+     * ordinary constant state outside BEGIN/END. */
+    if (rsx->in_begin_end && vtx_completes_position(method) &&
         rsx->sink.immediate_vertex)
