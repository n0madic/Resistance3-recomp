diff --git a/libs/video/rsx_draw_engine.c b/libs/video/rsx_draw_engine.c
index a1a16e9..97ca2da 100644
--- a/libs/video/rsx_draw_engine.c
+++ b/libs/video/rsx_draw_engine.c
@@ -1403,3 +1403,3 @@ static u32 eng_vtex_mask(void)
  * pipeline identity (rsx_live_draw.c keys them the same way). */
-static u32 eng_unnorm_units(u32 dim[RSX_DSP_NUM_TEXTURES][2])
+static u32 eng_unnorm_units(u32 dim[RSX_DSP_NUM_TEXTURES][3])
 {
@@ -1409,3 +1409,3 @@ static u32 eng_unnorm_units(u32 dim[RSX_DSP_NUM_TEXTURES][2])
         rsx_dsp_get_texture(&g.rsx, u, &t);
-        dim[u][0] = dim[u][1] = 0;
+        dim[u][0] = dim[u][1] = dim[u][2] = 0;
         if (!t.enabled || !(t.format & RSX_TEX_FMT_UNNORM) || !t.width || !t.height)
@@ -1415,2 +1415,3 @@ static u32 eng_unnorm_units(u32 dim[RSX_DSP_NUM_TEXTURES][2])
         dim[u][1] = t.height;
+        dim[u][2] = t.depth;
     }
@@ -1696,3 +1697,3 @@ static u32 eng_pipeline_get(const rsx_vertex_layout_plan* layout,
 
-    u32 unnorm_dim[RSX_DSP_NUM_TEXTURES][2];
+    u32 unnorm_dim[RSX_DSP_NUM_TEXTURES][3];
     /* Shadow helpers normalize against the bound resource themselves. Only
@@ -1703,3 +1704,3 @@ static u32 eng_pipeline_get(const rsx_vertex_layout_plan* layout,
         if (!(unnorm_mask & (1u << u)))
-            unnorm_dim[u][0] = unnorm_dim[u][1] = 0;
+            unnorm_dim[u][0] = unnorm_dim[u][1] = unnorm_dim[u][2] = 0;
 
@@ -1780,3 +1781,4 @@ static u32 eng_pipeline_get(const rsx_vertex_layout_plan* layout,
         if (fi > 0 && rsx_fp_apply_unnorm_scale(s_ps_hlsl, sizeof s_ps_hlsl, unnorm_mask,
-                                                (const u32 (*)[2])unnorm_dim, cube_mask) < 0)
+                                                (const u32 (*)[3])unnorm_dim, cube_mask,
+                                                vol_mask) < 0)
             fi = -1;
diff --git a/libs/video/rsx_fp_decompiler.c b/libs/video/rsx_fp_decompiler.c
index d3f09a5..84a343f 100644
--- a/libs/video/rsx_fp_decompiler.c
+++ b/libs/video/rsx_fp_decompiler.c
@@ -1657,6 +1657,8 @@ u32 rsx_fp_code_hash(const u8* ucode, u32 max_bytes)
  * Cube units are skipped: their coordinate is a float3 direction, and
- * RSX_TEX_FMT_UNNORM has no meaning for one.
+ * RSX_TEX_FMT_UNNORM has no meaning for one. A volume unit (Texture3D) is
+ * sampled with three coordinates, all in texels, so it is divided by its depth
+ * too (RPCS3's texture cache scales a 3D texture's r by 1/depth the same way).
  */
 int rsx_fp_apply_unnorm_scale(char* hlsl, u32 hlsl_size, u32 unnorm_mask,
-                              const u32 dim[][2], u32 cube_mask)
+                              const u32 dim[][3], u32 cube_mask, u32 volume_mask)
 {
@@ -1668,4 +1670,5 @@ int rsx_fp_apply_unnorm_scale(char* hlsl, u32 hlsl_size, u32 unnorm_mask,
         if ((cube_mask >> u) & 1u) continue;
-        const u32 w = dim[u][0], h = dim[u][1];
-        if (!w || !h) continue;
+        const u32 w = dim[u][0], h = dim[u][1], d = dim[u][2];
+        const int volume = (volume_mask >> u) & 1u;
+        if (!w || !h || (volume && !d)) continue;
 
@@ -1695,4 +1698,8 @@ int rsx_fp_apply_unnorm_scale(char* hlsl, u32 hlsl_size, u32 unnorm_mask,
                 char scale[80];
-                snprintf(scale, sizeof scale, " * float2(%.9g, %.9g)",
-                         1.0 / (double)w, 1.0 / (double)h);
+                if (volume)
+                    snprintf(scale, sizeof scale, " * float3(%.9g, %.9g, %.9g)",
+                             1.0 / (double)w, 1.0 / (double)h, 1.0 / (double)d);
+                else
+                    snprintf(scale, sizeof scale, " * float2(%.9g, %.9g)",
+                             1.0 / (double)w, 1.0 / (double)h);
                 const u32 slen = (u32)strlen(scale);
diff --git a/libs/video/rsx_fp_decompiler.h b/libs/video/rsx_fp_decompiler.h
index 3861242..4e7dd40 100644
--- a/libs/video/rsx_fp_decompiler.h
+++ b/libs/video/rsx_fp_decompiler.h
@@ -88,7 +88,8 @@ float rsx_fp_alpha_ref(u32 raw, u32 surface_color_format);
 /* Scale texel-space (RSX_TEX_FMT_UNNORM) coordinates into HLSL's 0..1 range.
- * unnorm_mask selects the units; dim[u] gives that unit's {width, height};
- * cube units are skipped. Returns the number of Sample sites patched, or -1 if
+ * unnorm_mask selects the units; dim[u] gives that unit's {width, height,
+ * depth}; cube units are skipped and volume_mask units (Texture3D) are divided
+ * by their depth as well. Returns the number of Sample sites patched, or -1 if
  * the buffer would overflow. A no-op when unnorm_mask is 0. */
 int rsx_fp_apply_unnorm_scale(char* hlsl, u32 hlsl_size, u32 unnorm_mask,
-                              const u32 dim[][2], u32 cube_mask);
+                              const u32 dim[][3], u32 cube_mask, u32 volume_mask);
 
