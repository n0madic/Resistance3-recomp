diff --git a/libs/video/rsx_texture_layout.c b/libs/video/rsx_texture_layout.c
index 131cc0d..77e4f10 100644
--- a/libs/video/rsx_texture_layout.c
+++ b/libs/video/rsx_texture_layout.c
@@ -329,9 +329,16 @@ void rsx_texture_component_remap(u32 control1, u32 rsx_fmt, u8 out[4])
      * God of War: Ascension samples its X16 font atlas through crossbar 0xAAEE
-     * (every output from G or B), which read zeros -- all menu text invisible. */
-    static const u8 lanes_argb[4] = {3, 0, 1, 2};
-    static const u8 lanes_g8b8[4] = {1, 0, 1, 0};
-    static const u8 lanes_b8[4]   = {RSX_REMAP_ONE, 0, 0, 0};
+     * (every output from G or B), which read zeros -- all menu text invisible.
+     * The depth formats decode to one channel and present it on every source
+     * (RPCS3 VKFormats.cpp get_component_mapping: R,R,R,R): Resistance 3 reads
+     * its DEPTH16 shadow maps through crossbar 0xA900, R, G and B from A,
+     * which through lanes_argb was the resource's opaque alpha -- every
+     * shadow compare saw depth 1.0. */
+    static const u8 lanes_argb[4]  = {3, 0, 1, 2};
+    static const u8 lanes_g8b8[4]  = {1, 0, 1, 0};
+    static const u8 lanes_b8[4]    = {RSX_REMAP_ONE, 0, 0, 0};
+    static const u8 lanes_depth[4] = {0, 0, 0, 0};
     const u32 base = rsx_fmt & 0x9Fu;
     const u8* src2res = (base == 0x8Bu) ? lanes_g8b8
-                      : (base == 0x81u || base == 0x94u) ? lanes_b8 : lanes_argb;
+                      : (base == 0x81u || base == 0x94u) ? lanes_b8
+                      : (base >= 0x90u && base <= 0x93u) ? lanes_depth : lanes_argb;
 
diff --git a/libs/video/tests/test_rsx_draw_engine.c b/libs/video/tests/test_rsx_draw_engine.c
index 117d81f..5940211 100644
--- a/libs/video/tests/test_rsx_draw_engine.c
+++ b/libs/video/tests/test_rsx_draw_engine.c
@@ -1805,2 +1805,88 @@ static void test_z16_read_as_depth16_on_gpu(void)
 
+/* A depth-writing draw through a 256x256 Z24S8 zeta at `offset`; returns the
+ * depth target it was given, or 0. */
+static u32 depth_draw_at(u32 offset)
+{
+    m(M_CONTEXT_DMA_ZETA, DMA_LOCAL);
+    m(M_SURFACE_FORMAT, 8u | (2u << 5));
+    m(M_ZETA_OFFSET, offset);
+    m(M_ZETA_PITCH, 256u * 4u);
+    m(M_COLOR_MASK, 0u);
+    m(M_DEPTH_TEST, 1u);
+    m(M_DEPTH_WRITE, 1u);
+    m(M_TEX_UNIT + 0x0C, 0u);
+    stub.bound_depth = 0;
+    draw_triangle();
+    return stub.bound_depth;
+}
+
+/* The zeta and surface tables used to keep every target forever: once 64
+ * addresses had been rendered to, a new one got no slot, and a level loaded
+ * after enough cutscenes rendered its shadow maps nowhere. A full table now
+ * gives up the entry used longest ago, but never one used this frame or the
+ * last, and a texture read counts as a use. */
+static void test_full_tables_evict_the_oldest(void)
+{
+    printf("-- full surface and zeta tables evict the least recently used\n");
+    engine_up();
+#define ZETA_AT(k) (0x00100000u + (u32)(k) * 0x1000u)
+    u32 h[64];
+    for (u32 k = 0; k < 64; k++) h[k] = depth_draw_at(ZETA_AT(k));
+    CHECK(h[0] && h[63], "64 zetas got depth targets");
+    rsx_draw_engine_present();
+    rsx_draw_engine_present();
+
+    /* Zeta 1 is read as a texture this frame, through zeta 63. */
+    m(M_COLOR_MASK, 0x01010101u);
+    m(M_DEPTH_TEST, 0u);
+    m(M_DEPTH_WRITE, 0u);
+    bind_texture_unit(RSX_LOCATION_LOCAL, ZETA_AT(1));
+    m(0x1840 /* control3: pitch */, 256u * 4u);
+    draw_triangle();
+
+    int creates = stub.n_depth_create;
+    const u32 n64 = depth_draw_at(ZETA_AT(64));
+    CHECK(n64 && stub.n_depth_create == creates + 1 && !stub.alive[h[0]],
+          "a 65th zeta takes the oldest one's slot (%d creates, zeta 0 %s)",
+          stub.n_depth_create - creates, stub.alive[h[0]] ? "alive" : "released");
+    const u32 n65 = depth_draw_at(ZETA_AT(65));
+    CHECK(n65 && stub.alive[h[1]] && !stub.alive[h[2]] && stub.alive[h[63]],
+          "the next skips the zeta read this frame and the one bound (1 %d, 2 %d, 63 %d)",
+          stub.alive[h[1]], stub.alive[h[2]], stub.alive[h[63]]);
+
+    /* Zetas 3..62 are the only old ones left; after them nothing is evicted. */
+    u32 made = 0;
+    for (u32 k = 66; k < 66 + 61; k++) {
+        creates = stub.n_depth_create;
+        depth_draw_at(ZETA_AT(k));
+        if (stub.n_depth_create == creates + 1) made++;
+    }
+    CHECK(made == 60 && stub.alive[h[1]] && stub.alive[h[63]] && stub.alive[n64],
+          "60 more evict zetas 3..62, then a full table of this frame's zetas refuses (%u)", made);
+#undef ZETA_AT
+
+    /* Colour surfaces: the same rule, and the presented one stays. */
+    const u32 base_color = stub.bound_rt[0];
+    m(M_DEPTH_TEST, 0u);
+    m(M_DEPTH_WRITE, 0u);
+    m(M_COLOR_MASK, 0x01010101u);
+    m(M_CONTEXT_DMA_ZETA, 0u);
+    u32 c[64];
+    for (u32 k = 0; k < 63; k++) {
+        m(M_COLOR_A_OFFSET, 0x00200000u + k * 0x10000u);
+        draw_triangle();
+        c[k] = stub.bound_rt[0];
+    }
+    rsx_draw_engine_present();
+    rsx_draw_engine_present();
+    creates = stub.n_color_create;
+    m(M_COLOR_A_OFFSET, 0x00200000u + 63u * 0x10000u);
+    draw_triangle();
+    CHECK(stub.n_color_create == creates + 1 && !stub.alive[base_color] &&
+          stub.alive[c[62]] && stub.alive[c[0]],
+          "a 65th surface takes the oldest one's slot, not the presented one's (%d creates)",
+          stub.n_color_create - creates);
+    engine_down();
+}
+
 static void test_color_read_as_float(void)
@@ -2050,2 +2136,3 @@ int main(void)
     test_z16_read_as_depth16_on_gpu();
+    test_full_tables_evict_the_oldest();
     test_color_read_as_float();
diff --git a/libs/video/tests/test_texture_layout.c b/libs/video/tests/test_texture_layout.c
index b2f93a7..af2e0f6 100644
--- a/libs/video/tests/test_texture_layout.c
+++ b/libs/video/tests/test_texture_layout.c
@@ -707,2 +707,24 @@ static void test_remap_x16_lanes(void)
 
+/* The depth formats decode to one channel and present it on every source,
+ * as RPCS3 maps them (R,R,R,R): a shadow map read through crossbar 0xA900
+ * (R, G and B from A, A forced to one) gets the depth in R, not the
+ * resource's opaque alpha, which made every shadow compare see 1.0. */
+static void test_remap_depth_lanes(void)
+{
+    static const u32 fmts[4] = { 0x90u, 0x91u, 0x92u, 0x93u };
+    for (int f = 0; f < 4; f++) {
+        u8 m[4];
+        rsx_texture_component_remap(0xA900u, fmts[f] | FMT_LN | 0x40u, m);
+        CHECK_EQ(m[A_], RSX_REMAP_ONE); CHECK_EQ(m[R_], 0);
+        CHECK_EQ(m[G_], 0); CHECK_EQ(m[B_], 0);
+        u8 n[4];
+        rsx_texture_component_remap(0xAAE4u, fmts[f], n);
+        for (int i = 0; i < 4; i++) CHECK_EQ(n[i], 0);
+    }
+    /* A8R8G8B8 keeps its own lanes: 0xA900 reads its alpha. */
+    u8 c[4];
+    rsx_texture_component_remap(0xA900u, FMT_A8R8G8B8, c);
+    CHECK_EQ(c[R_], 3); CHECK_EQ(c[A_], RSX_REMAP_ONE);
+}
+
 /* Compressed formats decode to RGBA, so they use the same lanes as A8R8G8B8 --
@@ -795,2 +817,3 @@ int main(void)
     test_remap_dxt_matches_argb();
+    test_remap_depth_lanes();
     test_expand_mask();
