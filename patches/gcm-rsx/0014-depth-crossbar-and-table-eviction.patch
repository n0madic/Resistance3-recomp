 } eng_zdepth;
@@ -619,2 +621,29 @@ static const void* eng_surface_seed(u32 location, u32 offset, u32 w, u32 h,
 
+/* The surface and zeta tables keep every target a title has rendered to, and
+ * nothing used to take an entry out. Resistance 3 fills both 64-entry tables
+ * with its prologue's and cutscenes' targets before its first level loads, so
+ * the level's shadow maps got no depth target: rendered nowhere, read back as
+ * zeros from guest memory, every shadow in the level lost. A full table now
+ * gives up the entry used longest ago, if that was before the previous frame;
+ * anything this frame or the last one used stays, and with nothing older the
+ * table is too small for the frame and the caller gets no slot, as before.
+ * What an evicted target held and guest memory never got is gone, as it is for
+ * any address the engine never saw. Returns the slot, or ENG_INVALID. */
+#define ENG_EVICT_MIN_AGE 2u
+static u32 eng_oldest_slot(const char* what, const u32* last_use, size_t stride, u32 n, u32 keep)
+{
+    u32 best = ENG_INVALID, best_use = 0;
+    for (u32 i = 0; i < n; i++) {
+        const u32 use = *(const u32*)((const u8*)last_use + i * stride);
+        if (i == keep || g.frames - use < ENG_EVICT_MIN_AGE) continue;
+        if (best == ENG_INVALID || use < best_use) { best = i; best_use = use; }
+    }
+    static u32 evict_logs = 0, full_logs = 0;
+    if (best != ENG_INVALID ? PS3_LOG_FIRST(evict_logs, 4) : PS3_LOG_FIRST(full_logs, 8))
+        fprintf(stderr, "[rsx engine] %s table full: %s\n", what,
+                best == ENG_INVALID ? "every entry was used this frame or the last, none evicted"
+                                    : "evicting the least recently used");
+    return best;
+}
+
