rsx vertex fetch: frequency 1 under a modulo operation bit is one element for the whole draw.

Resistance 3: in a fight, translucent wedges cross the screen, most of all with enemies firing from behind
(user report: turn about 180 degrees away from them). The wedges are tracer trails: a ribbon (prim 6) drawn by one
large vertex program in its trail mode (transform branch bit 3). That mode reads the trail's points from attributes
5-7 (frequency 2, divide) and its per-draw values from attributes 0-4: the start point (v0, taken for the first
point instead of attribute 6), a sprite angle, colours. Those five are set to frequency 1 with their
NV4097_SET_FREQUENCY_DIVIDER_OPERATION bits set (mask 0x11F), i.e. vertex % 1 = element 0 for every vertex, and their
arrays overlap one another (attribute 2 starts at attribute 0's second element), so they are not per-vertex data.
The engine read frequency 0 and 1 as an ordinary per-vertex array whatever the bit (RPCS3 does the same): the second
vertex of the ribbon's first pair took element 1 of attribute 0 as the trail's start, a point metres away, and the
ribbon fanned out from the real start to it. A vertex dump of such a draw: element 0 (-9.83,-16.09,15.15) close to the
trail's next point (-9.80,-15.70,15.20), element 1 (0.70,-10.7,-0.64).
rsx_vertex_freq_plain() now names the ordinary case: frequency 0, or frequency 1 under division (vertex / 1 is the
vertex, so nothing changes there); rsx_vertex_element_index and the compact fetch's per-draw span and batched loop
use it. rsx_vertex_fetch.c (the D3D12 and null backends) keeps its own rule; R3 does not run there.

test_vertex_fetch_plan, new test_modulo_frequency_one: frequency 1 with the modulo bit gives every vertex element 0
through fetch_many and fetch_one, with division element i; six of its checks fail without the change. The random
plans (which compare _prepare's span with a walk of rsx_vertex_element_index) pass, as do all 17 ctest tests and
tools/test_rsx_immediate_vertices.py.

Upstream: PR #547 (on master, without #458; drop this patch when the pin has it).

---

diff --git a/libs/video/rsx_vertex_compact.c b/libs/video/rsx_vertex_compact.c
index b0048bb..5957d8b 100644
--- a/libs/video/rsx_vertex_compact.c
+++ b/libs/video/rsx_vertex_compact.c
@@ -182,3 +182,3 @@ void rsx_vertex_fetch_plan_prepare(
         return;
-    /* Ordinary per-vertex attributes (frequency 0/1) all span the same
+    /* Ordinary per-vertex attributes (rsx_vertex_freq_plain) all span the same
      * elements: find them once for the draw instead of once per attribute.
@@ -223,3 +223,4 @@ void rsx_vertex_fetch_plan_prepare(
         u32 last = 0;
-        if (fetch->desc.frequency <= 1) {
+        if (rsx_vertex_freq_plain(fetch->desc.frequency,
+                                  (plan->divider_mask >> attr) & 1u)) {
             if (!plain_known) {
@@ -362,4 +363,4 @@ int rsx_vertex_fetch_many(
         const u32 fstride = fetch->stride;
-        const int plain = fetch->desc.frequency <= 1;
         const u32 modulo = (plan->divider_mask >> attr) & 1u;
+        const int plain = rsx_vertex_freq_plain(fetch->desc.frequency, modulo);
         const u32 n = fetch->desc.size < 4 ? fetch->desc.size : 4;
diff --git a/libs/video/rsx_vertex_formats.h b/libs/video/rsx_vertex_formats.h
index b15248d..c838e2d 100644
--- a/libs/video/rsx_vertex_formats.h
+++ b/libs/video/rsx_vertex_formats.h
@@ -48,6 +48,19 @@ static inline u32 rsx_vertex_attrib_size(u32 type, u32 num_components)
 
+/* Is the attribute an ordinary per-vertex array under
+ * NV4097_SET_FREQUENCY_DIVIDER_OPERATION? Frequency 0 always is, and so is
+ * frequency 1 with division; frequency 1 with modulo is not: vertex % 1 is 0,
+ * one element for the whole draw. Resistance 3's tracer trails pass their
+ * per-draw values (the trail's start point, its colour) that way; read per
+ * vertex, one side of the ribbon started at the next element and the trail
+ * drew a wedge across the screen. */
+static inline int rsx_vertex_freq_plain(u32 frequency, u32 modulo)
+{
+    return frequency == 0 || (frequency == 1 && !modulo);
+}
+
 /* Resolve one attribute's element under
- * NV4097_SET_FREQUENCY_DIVIDER_OPERATION. Frequency 0/1 is ordinary vertex
- * fetch, a set operation bit is modulo (instanced template), and a clear bit
- * is division (one per-instance datum shared by `frequency` vertices). */
+ * NV4097_SET_FREQUENCY_DIVIDER_OPERATION: an ordinary array (above) is
+ * indexed per vertex, a set operation bit is modulo (instanced template), and
+ * a clear bit is division (one per-instance datum shared by `frequency`
+ * vertices). */
 static inline u32 rsx_vertex_element_index(u32 vertex_id, u32 base_index,
@@ -55,3 +68,3 @@ static inline u32 rsx_vertex_element_index(u32 vertex_id, u32 base_index,
 {
-    if (frequency <= 1)
+    if (rsx_vertex_freq_plain(frequency, modulo))
         return (vertex_id + base_index) & 0x000FFFFFu;
diff --git a/libs/video/tests/test_vertex_fetch_plan.c b/libs/video/tests/test_vertex_fetch_plan.c
index 3af5feb..6983719 100644
--- a/libs/video/tests/test_vertex_fetch_plan.c
+++ b/libs/video/tests/test_vertex_fetch_plan.c
@@ -3,3 +3,3 @@
  *
- * _prepare finds the span of ordinary per-vertex attributes (frequency 0/1)
+ * _prepare finds the span of ordinary per-vertex attributes (rsx_vertex_freq_plain)
  * once per draw instead of once per attribute. Random fetch plans -- every
@@ -12,2 +12,5 @@
  *
+ * Also: frequency 1 under a modulo operation bit reads element 0 for every
+ * vertex (vertex % 1), while frequency 1 under division stays per vertex.
+ *
  * Build (from the repo root):
@@ -132,4 +135,52 @@ static void random_plan(rsx_vertex_fetch_plan* plan, int use_inline,
 
+static void put_be_f32(u8* p, float f)
+{
+    u32 u;
+    memcpy(&u, &f, 4);
+    p[0] = (u8)(u >> 24); p[1] = (u8)(u >> 16); p[2] = (u8)(u >> 8); p[3] = (u8)u;
+}
+
+/* Attribute 0 holds elements (10,11,12), (20,21,22), ...: frequency 1 with
+ * modulo gives every vertex element 0; with division, vertex i element i. */
+static void test_modulo_frequency_one(void)
+{
+    enum { VERTS = 4 };
+    mapped_end[0] = GUEST;
+    for (u32 e = 0; e < VERTS; e++)
+        for (u32 c = 0; c < 3; c++)
+            put_be_f32(&guest[0][256 + e * 12 + c * 4], (float)(10 * (e + 1) + c));
+    rsx_vertex_ref refs[VERTS];
+    for (u32 i = 0; i < VERTS; i++) { refs[i].vertex_id = i; refs[i].base_index = 0; }
+
+    for (u32 modulo = 0; modulo < 2; modulo++) {
+        rsx_vertex_fetch_plan plan;
+        memset(&plan, 0, sizeof plan);
+        rsx_vertex_layout_plan_init(&plan.layout, 1u);
+        plan.divider_mask = modulo;
+        plan.guest_ptr = guest_ptr;
+        rsx_vertex_fetch_attr* f = &plan.attr[0];
+        f->desc.type = RSX_VTX_TYPE_FLOAT;
+        f->desc.size = 3;
+        f->desc.stride = 12;
+        f->desc.frequency = 1;
+        f->desc.offset = 256;
+        f->elem_size = 12;
+        f->stride = 12;
+        rsx_vertex_fetch_plan_prepare(&plan, refs, VERTS);
+        float many[VERTS][4], one[4];
+        CHECK(rsx_vertex_fetch_many(&plan, refs, VERTS, (u8*)many), "modulo %u: fetch_many failed", modulo);
+        for (u32 i = 0; i < VERTS; i++) {
+            const float want = modulo ? 10.0f : (float)(10 * (i + 1));
+            CHECK(many[i][0] == want && many[i][2] == want + 2.0f,
+                  "modulo %u vertex %u: fetch_many (%g,%g,%g), want x %g", modulo, i,
+                  many[i][0], many[i][1], many[i][2], want);
+            CHECK(rsx_vertex_fetch_one(&plan, &refs[i], (u8*)one) && one[0] == want,
+                  "modulo %u vertex %u: fetch_one x %g, want %g", modulo, i, one[0], want);
+        }
+    }
+}
+
 int main(void)
 {
+    test_modulo_frequency_one();
     enum { PLANS = 6000, MAXV = 200 };
