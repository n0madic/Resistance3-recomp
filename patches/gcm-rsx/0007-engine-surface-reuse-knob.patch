rsx draw engine: PS3RECOMP_ENG_SURFACE_REUSE=0 turns off the reuse of a larger surface for a smaller clip.

The pin's eng_surface_get (#382) keeps a colour target when a later clip is a sub-rectangle of it (same format and
pitch). Resistance 3 alternates 960x640 and 960x704 clips at the same addresses (light buffer, scene colour) and
samples those surfaces with texture descriptors of their own size, while the engine binds the surface whole and its
normalised coordinates span all of it. With the reuse the first level shows full-width yellow bands and the doubled
images are worse than with exact sizes; with PS3RECOMP_ENG_SURFACE_REUSE=0 (surface recreated when the clip size
changes, the behaviour before #382) the bands are gone. The default stays the pin's (on), the port's host sets 0.

test_rsx_draw_engine: a smaller clip on the same pitch reuses the surface and does not with the knob off; another pitch
never reuses.

Upstream: not proposed yet (the sampling side is the cause: a surface sampled with a smaller descriptor needs its
coordinates scaled, as the D3D12 backend's rsx_texscale does).

---

diff --git a/libs/video/rsx_draw_engine.c b/libs/video/rsx_draw_engine.c
index 541057d..69df3be 100644
--- a/libs/video/rsx_draw_engine.c
+++ b/libs/video/rsx_draw_engine.c
@@ -576,2 +576,6 @@ static const void* eng_surface_seed(u32 location, u32 offset, u32 w, u32 h,
 
+/* PS3RECOMP_ENG_SURFACE_REUSE=0 (read at engine init): a clip smaller than the surface at its address recreates the
+ * surface, as before eng_surface_get reused it. Default on. */
+static int s_surface_reuse = 1;
+
 /* The colour target for this (location, offset), created or reallocated when
@@ -598,3 +602,3 @@ static u32 eng_surface_get(u32 location, u32 offset, u32 want_w, u32 want_h,
                 ((s->w == want_w && s->h == want_h) ||
-                 (pitch && s->pitch == pitch && s->w >= want_w && s->h >= want_h)))
+                 (s_surface_reuse && pitch && s->pitch == pitch && s->w >= want_w && s->h >= want_h)))
                 return i;
@@ -2947,2 +2951,4 @@ int rsx_draw_engine_init(u32 width, u32 height)
       s_texhash_full_always = e && *e && strcmp(e, "0") != 0; }
+    { const char* e = getenv("PS3RECOMP_ENG_SURFACE_REUSE");
+      s_surface_reuse = !(e && *e == '0'); }
     g.vp_cb = (u8*)calloc(1, ENG_VP_CB_BYTES);
diff --git a/libs/video/tests/test_rsx_draw_engine.c b/libs/video/tests/test_rsx_draw_engine.c
index ce7c382..11aecbd 100644
--- a/libs/video/tests/test_rsx_draw_engine.c
+++ b/libs/video/tests/test_rsx_draw_engine.c
@@ -505,2 +505,27 @@ static void test_surface_set(void)
 
+/* A smaller clip on the same rows is the same surface (default), or a new one under PS3RECOMP_ENG_SURFACE_REUSE=0. */
+static void test_surface_reuse(void)
+{
+    for (int reuse = 1; reuse >= 0; reuse--) {
+        printf("-- surface reuse %s\n", reuse ? "on" : "off");
+        if (reuse) unsetenv("PS3RECOMP_ENG_SURFACE_REUSE"); else setenv("PS3RECOMP_ENG_SURFACE_REUSE", "0", 1);
+        engine_up();
+        m(M_COLOR_A_PITCH, 1024u);                 /* 256 pixels of A8R8G8B8 */
+        m(M_CLEAR_BUFFERS, 0xF0u);
+        CHECK(stub.n_color_create == 1, "the 256x256 surface is created");
+        m(M_SURFACE_CLIP_V, 128u << 16);
+        m(M_CLEAR_BUFFERS, 0xF0u);
+        CHECK(stub.n_color_create == (reuse ? 1 : 2),
+              "a clip of 256x128 on the same pitch %s (%d creates)",
+              reuse ? "reuses the surface" : "recreates it", stub.n_color_create);
+        if (reuse) {
+            m(M_COLOR_A_PITCH, 512u);              /* another pitch is never the same rows */
+            m(M_CLEAR_BUFFERS, 0xF0u);
+            CHECK(stub.n_color_create == 2, "another pitch recreates the surface (%d creates)", stub.n_color_create);
+        }
+        engine_down();
+    }
+    unsetenv("PS3RECOMP_ENG_SURFACE_REUSE");
+}
+
 /* ---- 2. surface aliasing on texture bind --------------------------------- */
@@ -1627,2 +1652,3 @@ int main(void)
     test_surface_set();
+    test_surface_reuse();
     test_surface_aliasing();
