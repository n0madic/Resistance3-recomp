+        fprintf(stderr, "[rsx engine] depth 0x%08X (%s, %s %u) %ux%u stored to guest memory\n",
+                z->offset, bpp == 2u ? "Z16" : "Z24S8", z->swizzled ? "swizzled, pitch reg" : "pitch",
+                z->pitch, w, h);
     return 1;
@@ -1514,2 +1541,3 @@ static void eng_zdepth_wrote(u32 slot, const rsx_dsp_surface* sf)
