@@ -1805,2 +1807,70 @@ static void test_z16_read_as_depth16_on_gpu(void)
 
+/* Resistance 3 renders a lamp's shadow map into a swizzled power-of-two Z16
+ * surface (zeta pitch register 64) once the camera is close to the lamp, and
+ * reads it through a swizzled DEPTH16 texture. Neither the backend hook nor
+ * guest memory took it: the hook wanted a linear texture of the zeta's pitch,
+ * the store a pitch of a whole row. The light read guest memory or another
+ * target at that address and the lamp lit nothing. */
+static void swizzled_z16_pass_then_read_as(u32 tex_fmt)
+{
+    m(M_CONTEXT_DMA_ZETA, DMA_LOCAL);
+    m(M_SURFACE_FORMAT, 8u | (1u << 5) | (2u << 8) | (8u << 16) | (8u << 24));
+    m(M_ZETA_OFFSET, ZETA_OFFSET);
+    m(M_ZETA_PITCH, 64u);
+    m(M_COLOR_MASK, 0u);
+    m(M_DEPTH_TEST, 1u);
+    m(M_DEPTH_WRITE, 1u);
+    m(M_TEX_UNIT + 0x0C, 0u);
+    draw_triangle();
+    m(M_SURFACE_FORMAT, 8u | (2u << 5));
+    m(M_ZETA_OFFSET, ZETA_OFFSET + 0x100000u);
+    m(M_ZETA_PITCH, 256u * 4u);
+    m(M_COLOR_MASK, 0x01010101u);
+    m(M_DEPTH_TEST, 0u);
+    m(M_DEPTH_WRITE, 0u);
+    bind_texture_unit(RSX_LOCATION_LOCAL, ZETA_OFFSET);
+    m(M_TEX_UNIT + 0x04, 1u | (2u << 4) | (tex_fmt << 8) | (1u << 16));
+    m(M_TEX_UNIT + 0x18, (256u << 16) | 256u);
+    m(0x1840 /* control3: pitch */, (tex_fmt & 0x20u) ? 256u * 2u : 0u);
+}
+
+static void test_swizzled_z16_read_as_depth16(void)
+{
+    printf("-- swizzled Z16 zeta read as a swizzled DEPTH16 texture\n");
+    engine_up();
+    rsx_draw_backend be = g_stub_backend;
+    be.depth_as_color = stub_depth_as_color;
+    rsx_draw_engine_set_backend(&be);
+    g_argb_calls = 0; g_argb_fail = 0;
+    u8* z = vm_base + GUEST_LOCAL_EA + ZETA_OFFSET;
+    memset(z, 0x5A, 8);
+
+    swizzled_z16_pass_then_read_as(0x92u);
+    draw_triangle();
+    CHECK(g_argb_calls == 1 && g_argb_fmt == 0x92u && g_argb_w == 256 && g_argb_h == 256 &&
+          stub.n_depth_readback == 0 && z[0] == 0x5A,
+          "the backend made the 256x256 DEPTH16 texture (%d calls, %d readbacks)",
+          g_argb_calls, stub.n_depth_readback);
+
+    /* A linear texture over a swizzled zeta is another picture: not the hook. */
+    swizzled_z16_pass_then_read_as(0x92u | 0x20u);
+    draw_triangle();
+    CHECK(g_argb_calls == 1, "a linear read of the swizzled zeta is not converted (%d calls)",
+          g_argb_calls);
+
+    /* Refused: guest memory gets the depth in Morton order. Texel (c, r) holds
+     * r * 256 + c; (1,0) is the second texel, (0,1) the third, (2,0) the fifth. */
+    g_argb_fail = 1;
+    g_readback_ramp = 1;
+    const int readbacks = stub.n_depth_readback;
+    swizzled_z16_pass_then_read_as(0x92u);
+    draw_triangle();
+    const u32 t1 = (u32)z[2] << 8 | z[3], t2 = (u32)z[4] << 8 | z[5], t4 = (u32)z[8] << 8 | z[9];
+    const u32 t3 = (u32)z[6] << 8 | z[7];
+    CHECK(stub.n_depth_readback == readbacks + 1 && t1 == 1u && t2 == 256u && t3 == 257u && t4 == 2u,
+          "refused: stored swizzled (%u %u %u %u)", t1, t2, t3, t4);
+    g_readback_ramp = 0;
+    engine_down();
+}
+
 /* A depth-writing draw through a 256x256 Z24S8 zeta at `offset`; returns the
@@ -2136,2 +2206,3 @@ int main(void)
     test_z16_read_as_depth16_on_gpu();
+    test_swizzled_z16_read_as_depth16();
     test_full_tables_evict_the_oldest();
