diff --git a/tests/gcm_put_jump/main.c b/tests/gcm_put_jump/main.c
new file mode 100644
index 00000000..453f88ef
--- /dev/null
+++ b/tests/gcm_put_jump/main.c
@@ -0,0 +1,149 @@
+/*
+ * ps3recomp - tests/gcm_put_jump
+ *
+ * A JUMP waiting at the idle get is taken when the title stores put, not when
+ * the walker next runs. Resistance 3 runs a command block at the idle get G:
+ * JUMP block at G, JUMP G at the block's end, put = block end; once get reaches
+ * the end it sets put back to G and soon reuses the block's memory. The walker
+ * runs on the present thread and may not run again before that reuse; it then
+ * executed whatever replaced the JUMP back as commands.
+ *
+ *   - after put returns to G, get is G at once, with no drain in between;
+ *   - the block's memory overwritten afterwards (with a GET_REPORT into main
+ *     memory) is never executed;
+ *   - a put store with a method, not a JUMP, at get leaves get to the walker,
+ *     and the walker still executes it.
+ *
+ * Exit code 0 when every check passes.
+ */
+#include "cellGcmSys.h"
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+extern void cellGcm_rsx_process_fifo(void);
+extern void cellGcm_on_put_store(uint32_t put);
+extern void vm_write32(uint64_t addr, uint32_t v);
+extern uint32_t vm_read32(uint64_t addr);
+extern uint32_t ppu_vm_size;
+extern uint32_t ppu_hle_inject_base;
+
+uint8_t* vm_base = NULL;
+
+#define IO_ADDR    0x00100000u      /* command buffer + IO window, io 0 */
+#define IO_SIZE    0x00200000u
+#define CMD_SIZE   0x00010000u
+#define HEAP_BASE  0x00400000u
+
+#define BLOCK_OFF  0x8000u          /* the injected block, in the IO window */
+#define REPORT_OFF 0x50390u         /* main-memory report slot the stale block would write */
+#define REPORT2    0x503A0u         /* report slot the ring writes itself */
+#define SENTINEL   0xA5A5A5A5u
+
+#define M_REPORT_DMA 0x01A8u        /* NV4097_SET_CONTEXT_DMA_REPORT */
+#define M_GET_REPORT 0x1800u        /* NV4097_GET_REPORT */
+#define M_ZCLEAR     0x1D8Cu        /* NV4097_SET_ZSTENCIL_CLEAR_VALUE */
+#define JUMP(io)     (0x20000000u | (io))
+
+static void gw32(uint32_t ea, uint32_t v)
+{
+    uint8_t* p = vm_base + ea;
+    p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v;
+}
+static uint32_t gr32(uint32_t ea)
+{
+    const uint8_t* p = vm_base + ea;
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+}
+
+static uint32_t g_heap = HEAP_BASE;
+static u32 host_alloc(u32 size, u32 align)
+{
+    if (!align) align = 4;
+    g_heap = (g_heap + align - 1u) & ~(align - 1u);
+    u32 r = g_heap;
+    g_heap += size;
+    return r;
+}
+static void host_w32(u32 ea, u32 v) { gw32(ea, v); }
+
+/* A method with one argument at io `at`; returns the io after it. */
+static uint32_t put_method(uint32_t at, uint32_t m, uint32_t d)
+{
+    gw32(IO_ADDR + at, (1u << 18) | (m & 0x1FFCu));
+    gw32(IO_ADDR + at + 4, d);
+    return at + 8;
+}
+
+/* The title's store to put. host_stubs' vm_write32 is a plain store; the
+ * runtime's (ppu_loader.cpp) also calls the put hook for the control register. */
+static uint32_t g_ctrl;
+static void store_put(uint32_t put)
+{
+    vm_write32(g_ctrl + 0, put);
+    cellGcm_on_put_store(put);
+}
+
+static int g_fail;
+#define CHECK(c, ...) do { if (c) printf("[PASS] " __VA_ARGS__); \
+                           else { g_fail++; printf("[FAIL] " __VA_ARGS__); } printf("\n"); } while (0)
+
+int main(void)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    const uint32_t vm_size = ppu_hle_inject_base + 0x10000u;
+    vm_base = (uint8_t*)calloc(1, vm_size);
+    if (!vm_base) { printf("[FAIL] guest VM alloc\n"); return 1; }
+    ppu_vm_size = vm_size;
+
+    u32 ctx_out = host_alloc(4, 4);
+    cellGcmSetupContext(ctx_out, CMD_SIZE, IO_SIZE, IO_ADDR, host_alloc, host_w32);
+    const uint32_t ctrl = (uint32_t)(uintptr_t)cellGcmGetControlRegister();
+    g_ctrl = ctrl;
+    for (unsigned k = 0; k < 16; k += 4) {
+        gw32(IO_ADDR + REPORT_OFF + k, SENTINEL);
+        gw32(IO_ADDR + REPORT2 + k, SENTINEL);
+    }
+
+    /* The ring runs up to G and the RSX idles there. */
+    uint32_t g = put_method(0, M_ZCLEAR, 0xFFFFFF00u);
+    store_put(g);
+    cellGcm_rsx_process_fifo();
+    CHECK(vm_read32(ctrl + 4) == g, "ring drained to the idle get G = 0x%X", g);
+
+    /* Inject: JUMP block at G, a method then JUMP G in the block, put = block end. */
+    const uint32_t block_end = put_method(BLOCK_OFF, M_ZCLEAR, 0xFFFFFF00u);
+    gw32(IO_ADDR + block_end, JUMP(g));
+    const uint32_t saved = gr32(IO_ADDR + g);
+    gw32(IO_ADDR + g, JUMP(BLOCK_OFF));
+    store_put(block_end);
+    cellGcm_rsx_process_fifo();
+    CHECK(vm_read32(ctrl + 4) == block_end, "walker ran the block and idles at its end 0x%X (get 0x%X)",
+          block_end, vm_read32(ctrl + 4));
+
+    /* Put back to G, restore G, then reuse the block's memory before any drain. */
+    store_put(g);
+    gw32(IO_ADDR + g, saved);
+    CHECK(vm_read32(ctrl + 4) == g, "the put store took the JUMP back: get 0x%X == G at once",
+          vm_read32(ctrl + 4));
+    uint32_t junk = put_method(block_end, M_REPORT_DMA, 0xFEED0001u);
+    junk = put_method(junk, M_GET_REPORT, (1u << 24) | REPORT_OFF);
+    gw32(IO_ADDR + junk, JUMP(g));
+
+    /* The title appends at G and moves put; the walker continues from G. */
+    uint32_t end = put_method(g, M_REPORT_DMA, 0xFEED0001u);
+    end = put_method(end, M_GET_REPORT, (1u << 24) | REPORT2);
+    store_put(end);
+    CHECK(vm_read32(ctrl + 4) == g, "a method at get stays for the walker (get 0x%X)", vm_read32(ctrl + 4));
+    cellGcm_rsx_process_fifo();
+    CHECK(vm_read32(ctrl + 4) == end, "walker drained to put 0x%X (get 0x%X)", end, vm_read32(ctrl + 4));
+    CHECK(gr32(IO_ADDR + REPORT2 + 8) == 0xFFFFu, "the ring's own report ran (value 0x%X)",
+          gr32(IO_ADDR + REPORT2 + 8));
+    CHECK(gr32(IO_ADDR + REPORT_OFF) == SENTINEL && gr32(IO_ADDR + REPORT_OFF + 8) == SENTINEL,
+          "the reused block was not executed (report slot 0x%08X)", gr32(IO_ADDR + REPORT_OFF + 8));
+
+    printf("[gcm_put_jump] %s (%d failed)\n", g_fail ? "FAIL" : "PASS", g_fail);
+    free(vm_base);
+    return g_fail ? 1 : 0;
+}
