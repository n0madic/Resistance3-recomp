diff --git a/tools/test_ppu_put_store_hook.py b/tools/test_ppu_put_store_hook.py
new file mode 100644
index 00000000..f595d7d3
--- /dev/null
+++ b/tools/test_ppu_put_store_hook.py
@@ -0,0 +1,68 @@
+#!/usr/bin/env python3
+"""Self-check: a lifted 32-bit store to the gcm put word leaves the inline path.
+
+Lifted guest stores are inline (vm_write32_mm in the lifted header) and skip
+vm_write32, whose hook hands a new put to cellGcm_on_put_store (the JUMP at the
+idle get is taken on the storing thread). The put word must still go through
+vm_write32; every other store in range stays inline.
+
+Run: python tools/test_ppu_put_store_hook.py
+"""
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from ppu_lifter import HEADER_PREAMBLE  # noqa: E402
+
+ROOT = Path(__file__).resolve().parent.parent
+TEST = r'''
+#include "lifted.h"
+#include <stdio.h>
+#include <stdlib.h>
+uint8_t* vm_base; int vm_inline_ok, vm_inline_st_ok; uint32_t ppu_vm_size, ppu_hle_inject_base;
+uint32_t g_barrier_sync_watch, g_null_sweep_hi; const unsigned char* g_spu_coh_bits;
+static uint8_t s_mem[0x200000];
+static unsigned s_slow_n; static uint32_t s_slow_ea, s_slow_v;
+void (vm_write32)(uint64_t a, uint32_t v) { s_slow_n++; s_slow_ea = (uint32_t)a; s_slow_v = v; }
+int main(void)
+{
+    vm_base = s_mem; ppu_vm_size = sizeof s_mem; vm_inline_ok = 1; vm_inline_st_ok = 1;
+    ppu_hle_inject_base = 0x100000u;
+    const uint32_t put = ppu_hle_inject_base + 0x2000u;
+    vm_write32(put + 4u, 0x1234u);
+    int ok = s_slow_n == 0 && s_mem[put + 7] == 0x34;
+    vm_write32(put, 0x5678u);
+    ok &= s_slow_n == 1 && s_slow_ea == put && s_slow_v == 0x5678u;
+    printf("%s\n", ok ? "ok" : "FAIL");
+    return ok ? 0 : 1;
+}
+'''
+
+
+def main() -> int:
+    cc = os.environ.get("CC") or shutil.which("clang") or shutil.which("cc")
+    with tempfile.TemporaryDirectory(prefix="ppu-put-store-") as tmp:
+        t = Path(tmp)
+        (t / "lifted.h").write_text(HEADER_PREAMBLE)
+        (t / "test.c").write_text(TEST)
+        inc = ["-I", str(ROOT / "include"), "-I", str(ROOT / "runtime/ppu"), "-I", str(ROOT / "runtime")]
+        r = subprocess.run([cc, "-std=gnu17", "-O1", "-w", *inc, str(t / "test.c"), "-o", str(t / "test"),
+                            "-Wl,-undefined,dynamic_lookup" if sys.platform == "darwin" else "-Wl,--unresolved-symbols=ignore-all"],
+                           capture_output=True, text=True)
+        if r.returncode:
+            print(r.stderr)
+            return 1
+        r = subprocess.run([str(t / "test")], capture_output=True, text=True)
+        print(r.stdout.strip() or r.stderr.strip())
+        if r.returncode:
+            return 1
+    print("PASS: a lifted store to the gcm put word goes through vm_write32")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
