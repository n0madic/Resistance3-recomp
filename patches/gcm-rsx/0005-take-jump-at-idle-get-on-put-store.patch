--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -2016,2 +2016,5 @@ static void wprof_note_walker(void) {}
 volatile unsigned long g_gcm_drain_tid;
+/* Set on the thread running the walker: a put store it makes itself (the ring
+ * recycle) must not take the lock it already holds. */
+static _Thread_local int t_in_fifo_walker;
 
@@ -2023,3 +2026,5 @@ void cellGcm_rsx_process_fifo(void)
     AcquireSRWLockExclusive(&s_gcm_fifo_lock);
+    t_in_fifo_walker = 1;
     gcm_rsx_process_fifo_unlocked();
+    t_in_fifo_walker = 0;
     ReleaseSRWLockExclusive(&s_gcm_fifo_lock);
@@ -2123,2 +2128,42 @@ static void gcm_3d_method(rsx_state* st, u32 m, u32 v, int legacy_state_live, u3
  * RSX-thread profiles, so each is read once and cached, like the other knobs. */
+/* JUMPs taken at once when put moves; a chain longer than this is left to the walker. */
+#define GCM_PUT_STORE_JUMPS 8u
+
+/* The RSX fetches as soon as put moves away from get, and a title may rely on
+ * that. Resistance 3 runs a texture copy at the idle get G: it writes a JUMP to
+ * the copy at G and a JUMP back to G after it, sets put to the copy's end, waits
+ * for get to arrive there, then sets put back to G and soon reuses the copy's
+ * memory -- by then the hardware took the JUMP back long ago. The walker runs on
+ * the present thread, which can be busy for tens of milliseconds (pipeline
+ * builds at a level start), and then read whatever replaced that JUMP as
+ * commands: texture data, one word of which once set ZSTENCIL_CLEAR_VALUE to
+ * near the near plane and left every later frame a flat yellow. Take the JUMPs
+ * at get here, on the storing thread. Only branches: methods need the backend,
+ * which stays on the present thread. */
+static void gcm_take_jumps_at_get(u32 put)
+{
+    if (t_in_fifo_walker || !vm_base) return;
+    /* Unlocked look first: a JUMP waiting at an idle get is rare, put stores are not. */
+    {
+        const u32 get = s_fifo_getoff;
+        const u32 ea = get != put ? gcm_io2ea(get) : 0;
+        if (!ea || (vm_read32(ea) >> 29) != 1u) return;
+    }
+    AcquireSRWLockExclusive(&s_gcm_fifo_lock);
+    for (u32 n = 0; n < GCM_PUT_STORE_JUMPS && s_fifo_getoff != put; n++) {
+        const u32 ea = gcm_io2ea(s_fifo_getoff);
+        if (!ea) break;
+        const u32 w = vm_read32(ea);
+        if ((w >> 29) != 1u) break;                         /* not a JUMP: the walker's work */
+        const u32 tgt = w & 0x1FFFFFFCu;
+        if (tgt == s_fifo_getoff || !gcm_io2ea(tgt)) break; /* a park, or a bad branch the walker reports */
+        s_fifo_getoff = tgt;
+        if (!gcm_get_eq_put()) vm_write32(GCM_CONTROL_GUEST_ADDR + 4, tgt);
+    }
+    ReleaseSRWLockExclusive(&s_gcm_fifo_lock);
+}
+
+/* The guest's store to the control register's put word (vm_write32 in ppu_loader.cpp calls it). */
+void cellGcm_on_put_store(u32 put) { gcm_take_jumps_at_get(put & 0x1FFFFFFCu); }
+
 static void gcm_rsx_process_fifo_unlocked(void)
