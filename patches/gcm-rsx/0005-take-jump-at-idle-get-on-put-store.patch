+    "${PROJECT_SOURCE_DIR}/runtime/host/host_stubs.c"
+)
+target_link_libraries(test_gcm_put_jump PRIVATE ps3recomp_runtime)
+if(NOT WIN32)
+    target_link_libraries(test_gcm_put_jump PRIVATE m)
+endif()
