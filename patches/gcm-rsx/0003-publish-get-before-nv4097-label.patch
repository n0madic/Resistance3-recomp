cellGcmSys: publish `get` before an NV4097 semaphore release, as for NV406E RELEASE.

The pin's cellGcmSys (#401) publishes `get` past an NV406E SEMAPHORE_RELEASE before its label lands. The NV4097 back-end
write (0x1D70) and texture-read (0x1D74) releases write their label inside rsx_process_method and still left `get` at
the start of the pass. Resistance 3 waits on a label, snapshots `get` and spins until `put` equals it: with `get`
still inside a command buffer the pass had called into, the snapshot never matched and its level start hung.

test_gcm_get_on_release now also drives one of each NV4097 release through the walker, with and without
GCM_GET_EQ_PUT (the stub method handler records `get` when it is handed the method).

Upstream: not proposed yet (a candidate: #401 covers NV406E only).

---

diff --git a/libs/video/cellGcmSys.c b/libs/video/cellGcmSys.c
index efad9b9..3823d87 100644
--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -2289,2 +2289,7 @@ static void gcm_rsx_process_fifo_unlocked(void)
                 } else if (subch == 0 || (subch == 1 && !s1_2d)) {
+                    /* NV4097 back-end write / texture-read semaphore release: the label lands inside
+                     * rsx_process_method, so publish `get` past the command first, as for NV406E
+                     * RELEASE above. */
+                    if (subch == 0 && (m == 0x1D70u || m == 0x1D74u) && !gcm_get_eq_put())
+                        vm_write32(GCM_CONTROL_GUEST_ADDR + 4, s_fifo_getoff + 4 + count * 4);
                     rsx_process_method(&s_state, m, vm_read32(dea));
diff --git a/libs/video/tests/test_gcm_get_on_release.c b/libs/video/tests/test_gcm_get_on_release.c
index 2f79ae7..5d712be 100644
--- a/libs/video/tests/test_gcm_get_on_release.c
+++ b/libs/video/tests/test_gcm_get_on_release.c
@@ -45,3 +45,12 @@ void ppu_dump_guest_stack(ppu_context* c, const char* why) { (void)c; (void)why;
 void rsx_state_init(rsx_state* state) { (void)state; }
-int  rsx_process_method(rsx_state* state, u32 method, u32 data) { (void)state; (void)method; (void)data; return 0; }
+/* NV4097 back-end write / texture-read semaphore releases write their label inside rsx_process_method;
+ * record where get is when the walker hands one over. */
+static u32 sema4097_get[2], sema4097_n;
+int  rsx_process_method(rsx_state* state, u32 method, u32 data)
+{
+    (void)state; (void)data;
+    if ((method == 0x1D70u || method == 0x1D74u) && sema4097_n < 2)
+        sema4097_get[sema4097_n++] = vm_read32(GCM_CONTROL_GUEST_ADDR + 4);
+    return 0;
+}
 int  rsx_draw_engine_enabled(void) { return 0; }
@@ -136,2 +145,8 @@ int main(int argc, char** argv)
     io = put_probe(io, 3);
+    /* NV4097 back-end write release, then texture-read release. */
+    const u32 be_val = 0x33u, tex_val = 0x44u;
+    io = put_cmd(io, 0, 0x1D70u, 1, &be_val);
+    const u32 end_be = io;
+    io = put_cmd(io, 0, 0x1D74u, 1, &tex_val);
+    const u32 end_tex = io;
     const u32 put = io;
@@ -155,2 +170,9 @@ int main(int argc, char** argv)
     }
+    check(sema4097_n == 2, "the NV4097 semaphore releases reached the method handler");
+    if (!eq_put) {
+        check(sema4097_get[0] == end_be, "get is past an NV4097 back-end write release before its label");
+        check(sema4097_get[1] == end_tex, "get is past an NV4097 texture-read release before its label");
+    } else {
+        check(sema4097_get[0] == 0 && sema4097_get[1] == 0, "GCM_GET_EQ_PUT: an NV4097 release publishes nothing mid-pass");
+    }
     check(vm_read32(ctrl + 4) == put, "after the pass, get is put");
