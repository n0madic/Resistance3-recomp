diff --git a/tools/test_rsx_tiling.py b/tools/test_rsx_tiling.py
new file mode 100644
index 0000000..f6ab920
--- /dev/null
+++ b/tools/test_rsx_tiling.py
@@ -0,0 +1,18 @@
+#!/usr/bin/env python3
+"""RSX tiled main memory addressing (libs/video/tests/test_rsx_tiling.c, rsx_tiling.h)."""
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[1]
+with tempfile.TemporaryDirectory(prefix='rsx-tiling-') as tmp:
+    binary = Path(tmp) / ('test.exe' if os.name == 'nt' else 'test')
+    subprocess.run([os.environ.get('CC', 'cc'), '-std=gnu17', '-O1', '-UNDEBUG',
+                    '-I' + str(root / 'include'), '-I' + str(root / 'libs/video'),
+                    str(root / 'libs/video/tests/test_rsx_tiling.c'), '-o', str(binary)], check=True)
+    result = subprocess.run([str(binary)], timeout=30, capture_output=True, text=True)
+    print(result.stdout.strip())
+    if result.returncode:
+        print(result.stderr[-2000:])
+        raise SystemExit('test_rsx_tiling failed')
