+    static u8* rows;
+    static u32 cap;
+    if (cap < bytes) {
+        u8* n = (u8*)realloc(rows, bytes);
+        if (!n) return NULL;
+        rows = n;
+        cap = bytes;
+    }
+    return rows;
+}
