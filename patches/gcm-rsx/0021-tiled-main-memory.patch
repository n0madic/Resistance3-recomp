+    rsx_draw_engine_guest_read(RSX_LOCATION_MAIN, row5, 1024u, 16u, 1u);
+    CHECK(vm_base[row5] == 0x44 && vm_base[row5 + 63] == 0x33, "an unbound tile is stored linearly");
+    rsx_draw_engine_set_tile(1, 0, 0, 0, 0, 0);
+    engine_down();
+}
