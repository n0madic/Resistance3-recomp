diff --git a/libs/video/rsx_tiling.c b/libs/video/rsx_tiling.c
new file mode 100644
index 0000000..686c3ab
--- /dev/null
+++ b/libs/video/rsx_tiling.c
@@ -0,0 +1,177 @@
+/*
+ * RSX tiled main memory: the bound tiles and the range copies every RSX
+ * client goes through (rsx_tiling.h).
+ */
+#include "rsx_tiling.h"
+#include "rsx_dispatch.h"                     /* RSX_LOCATION_MAIN */
+#include "../../runtime/platform/win32_compat.h"
+#include "ps3emu/log_first.h"
+#include <stdio.h>
+#include <string.h>
+
+/* The ranges below ask `ptr` for at most one IO page at a time: main memory
+ * is IO-mapped in 1 MB pages, and each page is contiguous in guest memory. */
+#define RSX_TILING_PAGE 0x100000u
+
+/* Written from the PPU thread (cellGcmSetTile), read by the FIFO walker and
+ * the draw engine. s_rsx_tiles_bound has a bit per bound tile, so a client checks it
+ * without the lock while nothing is bound. */
+static rsx_tile s_rsx_tiles[RSX_TILE_COUNT];
+static SRWLOCK s_rsx_tiles_lock = SRWLOCK_INIT;
+static volatile LONG s_rsx_tiles_bound;
+
+void rsx_tiling_set(u32 index, u32 location, u32 offset, u32 size, u32 pitch, u32 bank)
+{
+    if (index >= RSX_TILE_COUNT) return;
+    rsx_tile t = { 0, 0, 0, 0 };
+    if (location == RSX_LOCATION_MAIN && size && pitch) {
+        t.offset = offset; t.size = size; t.pitch = pitch; t.bank = bank & 3u;
+    }
+    AcquireSRWLockExclusive(&s_rsx_tiles_lock);
+    s_rsx_tiles[index] = t;
+    const LONG bit = (LONG)(1u << index);
+    InterlockedExchange(&s_rsx_tiles_bound, t.size ? (s_rsx_tiles_bound | bit) : (s_rsx_tiles_bound & ~bit));
+    ReleaseSRWLockExclusive(&s_rsx_tiles_lock);
+}
+
+int rsx_tiling_active(void)
+{
+    return s_rsx_tiles_bound != 0;
+}
+
+int rsx_tiling_find(u32 location, u32 offset, u32 len, rsx_tile* out)
+{
+    if (location != RSX_LOCATION_MAIN || !len || !s_rsx_tiles_bound) return 0;
+    const u64 end = (u64)offset + len;
+    int found = 0;
+    AcquireSRWLockShared(&s_rsx_tiles_lock);
+    for (u32 i = 0; i < RSX_TILE_COUNT; i++) {
+        const rsx_tile* t = &s_rsx_tiles[i];
+        if (!t->size || t->offset >= end || (u64)t->offset + t->size <= offset) continue;
+        if (!found || t->offset < out->offset) { *out = *t; found = 1; }
+    }
+    ReleaseSRWLockShared(&s_rsx_tiles_lock);
+    return found;
+}
+
+int rsx_tiling_footprint(u32 location, u32 offset, u32 len, u32* lo, u32* span)
+{
+    const u64 end = (u64)offset + len;
+    u64 l = offset, h = end, pos = offset;
+    int any = 0;
+    rsx_tile t;
+    while (pos < end && rsx_tiling_find(location, (u32)pos, (u32)(end - pos), &t)) {
+        const u64 t_end = (u64)t.offset + t.size;
+        const u64 band = 64ull * t.pitch;
+        const u64 a = pos > t.offset ? pos : t.offset;
+        const u64 b = end < t_end ? end : t_end;
+        /* a 64-row band of tiles is stored over the 16 KB tiles' own span,
+         * each tile in one of the four banks of its 64 KB group */
+        u64 fl = t.offset + (a - t.offset) / band * band;
+        u64 fh = t.offset + (b - t.offset + band - 1u) / band * band;
+        fl &= ~0xFFFFull;
+        fh = (fh + 0xFFFFu) & ~0xFFFFull;
+        if (fl < t.offset) fl = t.offset;
+        if (fh > t_end) fh = t_end;
+        if (fl < l) l = fl;
+        if (fh > h) h = fh;
+        any = 1;
+        pos = t_end;
+    }
+    *lo = (u32)l;
+    *span = h - l > 0xFFFFFFFFull ? 0xFFFFFFFFu : (u32)(h - l);
+    return any;
+}
+
+static void rsx_tiling_put(const rsx_tiled_mem* mem, u8* dst, const u8* src, u32 n)
+{
+    if (mem->store) mem->store(mem->user, dst, src, n);
+    else            memcpy(dst, src, n);
+}
+
+/* [pos, stop) as the bytes lie, an IO page at a time. */
+static int rsx_tiling_linear(const rsx_tiled_mem* mem, u32 location, u64 pos, u64 stop,
+                             u8* linear, int write)
+{
+    int all = 1;
+    while (pos < stop) {
+        const u64 page_end = (pos & ~(u64)(RSX_TILING_PAGE - 1u)) + RSX_TILING_PAGE;
+        const u32 n = (u32)((stop < page_end ? stop : page_end) - pos);
+        u8* p = mem->ptr(mem->user, location, (u32)pos, n);
+        if (!p)         { if (!write) memset(linear, 0, n); all = 0; }
+        else if (write) rsx_tiling_put(mem, p, linear, n);
+        else            memcpy(linear, p, n);
+        pos += n; linear += n;
+    }
+    return all;
+}
+
+/* [pos, stop) inside tile t, 32 bytes at a time through its tiling. The host
+ * bytes of the IO page the last run landed in are kept for the next. */
+static int rsx_tiling_tiled(const rsx_tiled_mem* mem, u32 location, const rsx_tile* t,
+                            u64 pos, u64 stop, u8* linear, int write)
+{
+    if (rsx_tile_address(t, t->offset) == RSX_TILE_NO_ADDRESS) {
+        static u32 logs;
+        if (PS3_LOG_FIRST(logs, 4))
+            fprintf(stderr, "[rsx tiling] tile 0x%X+0x%X pitch %u has no tiling; read as linear\n",
+                    t->offset, t->size, t->pitch);
+        return rsx_tiling_linear(mem, location, pos, stop, linear, write);
+    }
+    const u64 t_end = (u64)t->offset + t->size;
+    u64 page = ~0ull, page_lo = 0;
+    u8* host = NULL;
+    int all = 1;
+    while (pos < stop) {
+        const u32 run = (u32)(32u - (pos & 31u) < stop - pos ? 32u - (pos & 31u) : stop - pos);
+        const u32 a = rsx_tile_address(t, (u32)pos);
+        if (a != RSX_TILE_NO_ADDRESS && (a & ~(RSX_TILING_PAGE - 1u)) != page) {
+            page = a & ~(RSX_TILING_PAGE - 1u);
+            page_lo = page > t->offset ? page : t->offset;
+            const u64 page_hi = page + RSX_TILING_PAGE < t_end ? page + RSX_TILING_PAGE : t_end;
+            host = mem->ptr(mem->user, location, (u32)page_lo, (u32)(page_hi - page_lo));
+        }
+        u8* p = (a != RSX_TILE_NO_ADDRESS && host) ? host + (a - page_lo) : NULL;
+        if (!p)         { if (!write) memset(linear, 0, run); all = 0; }
+        else if (write) rsx_tiling_put(mem, p, linear, run);
+        else            memcpy(linear, p, run);
+        pos += run; linear += run;
+    }
+    return all;
+}
+
+static int rsx_tiling_copy(const rsx_tiled_mem* mem, u32 location, u32 offset, u8* linear, u32 len,
+                           int write)
+{
+    const u64 end = (u64)offset + len;
+    u64 pos = offset;
+    int all = 1;
+    while (pos < end) {
+        rsx_tile t;
+        if (!rsx_tiling_find(location, (u32)pos, (u32)(end - pos), &t)) {
+            all &= rsx_tiling_linear(mem, location, pos, end, linear, write);
+            break;
+        }
+        if (t.offset > pos) {
+            all &= rsx_tiling_linear(mem, location, pos, t.offset, linear, write);
+            linear += t.offset - pos;
+            pos = t.offset;
+        }
+        const u64 t_end = (u64)t.offset + t.size;
+        const u64 stop = end < t_end ? end : t_end;
+        all &= rsx_tiling_tiled(mem, location, &t, pos, stop, linear, write);
+        linear += stop - pos;
+        pos = stop;
+    }
+    return all;
+}
+
+int rsx_tiled_read(const rsx_tiled_mem* mem, u32 location, u32 offset, void* dst, u32 len)
+{
+    return rsx_tiling_copy(mem, location, offset, (u8*)dst, len, 0);
+}
+
+int rsx_tiled_write(const rsx_tiled_mem* mem, u32 location, u32 offset, const void* src, u32 len)
+{
+    return rsx_tiling_copy(mem, location, offset, (u8*)src, len, 1);
+}
diff --git a/libs/video/rsx_tiling.h b/libs/video/rsx_tiling.h
new file mode 100644
index 0000000..31e4ae8
--- /dev/null
+++ b/libs/video/rsx_tiling.h
@@ -0,0 +1,138 @@
+/*
+ * RSX tiled main memory.
+ *
+ * A tile bound over main memory (cellGcmSetTile with location MAIN) lays the
+ * RSX's view of that memory out in 256-byte x 64-row tiles, with banks and
+ * partitions interleaved. Every RSX client sees memory through that mapping:
+ * render targets, textures, the 2D engines (NV3089, NV309E, NV308A), NV0039
+ * buffer copies, vertex, index and program fetches. The PPU and the SPUs see
+ * the bytes where they lie. Local memory tiles are transparent to every
+ * client and need nothing. Resistance 3 downsamples its scene into tiled main
+ * memory with NV3089 for an SPU depth-of-field job while aiming; the job reads
+ * and writes the tiled layout, and sampled linearly its output showed as
+ * bands (rows 0-15 of every 64).
+ *
+ * The address math is a port of RPCS3's rsx::tiled_dma_copy
+ * (https://github.com/RPCS3/rpcs3/blob/06ae1af55161e8a9e8ad77395a97455d493b5cb3/rpcs3/Emu/RSX/Common/tiled_dma_copy.hpp),
+ * itself from envytools' NV40 VRAM notes
+ * (https://envytools.readthedocs.io/en/latest/hw/memory/vram.html).
+ * RPCS3 takes the tile's effective address as the base; the location offset
+ * used here differs from it only above bit 19 (IO pages are 1 MB), and those
+ * bits cancel in the result. RPCS3 goes through the tiling for NV3089
+ * destinations and texture reads only; the tile table and the range copies
+ * below (rsx_tiling.c) let every client do it.
+ */
+#ifndef RSX_TILING_H
+#define RSX_TILING_H
+
+#include "ps3emu/ps3types.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define RSX_TILE_COUNT 15u
+#define RSX_TILE_NO_ADDRESS 0xFFFFFFFFu
+
+typedef struct rsx_tile {
+    u32 offset;   /* location offset of the tile's first byte */
+    u32 size;
+    u32 pitch;
+    u32 bank;
+} rsx_tile;
+
+/* Where the RSX keeps the byte at linear location offset `lin` of tile `t`:
+ * a location offset, or RSX_TILE_NO_ADDRESS when it falls outside the tile.
+ * Bits 0-4 carry over, so 32 aligned linear bytes stay together. */
+static inline u32 rsx_tile_address(const rsx_tile* t, u32 lin)
+{
+    static const u32 bank_lut[16] = { 0, 1, 2, 3, 2, 3, 0, 1, 1, 2, 3, 0, 3, 0, 1, 2 };
+    const u32 base = t->offset;
+    /* tiles per row: pitch / 256 = prime * factor, prime the odd part */
+    u32 factor = t->pitch >> 8;
+    if (t->pitch & (t->pitch - 1u)) {
+        static const u32 primes[5] = { 3, 5, 7, 11, 13 };
+        u32 k = 0;
+        while (k < 5u && factor % primes[k]) k++;
+        if (k == 5u) return RSX_TILE_NO_ADDRESS;
+        factor /= primes[k];
+    }
+    const u32 per_row = t->pitch >> 8;
+    if (!per_row || lin < base) return RSX_TILE_NO_ADDRESS;
+
+    const u32 texel = (lin - base) / 256u;
+    const u32 tile_x = texel % per_row;
+    const u32 tile_y = (texel / per_row) / 64u;
+    const u32 tile_id = tile_y * per_row + tile_x;
+    const u32 sel = (tile_id + (base >> 14)) & 0x3ffffu;
+    const u32 row_address = (sel >> 2) & 0xffffu;
+
+    u32 bank = 0;
+    if (factor == 1u)      bank = sel & 3u;
+    else if (factor == 2u) bank = bank_lut[((sel + ((tile_y & 1u) << 1)) & 3u) * 4u + (tile_y & 3u)];
+    else if (factor >= 4u) bank = bank_lut[(sel & 3u) * 4u + (tile_y & 3u)];
+    bank = (bank + t->bank) & 3u;
+
+    const u32 line = (texel / per_row) % 64u;
+    u32 column = 0;
+    column |= ((line >> 3) & 7u) << 7;
+    column |= ((lin >> 5) & 7u) << 4;
+    column |= (line & 3u) << 2;
+    const u32 partition = (((line >> 2) & 1u) + ((lin >> 6) & 1u)) & 1u;
+
+    u32 a = (row_address << 16) | (bank << 14) | (((column >> 4) & 0x3fu) << 8) |
+            (partition << 7) | (((column >> 2) & 3u) << 5) | (lin & 0x1fu);
+    a ^= (((a >> 12) ^ ((bank ^ sel) & 1u) ^ (a >> 14)) & 1u) << 9;
+    a ^= ((a >> 11) & 1u) << 10;
+    return (a - base < t->size) ? a : RSX_TILE_NO_ADDRESS;
+}
+
+/* ---- the bound tiles (rsx_tiling.c) ----------------------------------------
+ * cellGcmSetTile / BindTile / UnbindTile publish here; any thread may look
+ * up. Only main-memory tiles are kept. */
+
+/* Tile `index` now covers [offset, offset + size) at `location`
+ * (RSX_LOCATION_*); a zero size or pitch, or a local location, unbinds it. */
+void rsx_tiling_set(u32 index, u32 location, u32 offset, u32 size, u32 pitch, u32 bank);
+
+/* Nonzero while any main-memory tile is bound: the one check a client pays
+ * when none is. */
+int rsx_tiling_active(void);
+
+/* The bound tile that overlaps [offset, offset + len) at `location` and
+ * starts lowest, copied to *out. 0 when none does. */
+int rsx_tiling_find(u32 location, u32 offset, u32 len, rsx_tile* out);
+
+/* The guest bytes [*lo, *lo + *span) the RSX's view of [offset, offset +
+ * len) is made of: the range itself, widened over each tile it touches to
+ * whole 64-row bands rounded out to the 64 KB bank groups the band's tiles
+ * are interleaved over. A change detector that hashes those bytes sees every
+ * write that changes what the RSX reads. Returns 0 (and the range itself)
+ * when no tile is touched. */
+int rsx_tiling_footprint(u32 location, u32 offset, u32 len, u32* lo, u32* span);
+
+/* How a client reaches guest memory. `ptr` returns the host bytes of
+ * [offset, offset + len) at `location`, or NULL; the range copies below ask
+ * for no more than one 1 MB IO page at a time, so a caller whose IO pages
+ * map scattered in host memory is still read right. `store`, when not NULL,
+ * replaces memcpy for every write (a client that must tell the SPUs their
+ * reservations were hit). */
+typedef struct rsx_tiled_mem {
+    u8* (*ptr)(void* user, u32 location, u32 offset, u32 len);
+    void (*store)(void* user, u8* dst, const u8* src, u32 len);
+    void* user;
+} rsx_tiled_mem;
+
+/* Copy [offset, offset + len) at `location` as the RSX sees it into `dst`,
+ * or `src` into it: through the tiling where a bound tile covers it, as the
+ * bytes lie elsewhere. The range may start before a tile, cross several and
+ * end past them. A read zero-fills what `ptr` cannot reach, a write skips
+ * it; both return 1 when every byte was reached. */
+int rsx_tiled_read(const rsx_tiled_mem* mem, u32 location, u32 offset, void* dst, u32 len);
+int rsx_tiled_write(const rsx_tiled_mem* mem, u32 location, u32 offset, const void* src, u32 len);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* RSX_TILING_H */
