cellGcmSys: NV0039 buffer copies go through the tiling when either side is in a tile bound over main memory.

Resistance 3 binds tile 4 over main memory (IO 0x30000, 0x580000 bytes, pitch 8192, bank 2); while aiming it
downsamples the scene into it for an SPU depth-of-field job that reads and writes the tiled layout. Upstream #569 (our
PR, in the pin since v0.19.0: rsx_tiling.h/.c, cellGcmSetTile binding, NV3089, NV309E, NV308A, the draw engine's
targets, textures and fetches, test_rsx_tiling and the tiled cases of test_rsx_draw_engine/test_nv3089_engine_read)
went upstream without NV0039, which upstream does not have (gcm-rsx/0004 adds it). This is what is left of the
port's version of #569: an NV0039 copy with either side in a main-memory tile goes a line at a time through
rsx_tiled_read / rsx_tiled_write (a write keeps gcm_store's reservation notify through #569's store hook); any other
copy stays the linear memmove.

In the game only the NV3089 and texture paths were seen reaching tile 4 (a logged run of the Haven street fight,
aiming); the NV0039 part keeps the copy that streams textures consistent with every other RSX client of the tile.

test_nv3089_engine_read: NV0039 lines out of and into a tile in main memory, every byte compared at its tiled
address; both checks fail without the change (2040 of 2048 bytes differ).

Upstream: the rest is upstream #569 (v0.19.0); this part goes with NV0039 (gcm-rsx/0004, not proposed yet).
---

diff --git a/libs/video/cellGcmSys.c b/libs/video/cellGcmSys.c
index 9c9d40cb..c9211341 100644
--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -1592,2 +1592,17 @@ static void nv0039_buffer_notify(void)
     }
+    /* Either side in tiled main memory: a line at a time through the tiling.
+     * Both spans are inside their 32-bit DMA windows here. */
+    const int in_local = s_nv0039.dma_in == 0xFEED0000u, out_local = s_nv0039.dma_out == 0xFEED0000u;
+    if (gcm_rect_tiled(in_local, s_nv0039.off_in, (u32)span_in, 1) ||
+        gcm_rect_tiled(out_local, s_nv0039.off_out, (u32)span_out, 1)) {
+        u8* line = gcm_rows(len);
+        if (!line) return;
+        for (u32 i = 0; i < lines; i++) {
+            rsx_tiled_read(&s_gcm_mem, in_local ? RSX_LOCATION_LOCAL : RSX_LOCATION_MAIN,
+                           s_nv0039.off_in + i * pin, line, len);
+            rsx_tiled_write(&s_gcm_mem, out_local ? RSX_LOCATION_LOCAL : RSX_LOCATION_MAIN,
+                            s_nv0039.off_out + i * pout, line, len);
+        }
+        return;
+    }
     if (pin == len && pout == len) memmove(dst, src, (size_t)len * lines);
diff --git a/libs/video/tests/test_nv3089_engine_read.c b/libs/video/tests/test_nv3089_engine_read.c
index 35daebb3..d3829f34 100644
--- a/libs/video/tests/test_nv3089_engine_read.c
+++ b/libs/video/tests/test_nv3089_engine_read.c
@@ -16,4 +16,4 @@
  * layout; written linearly, the job's output came back as bands. The tiled case checks every destination pixel at
- * its tiled address. A source there is read through it, by NV3089 and by NV309E's swizzled copy, and an NV308A inline
- * word into it lands at its tiled address.
+ * its tiled address. A source there is read through it, by NV3089 and by NV309E's swizzled copy, and NV0039 buffer
+ * copies and NV308A inline words go through it on either side.
  *
@@ -217,2 +217,37 @@ static void blit_tiled_source_case(const char* what, u32 out, u32 scale, int swi
 
+/* NV0039 lines between the tile and local memory, each way: every byte read and written through the tiling. */
+static void nv0039_tiled_case(const char* what, int into_tile)
+{
+    const u32 len = 256u, lines = 8u, tiled_pitch = s_tile.pitch, local_pitch = 384u;
+    const u32 tiled_off = TILE_IO + 3u * s_tile.pitch + 96u;
+    memset(vm_base + MAIN_EA, 0, 0x100000u);
+    memset(vm_base + LOCAL_BASE + DST_OFF, 0, local_pitch * lines);
+    for (u32 i = 0; i < lines; i++)
+        for (u32 b = 0; b < len; b++) {
+            const u8 v = (u8)(i * 37u + b * 5u + 1u);
+            if (into_tile) vm_base[LOCAL_BASE + DST_OFF + i * local_pitch + b] = v;
+            else           vm_base[main_ea(tiled_off + i * tiled_pitch + b)] = v;
+        }
+    memset(&s_nv0039, 0, sizeof s_nv0039);
+    s_nv0039.dma_in      = into_tile ? 0xFEED0000u : 0xFEED0001u;
+    s_nv0039.dma_out     = into_tile ? 0xFEED0001u : 0xFEED0000u;
+    s_nv0039.off_in      = into_tile ? DST_OFF : tiled_off;
+    s_nv0039.off_out     = into_tile ? tiled_off : DST_OFF;
+    s_nv0039.pitch_in    = into_tile ? local_pitch : tiled_pitch;
+    s_nv0039.pitch_out   = into_tile ? tiled_pitch : local_pitch;
+    s_nv0039.line_length = len;
+    s_nv0039.line_count  = lines;
+    s_config.localSize = 0x00400000u;                           /* the NV0039 window over local memory */
+    nv0039_buffer_notify();
+    s_config.localSize = 0;
+    u32 wrong = 0;
+    for (u32 i = 0; i < lines; i++)
+        for (u32 b = 0; b < len; b++)
+            wrong += vm_base[main_ea(tiled_off + i * tiled_pitch + b)] !=
+                     vm_base[LOCAL_BASE + DST_OFF + i * local_pitch + b];
+    const int ok = wrong == 0 && vm_base[LOCAL_BASE + DST_OFF] == 1u;
+    printf("[%s] %s: %u of %u bytes differ\n", ok ? "PASS" : "FAIL", what, wrong, len * lines);
+    fails += !ok;
+}
+
 /* An NV308A inline word into the tile lands at its tiled address. */
@@ -257,2 +292,4 @@ int main(void)
     blit_tiled_source_case("NV309E swizzled 2:1 copy out of a tile in main memory", 16, 2, 1);
+    nv0039_tiled_case("NV0039 lines out of a tile in main memory", 0);
+    nv0039_tiled_case("NV0039 lines into a tile in main memory", 1);
     inline_tiled_case();
