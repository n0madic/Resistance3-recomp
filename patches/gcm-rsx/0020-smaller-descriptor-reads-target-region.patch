--- a/libs/video/rsx_draw_engine.h
+++ b/libs/video/rsx_draw_engine.h
@@ -306,2 +306,10 @@ typedef struct rsx_draw_backend {
 
+    /* Optional. The top-left w x h of a colour target (w and h no larger than
