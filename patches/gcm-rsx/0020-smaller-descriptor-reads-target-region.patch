@@ -851,2 +854,3 @@ static u32 eng_surface_get(u32 location, u32 offset, u32 want_w, u32 want_h,
     if (s->feedback) { g.be->texture_release(g.be->user, s->feedback); s->feedback = 0; }
+    if (s->region) { g.be->texture_release(g.be->user, s->region); s->region = 0; }
     if (s->handle) g.be->color_target_release(g.be->user, s->handle);
@@ -1120,2 +1124,3 @@ void rsx_draw_engine_guest_wrote(u32 location, u32 offset, u32 pitch, u32 w, u32
     g.be->color_target_write(g.be->user, s->handle, x, y, w, h, rows, w * 4u);
+    g.surfaces[slot].region_serial = UINT64_MAX;   /* the region copy predates these rows */
 }
@@ -2777,2 +2782,33 @@ static void sink_draw_index(void* user, const rsx_dispatch* r, u32 first, u32 co
  * different conversion and must not silently sample stale guest bytes. */
+/* What a texture unit naming colour target `slot` reads: the target, or, when
+ * the unit's descriptor is smaller than it at the same pitch, a copy of the
+ * top-left rows and columns the descriptor covers. That memory is what the RSX
+ * reads; binding the whole target squeezed it into the descriptor's extent.
+ * Resistance 3 drops its scene from 704 to 640 rows when frames get slow: with
+ * the 704-row target kept for the 640-row clip, every 640-row read of it showed
+ * the last 64 rows squeezed in as a band across the bottom, and with the target
+ * recreated at 640 rows instead the frame the switch happens on copied a
+ * never-written target to the screen (a black frame at the onset of a heavy
+ * hit). The copy is kept until the target is drawn again or another size is
+ * asked for. */
+static u32 eng_surface_region(u32 slot, const rsx_dsp_texture* t)
+{
+    eng_surface* s = &g.surfaces[slot];
+    if (!g.be->color_region || t->cubemap || t->dimension == 3 || !t->pitch ||
+        t->pitch != s->pitch || t->width > s->w || t->height > s->h ||
+        (t->width == s->w && t->height == s->h))
+        return s->handle;
+    if (s->region && s->region_w == t->width && s->region_h == t->height &&
+        s->region_serial == s->color_serial)
+        return s->region;
+    const u32 copy = g.be->color_region(g.be->user, s->handle, t->width, t->height);
+    if (!copy) return s->handle;
+    if (s->region) g.be->texture_release(g.be->user, s->region);
+    s->region = copy;
+    s->region_w = t->width;
+    s->region_h = t->height;
+    s->region_serial = s->color_serial;
+    return copy;
+}
+
 static int eng_color_feedback_compatible(const eng_surface* s,
@@ -2925,7 +2961,7 @@ static u32 sink_bind_textures(const u32* target_slots, u32 n_targets,
         if (sampled >= 0) {
+            const u32 src = eng_surface_region((u32)sampled, &t);
             const u32 view = g.be->surface_view
-                ? g.be->surface_view(g.be->user, g.surfaces[sampled].handle,
-                                     t.remap & 0xFFFFu, t.format)
+                ? g.be->surface_view(g.be->user, src, t.remap & 0xFFFFu, t.format)
                 : 0;
-            textures[u] = view ? view : g.surfaces[sampled].handle;
+            textures[u] = view ? view : src;
             continue;
@@ -3862,2 +3898,3 @@ void rsx_draw_engine_shutdown(void)
         if (g.surfaces[i].feedback) g.be->texture_release(g.be->user, g.surfaces[i].feedback);
+        if (g.surfaces[i].region) g.be->texture_release(g.be->user, g.surfaces[i].region);
         if (g.surfaces[i].handle) g.be->color_target_release(g.be->user, g.surfaces[i].handle);
diff --git a/libs/video/rsx_draw_engine.h b/libs/video/rsx_draw_engine.h
