+    eng_mark_guest_newer(location, offset, (u64)offset + (u64)pitch * (h - 1u) + (u64)w * 4u, slot);
+    if (slot == ENG_INVALID) {
         if (eng_coherence_log())
@@ -1041,2 +1078,3 @@ static u32 eng_zdepth_get(u32 location, u32 offset, u32 rt_w, u32 rt_h)
     z->guest_dirty = 0;
+    z->guest_newer = 0;
     z->last_use = g.frames;
@@ -1626,2 +1664,3 @@ static void eng_zdepth_wrote(u32 slot, const rsx_dsp_surface* sf)
