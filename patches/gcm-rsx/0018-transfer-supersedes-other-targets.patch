+    m(M_ZETA_PITCH, 1024u);
+    m(M_COLOR_A_OFFSET, zeta);
+    m(M_COLOR_MASK, 0u);
+    m(M_DEPTH_TEST, 1u);
+    m(M_DEPTH_WRITE, 1u);
+    draw_triangle();
+    m(M_COLOR_MASK, 0x01010101u);
+    m(M_DEPTH_TEST, 0u);
+    m(M_DEPTH_WRITE, 0u);
+    m(M_COLOR_A_OFFSET, 0x90000u);
+    rsx_draw_engine_guest_wrote(RSX_LOCATION_LOCAL, zeta, 3840u, 960u, 4u);
+    bind_texture_unit(RSX_LOCATION_LOCAL, zeta);
+    before = stub.n_texture_create;
+    draw_triangle();
+    CHECK(stub.n_depth_readback == 0 && stub.n_texture_create == before + 1,
+          "a zeta written over reads guest memory (%d readbacks, %d uploads)",
+          stub.n_depth_readback, stub.n_texture_create - before);
     engine_down();
@@ -2557,2 +2619,3 @@ int main(void)
