+/* The guest bytes a colour target's rows cover; a swizzled target (its pitch register below a row) is packed. */
+static u64 eng_rows_span(u32 pitch, u32 w, u32 h, u32 bpp)
+{
+    if (!w || !h) return 0;
+    return pitch >= w * bpp ? (u64)pitch * (h - 1u) + (u64)w * bpp : (u64)w * h * bpp;
+}
+
+/* A 2D transfer wrote [offset, end) in guest memory: every target there it does not land in (another pitch, or
+ * not a format a transfer can update) now holds older pixels than the guest's bytes until it is drawn into again.
+ * Resistance 3, badly hurt, copies its frame with NV3089 to 0x01DA8800 at pitch 3840 and samples the copy; a
+ * 240x176 bloom target drawn there at pitch 960 and a shadow map's zeta kept outranking the copy, and the screen went
+ * black but for the stretched bloom. */
+static void eng_mark_guest_newer(u32 location, u32 offset, u64 end, u32 keep)
+{
+    for (u32 i = 0; i < g.n_surfaces; i++) {
+        eng_surface* s = &g.surfaces[i];
+        if (i == keep || !s->handle || s->location != location) continue;
+        const u32 bpp = eng_transfer_bpp(s->fmt) ? eng_transfer_bpp(s->fmt) : 4u;
+        if (s->offset < end && (u64)s->offset + eng_rows_span(s->pitch, s->w, s->h, bpp) > offset)
+            s->guest_newer = 1;
+    }
+    for (u32 i = 0; i < g.n_zdepths; i++) {
+        eng_zdepth* z = &g.zdepths[i];
+        if (!z->handle || !z->depth_serial || z->location != location) continue;
+        const u32 bpp = z->zfmt == 1u ? 2u : 4u;
+        const u64 span = z->swizzled ? (u64)z->used_w * z->used_h * bpp
+                                     : eng_rows_span(z->pitch, z->used_w, z->used_h, bpp);
+        if (z->offset < end && (u64)z->offset + span > offset) z->guest_newer = 1;
+    }
+}
