+/* A transfer that writes over a target at another pitch leaves its pixels older than guest memory: Resistance 3
+ * copies its frame with NV3089 over a bloom target and a shadow map's zeta drawn at the same address and samples
+ * the copy. Textures read the guest bytes until the target is drawn into again. */
+static void test_transfer_supersedes_other_targets(void)
+{
+    printf("-- transfer over a target at another pitch\n");
+    engine_up();
+    m(M_COLOR_A_PITCH, 1024u);                 /* 256 pixels of A8R8G8B8 */
+    draw_triangle();
+    const u32 surface = stub.bound_rt[0];
+    m(M_COLOR_A_OFFSET, 0x90000u);
+    bind_texture_unit(RSX_LOCATION_LOCAL, 0x40000u);
+    draw_triangle();
+    CHECK(stub.bound_tex[0] == surface, "a unit at the target's address samples it");
+
+    rsx_draw_engine_guest_wrote(RSX_LOCATION_LOCAL, 0x40000u + 2u * 1024u, 1024u, 4u, 4u);
+    draw_triangle();
+    CHECK(stub.bound_tex[0] == surface, "a transfer at its own pitch updates it and it is still sampled");
+
+    int before = stub.n_texture_create;
+    rsx_draw_engine_guest_wrote(RSX_LOCATION_LOCAL, 0x40000u, 3840u, 960u, 4u);
+    draw_triangle();
+    CHECK(stub.bound_tex[0] != surface && stub.n_texture_create == before + 1,
+          "after one at another pitch the unit reads guest memory (%d uploads)",
+          stub.n_texture_create - before);
+
+    u8* px = vm_base + GUEST_LOCAL_EA + 0x40000u + 1024u;
+    memset(px, 0x5A, 8);
+    rsx_draw_engine_guest_read(RSX_LOCATION_LOCAL, 0x40000u + 1024u, 1024u, 2u, 1u);
+    CHECK(px[0] == 0x5A && px[7] == 0x5A, "a later transfer does not write the old pixels back over it");
+
+    m(M_COLOR_A_OFFSET, 0x40000u);
+    draw_triangle();
+    m(M_COLOR_A_OFFSET, 0x90000u);
+    draw_triangle();
+    CHECK(stub.bound_tex[0] == surface, "drawn into again, the target is sampled again");
+
+    /* A depth target the transfer covers: the unit reads guest memory, nothing is read back from it. */
+    const u32 zeta = 0x00100000u;
+    m(M_CONTEXT_DMA_ZETA, DMA_LOCAL);
