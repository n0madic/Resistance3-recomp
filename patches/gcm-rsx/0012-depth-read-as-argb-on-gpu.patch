+/* depth_as_argb's pass. Its own library: it needs 64-bit integers, and a
+ * device that cannot build it loses only this path, not the helpers above.
+ * The 24-bit value is round(d * 0xFFFFFF) taken exactly, as the engine's
+ * double-precision store takes it: d = m * 2^-s with a 24-bit m, so
+ * d * 0xFFFFFF = (m * 2^24 - m) * 2^-s, rounded by adding half and shifting. */
+static const char* kEngDepthArgbMSL =
+"#include <metal_stdlib>\n"
+"using namespace metal;\n"
+"struct AOut { float4 pos [[position]]; };\n"
+"vertex AOut eng_depth_argb_vs(uint vid [[vertex_id]]) {\n"
+"    float2 p = float2((vid << 1) & 2, vid & 2);\n"
+"    AOut o; o.pos = float4(p * 2.0 - 1.0, 0.0, 1.0);\n"
+"    return o;\n"
+"}\n"
+"fragment float4 eng_depth_argb_fs(AOut i [[stage_in]],\n"
+"                                  depth2d<float> src [[texture(0)]]) {\n"
+"    const float d = src.read(uint2(i.pos.xy));\n"
+"    uint v = 0u;\n"
+"    if (d >= 1.0) {\n"
+"        v = 0xFFFFFFu;\n"
+"    } else if (d > 0.0) {\n"
+"        const uint b = as_type<uint>(d);\n"
+"        const uint e = (b >> 23) & 0xFFu;\n"
+"        const ulong m = (ulong)((b & 0x7FFFFFu) | (e ? 0x800000u : 0u));\n"
+"        const uint s = 150u - max(e, 1u);\n"
+"        if (s < 64u) v = (uint)(((m << 24) - m + (1ul << (s - 1u))) >> s);\n"
+"    }\n"
+"    return float4(float((v >> 8) & 0xFFu), float(v & 0xFFu), 0.0, float(v >> 16)) / 255.0;\n"
+"}\n";
+
 static u32 eng_obj_add(id<MTLTexture> t)
@@ -2682,2 +2714,4 @@ static void eng_shutdown(void* user)
     s_eng_depth_pso = nil;
+    s_eng_depth_argb_pso = nil;
+    s_eng_depth_argb_failed = 0;
     s_eng_point_sampler = nil;
@@ -2901,2 +2935,45 @@ static u32 eng_depth_snapshot(void* user, u32 depth, u32 w, u32 h)
 
+static u32 eng_depth_as_argb(void* user, u32 depth, u32 w, u32 h)
+{
+    (void)user;
+    id<MTLTexture> src = eng_obj(depth);
+    if (!src || !w || !h || w > [src width] || h > [src height] || s_eng_depth_argb_failed)
+        return 0;
+    if (s_eng_rec_count >= ENG_MAX_RECORDS) { s_eng_dropped++; return 0; }
+    if (!s_eng_depth_argb_pso) {
+        NSError* err = nil;
+        id<MTLLibrary> lib = [s_dev newLibraryWithSource:
+                                 [NSString stringWithUTF8String:kEngDepthArgbMSL]
+                                                 options:nil error:&err];
+        MTLRenderPipelineDescriptor* pd = [MTLRenderPipelineDescriptor new];
+        pd.vertexFunction   = [lib newFunctionWithName:@"eng_depth_argb_vs"];
+        pd.fragmentFunction = [lib newFunctionWithName:@"eng_depth_argb_fs"];
+        pd.colorAttachments[0].pixelFormat = MTLPixelFormatRGBA8Unorm;
+        if (lib) s_eng_depth_argb_pso = [s_dev newRenderPipelineStateWithDescriptor:pd error:&err];
+        if (!s_eng_depth_argb_pso) {
+            fprintf(stderr, "[rsx engine/metal] depth-as-argb pipeline failed: %s\n",
+                    [[err localizedDescription] UTF8String]);
+            s_eng_depth_argb_failed = 1;
+            return 0;
+        }
+    }
+    MTLTextureDescriptor* td =
+        [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm
+                                                           width:w height:h
+                                                       mipmapped:NO];
+    /* PixelFormatView: the unit samples it through surface_view's swizzle. */
+    td.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead |
+               MTLTextureUsagePixelFormatView;
+    td.storageMode = MTLStorageModePrivate;
+    const u32 dst = eng_obj_add([s_dev newTextureWithDescriptor:td]);
+    if (!dst) return 0;
+
+    EngRecord* r = &s_eng_rec[s_eng_rec_count++];
+    memset(r, 0, sizeof *r);
+    r->kind = ENG_REC_DEPTH_ARGB;
+    r->depth = depth;
+    r->resolve_dst = dst;
+    return dst;
+}
+
 /* ---- pipelines ----------------------------------------------------------- */
@@ -3393,2 +3470,20 @@ static void eng_encode_records(id<MTLCommandBuffer> cb, id<MTLBuffer> stage)
         }
+        if (s_eng_rec[i].kind == ENG_REC_DEPTH_ARGB) {
+            const EngRecord* r = &s_eng_rec[i++];
+            id<MTLTexture> src = eng_obj(r->depth);
+            id<MTLTexture> dst = eng_obj(r->resolve_dst);
+            if (!src || !dst || !s_eng_depth_argb_pso) { s_eng_encoding_failed = 1; continue; }
+            MTLRenderPassDescriptor* rp = [MTLRenderPassDescriptor renderPassDescriptor];
+            rp.colorAttachments[0].texture     = dst;
+            rp.colorAttachments[0].loadAction  = MTLLoadActionDontCare;
+            rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+            id<MTLRenderCommandEncoder> e = [cb renderCommandEncoderWithDescriptor:rp];
+            if (!e) { s_eng_encoding_failed = 1; continue; }
+            s_ft_resolves++;
+            [e setRenderPipelineState:s_eng_depth_argb_pso];
+            [e setFragmentTexture:src atIndex:0];
+            [e drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+            [e endEncoding];
+            continue;
+        }
         if (s_eng_rec[i].kind == ENG_REC_DEPTH_RESOLVE) {
@@ -3427,2 +3522,3 @@ static void eng_encode_records(id<MTLCommandBuffer> cb, id<MTLBuffer> stage)
                s_eng_rec[i].kind != ENG_REC_DEPTH_RESOLVE &&
+               s_eng_rec[i].kind != ENG_REC_DEPTH_ARGB &&
                s_eng_rec[i].kind != ENG_REC_COLOR_SNAPSHOT) {
@@ -3882,2 +3978,3 @@ static int eng_depth_readback(void* user, u32 depth, u32 x, u32 y, u32 w, u32 h,
     .color_snapshot       = eng_color_snapshot,
+    .depth_as_argb        = eng_depth_as_argb,
     .pipeline_create      = eng_pipeline_create,
diff --git a/libs/video/tests/test_metal_depth_as_argb.m b/libs/video/tests/test_metal_depth_as_argb.m
new file mode 100644
index 0000000..40df14b
--- /dev/null
+++ b/libs/video/tests/test_metal_depth_as_argb.m
@@ -0,0 +1,176 @@
+/* depth_as_argb against the store through guest memory: a depth target full of
+ * awkward depths (0, 1, the smallest normal and subnormal floats, values one
+ * ulp off a rounding tie, a spread of ordinary ones) converted on the GPU must
+ * hold, byte for byte, what depth_readback stored as Z24S8 and decoded gives,
+ * and its crossbar view must sample as the uploaded texture does. No window or
+ * original game data.
+ * clang -fobjc-arc -I include -I libs/video
+ * libs/video/tests/test_metal_depth_as_argb.m libs/video/rsx_texture_layout.c libs/video/rsx_shader_msl.cpp -lc++
+ * -Wl,-dead_strip -framework Metal -framework Cocoa -framework QuartzCore
+ * -o /tmp/test_metal_depth_as_argb */
+#include "../rsx_metal_backend.m"
+#include <math.h>
+#include <stdio.h>
+
+float cellAvconfExt_display_gamma(void) { return 1.0f; }
+
+static int failures, checks;
+#define CHECK(v, name) do { checks++; if (!(v)) { failures++; fprintf(stderr, "FAIL %s\n", name); } } while (0)
+#define W 64u
+#define H 32u
+static const char* fixture =
+"#include <metal_stdlib>\nusing namespace metal;\n"
+"struct V { float4 p [[position]]; };\n"
+"vertex V vs(uint i [[vertex_id]]) { float2 p[3] = {float2(-1,-1), float2(3,-1), float2(-1,3)}; return {float4(p[i], 0, 1)}; }\n"
+"struct D { float d [[depth(any)]]; };\n"
+"fragment D depth_fs(V v [[stage_in]], texture2d<float> t [[texture(0)]]) { return {t.read(uint2(v.p.xy)).r}; }\n"
+"fragment float4 copy_fs(V v [[stage_in]], texture2d<float> t [[texture(0)]]) { return t.read(uint2(v.p.xy)); }\n";
+
+static int complete(id<MTLCommandBuffer> cb) { [cb commit]; [cb waitUntilCompleted]; return cb.status == MTLCommandBufferStatusCompleted && !cb.error; }
+
+static id<MTLRenderPipelineState> pipeline(id<MTLLibrary> lib, const char* fn, MTLPixelFormat color)
+{
+    MTLRenderPipelineDescriptor* p = [MTLRenderPipelineDescriptor new];
+    p.vertexFunction = [lib newFunctionWithName:@"vs"];
+    p.fragmentFunction = [lib newFunctionWithName:[NSString stringWithUTF8String:fn]];
+    if (color == MTLPixelFormatInvalid) {
+        p.depthAttachmentPixelFormat = MTL_DEPTH_FORMAT;
+        p.stencilAttachmentPixelFormat = MTL_DEPTH_FORMAT;
+    } else {
+        p.colorAttachments[0].pixelFormat = color;
+    }
+    NSError* error = nil;
+    id<MTLRenderPipelineState> r = [s_dev newRenderPipelineStateWithDescriptor:p error:&error];
+    CHECK(r != nil, "fixture pipeline");
+    return r;
+}
+
+/* One full-screen pass of `pso` reading `src` into `dst` (colour) or `depth`. */
+static int pass(id<MTLRenderPipelineState> pso, id<MTLTexture> src, id<MTLTexture> dst, id<MTLTexture> depth)
+{
+    MTLRenderPassDescriptor* rp = [MTLRenderPassDescriptor renderPassDescriptor];
+    if (depth) {
+        rp.depthAttachment.texture = depth; rp.depthAttachment.loadAction = MTLLoadActionClear;
+        rp.depthAttachment.storeAction = MTLStoreActionStore;
+        rp.stencilAttachment.texture = depth; rp.stencilAttachment.loadAction = MTLLoadActionClear;
+        rp.stencilAttachment.storeAction = MTLStoreActionStore;
+    } else {
+        rp.colorAttachments[0].texture = dst; rp.colorAttachments[0].loadAction = MTLLoadActionDontCare;
+        rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+    }
+    id<MTLCommandBuffer> cb = [s_queue commandBuffer];
+    id<MTLRenderCommandEncoder> e = [cb renderCommandEncoderWithDescriptor:rp];
+    if (depth) {
+        MTLDepthStencilDescriptor* ds = [MTLDepthStencilDescriptor new];
+        ds.depthCompareFunction = MTLCompareFunctionAlways; ds.depthWriteEnabled = YES;
+        [e setDepthStencilState:[s_dev newDepthStencilStateWithDescriptor:ds]];
+    }
+    [e setRenderPipelineState:pso];
+    [e setFragmentTexture:src atIndex:0];
+    [e drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    [e endEncoding];
+    return complete(cb);
+}
+
+static id<MTLTexture> shared_texture(MTLPixelFormat f, MTLTextureUsage usage)
+{
+    MTLTextureDescriptor* td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:f width:W height:H mipmapped:NO];
+    td.usage = usage; td.storageMode = MTLStorageModeShared;
+    return [s_dev newTextureWithDescriptor:td];
+}
+
+static float bits(u32 b) { float f; memcpy(&f, &b, sizeof f); return f; }
+
+int main(void)
+{
+    @autoreleasepool {
+        s_dev = MTLCreateSystemDefaultDevice(); CHECK(s_dev != nil, "Metal device"); if (!s_dev) return 1;
+        s_queue = [s_dev newCommandQueue]; CHECK(eng_init(NULL, W, H) == 0, "backend helpers");
+        NSError* error = nil;
+        id<MTLLibrary> lib = [s_dev newLibraryWithSource:[NSString stringWithUTF8String:fixture] options:nil error:&error];
+        CHECK(lib != nil, "fixture shaders"); if (!lib) { fprintf(stderr, "%s\n", error.localizedDescription.UTF8String); return 1; }
+        CHECK(s_engine_backend.depth_as_argb == eng_depth_as_argb, "backend advertises depth_as_argb");
+
+        /* The depths: edge cases first, then a deterministic spread. */
+        float src[W * H];
+        const float edges[] = { 0.0f, 1.0f, bits(0x00800000u), bits(0x00000001u), bits(0x3F7FFFFFu),
+                                0.5f, 1.0f / 16777215.0f, 0.5f / 16777215.0f, bits(0x33000000u),
+                                bits(0x33000001u), 0.25f, 0.75f, 0.999999f, 1e-7f, 3e-8f };
+        u32 seed = 12345u;
+        for (u32 i = 0; i < W * H; i++) {
+            seed = seed * 1664525u + 1013904223u;
+            src[i] = i < sizeof edges / sizeof edges[0] ? edges[i]
+                   : (i & 1u) ? (float)(seed >> 8) / 16777216.0f
+                              : bits(0x30000000u + (seed >> 7) % 0x0F000000u);   /* down to 2^-31 */
+        }
+        /* Ties of the rounding: k + 0.5 over 0xFFFFFF, as near as a float gets. */
+        for (u32 i = 0; i < 64; i++) src[W * (H - 1) + i] = (float)((double)(i * 262139u + 7u) + 0.5) / 16777215.0f;
+        id<MTLTexture> values = shared_texture(MTLPixelFormatR32Float, MTLTextureUsageShaderRead);
+        [values replaceRegion:MTLRegionMake2D(0, 0, W, H) mipmapLevel:0 withBytes:src bytesPerRow:W * 4];
+
+        const u32 depth = eng_depth_target_create(NULL, W, H);
+        CHECK(depth && pass(pipeline(lib, "depth_fs", MTLPixelFormatInvalid), values, nil, eng_obj(depth)),
+              "depths written");
+
+        /* The store through guest memory: readback, Z24S8 as eng_zdepth_to_guest lays it out, decode. */
+        float back[W * H];
+        CHECK(s_engine_backend.depth_readback(NULL, depth, 0, 0, W, H, back, W * 4) == 0, "depth readback");
+        u8 packed[W * H * 4], want[W * H * 4];
+        for (u32 i = 0; i < W * H; i++) {
+            float d = back[i];
+            if (!(d > 0.0f)) d = 0.0f;
+            if (d > 1.0f) d = 1.0f;
+            const u32 v = (u32)((double)d * 16777215.0 + 0.5);
+            packed[4 * i] = (u8)(v >> 16); packed[4 * i + 1] = (u8)(v >> 8); packed[4 * i + 2] = (u8)v; packed[4 * i + 3] = 0;
+        }
+        rsx_tex_layout tl; rsx_texture_layout(0xA5, W, H, &tl);
+        rsx_texture_decode(want, W * 4, packed, W, H, &tl, 0);
+
+        /* The GPU conversion, read back through a copy. */
+        const u32 argb = eng_depth_as_argb(NULL, depth, W, H);
+        CHECK(argb != 0, "depth_as_argb made a texture");
+        CHECK(eng_depth_as_argb(NULL, depth, W + 1, H) == 0, "a texture wider than the depth target is refused");
+        eng_submit_and_wait(NULL, 0);
+        id<MTLTexture> got_tex = shared_texture(MTLPixelFormatRGBA8Unorm, MTLTextureUsageShaderRead);
+        id<MTLCommandBuffer> cb = [s_queue commandBuffer];
+        id<MTLBlitCommandEncoder> b = [cb blitCommandEncoder];
+        [b copyFromTexture:eng_obj(argb) sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0)
+                sourceSize:MTLSizeMake(W, H, 1) toTexture:got_tex destinationSlice:0 destinationLevel:0
+         destinationOrigin:MTLOriginMake(0, 0, 0)];
+        [b endEncoding];
+        CHECK(complete(cb), "copy of the converted texture");
+        u8 got[W * H * 4];
+        [got_tex getBytes:got bytesPerRow:W * 4 fromRegion:MTLRegionMake2D(0, 0, W, H) mipmapLevel:0];
+        u32 bad = 0;
+        for (u32 i = 0; i < W * H; i++)
+            if (memcmp(got + 4 * i, want + 4 * i, 4)) {
+                if (bad++ < 4)
+                    fprintf(stderr, "  texel %u depth %a: got %02X %02X %02X %02X want %02X %02X %02X %02X\n", i,
+                            back[i], got[4 * i], got[4 * i + 1], got[4 * i + 2], got[4 * i + 3],
+                            want[4 * i], want[4 * i + 1], want[4 * i + 2], want[4 * i + 3]);
+            }
+        CHECK(bad == 0, "every texel is the decode of the Z24S8 bytes");
+
+        /* Through the crossbar a title reads depth bytes with: the view samples as the upload does. */
+        const u32 view = eng_surface_view(NULL, argb, 0xAA93, 0xE5);
+        const u32 upload = eng_texture_create(NULL, RSX_BE_FMT_R8G8B8A8, W, H, 1, 1, 0xAA93, 0xE5);
+        eng_texture_upload(NULL, upload, 0, 0, W, H, want, W * 4, H);
+        id<MTLRenderPipelineState> copy = pipeline(lib, "copy_fs", MTLPixelFormatRGBA32Float);
+        id<MTLTexture> a = shared_texture(MTLPixelFormatRGBA32Float, MTLTextureUsageRenderTarget);
+        id<MTLTexture> c = shared_texture(MTLPixelFormatRGBA32Float, MTLTextureUsageRenderTarget);
+        CHECK(view && upload && pass(copy, eng_obj(view), a, nil) && pass(copy, eng_obj(upload), c, nil),
+              "both sampled through 0xAA93");
+        static float fa[W * H * 4], fc[W * H * 4];
+        [a getBytes:fa bytesPerRow:W * 16 fromRegion:MTLRegionMake2D(0, 0, W, H) mipmapLevel:0];
+        [c getBytes:fc bytesPerRow:W * 16 fromRegion:MTLRegionMake2D(0, 0, W, H) mipmapLevel:0];
+        CHECK(!memcmp(fa, fc, sizeof fa), "the view samples as the uploaded texture");
+
+        eng_obj_release(NULL, upload); eng_obj_release(NULL, argb); eng_obj_release(NULL, depth);
+        eng_collect_retired_objects();
+        int ok = 1; for (u32 i = 0; i < s_eng_obj_count; i++) ok &= s_eng_obj[i] == nil;
+        CHECK(ok, "releasing the texture releases its view");
+        printf("%d checks, %d failures\n", checks, failures);
+        eng_shutdown(NULL);
+        return failures ? 1 : 0;
+    }
+}
diff --git a/libs/video/tests/test_rsx_draw_engine.c b/libs/video/tests/test_rsx_draw_engine.c
index ede81c8..d1bf387 100644
--- a/libs/video/tests/test_rsx_draw_engine.c
+++ b/libs/video/tests/test_rsx_draw_engine.c
@@ -1628,2 +1628,97 @@ static void test_depth_read_as_color(void)
 
+/* depth_as_argb: the zeta's bytes made on the GPU, no store to guest memory. */
+static int g_argb_calls, g_argb_fail;
+static u32 g_argb_w, g_argb_h;
+static u32 stub_depth_as_argb(void* u, u32 d, u32 w, u32 h)
+{
+    (void)u; (void)d;
+    g_argb_calls++;
+    g_argb_w = w; g_argb_h = h;
+    return g_argb_fail ? 0 : stub_handle();
+}
+
+/* A Z24S8 pass at ZETA_OFFSET (256 x 256, pitch 1024), then the zeta moved
+ * away (or, with `keep_zeta`, left bound with depth writes off) and the unit
+ * set to read it as a linear 4x4 A8R8G8B8 of `pitch`. */
+static void depth_pass_then_read_ex(u32 pitch, int keep_zeta)
+{
+    m(M_CONTEXT_DMA_ZETA, DMA_LOCAL);
+    m(M_SURFACE_FORMAT, 8u | (2u << 5));
+    m(M_ZETA_OFFSET, ZETA_OFFSET);
+    m(M_ZETA_PITCH, 256u * 4u);
+    m(M_COLOR_MASK, 0u);
+    m(M_DEPTH_TEST, 1u);
+    m(M_DEPTH_WRITE, 1u);
+    m(M_TEX_UNIT + 0x0C, 0u);                  /* the pass samples nothing */
+    draw_triangle();
+    if (!keep_zeta) m(M_ZETA_OFFSET, ZETA_OFFSET + 0x100000u);
+    m(M_COLOR_MASK, 0x01010101u);
+    m(M_DEPTH_TEST, 0u);
+    m(M_DEPTH_WRITE, 0u);
+    bind_texture_unit(RSX_LOCATION_LOCAL, ZETA_OFFSET);
+    m(0x1840 /* control3: pitch */, pitch);
+}
+
+static void depth_pass_then_read(u32 pitch) { depth_pass_then_read_ex(pitch, 0); }
+
+static void test_depth_read_as_argb_on_gpu(void)
+{
+    printf("-- zeta read as A8R8G8B8, converted by the backend\n");
+    engine_up();
+    rsx_draw_backend be = g_stub_backend;
+    be.depth_as_argb = stub_depth_as_argb;
+    rsx_draw_engine_set_backend(&be);
+    g_argb_calls = 0; g_argb_fail = 0;
+    u8* z = vm_base + GUEST_LOCAL_EA + ZETA_OFFSET;
+    memset(z, 0x5A, 16);
+
+    depth_pass_then_read(256u * 4u);
+    const int uploads = stub.n_texture_create;
+    draw_triangle();
+    const u32 first = stub.bound_tex[0];
+    CHECK(g_argb_calls == 1 && g_argb_w == 4 && g_argb_h == 4 && first,
+          "the backend made the 4x4 texture (%d calls, %ux%u)", g_argb_calls, g_argb_w, g_argb_h);
+    CHECK(stub.n_depth_readback == 0 && stub.n_texture_create == uploads && z[0] == 0x5A,
+          "nothing was read back, stored or uploaded (%d readbacks)", stub.n_depth_readback);
+
+    draw_triangle();
+    CHECK(g_argb_calls == 1 && stub.bound_tex[0] == first,
+          "no depth write since: the same texture (%d calls)", g_argb_calls);
+
+    depth_pass_then_read(256u * 4u);
+    draw_triangle();
+    CHECK(g_argb_calls == 2 && stub.bound_tex[0] != first && !stub.alive[first],
+          "a new depth write: a new texture, the old one released (%d calls)", g_argb_calls);
+
+    /* Another pitch is not the zeta's layout: guest memory as before. */
+    depth_pass_then_read(512u * 4u);
+    draw_triangle();
+    CHECK(g_argb_calls == 2 && stub.n_depth_readback == 1,
+          "a texture of another pitch goes through guest memory (%d calls, %d readbacks)",
+          g_argb_calls, stub.n_depth_readback);
+
+    /* The zeta still bound, depth writes off: converted all the same, and
+     * kept while no draw writes depth. */
+    depth_pass_then_read_ex(256u * 4u, 1);
+    draw_triangle();
+    const u32 bound = stub.bound_tex[0];
+    CHECK(g_argb_calls == 3 && stub.n_depth_readback == 1 && bound,
+          "the bound zeta is converted too, not read back (%d calls, %d readbacks)",
+          g_argb_calls, stub.n_depth_readback);
+    draw_triangle();
+    CHECK(g_argb_calls == 3 && stub.bound_tex[0] == bound,
+          "and reused while no draw wrote depth (%d calls)", g_argb_calls);
+
+    /* A backend that cannot: guest memory as before. */
+    g_argb_fail = 1;
+    depth_pass_then_read(256u * 4u);
+    draw_triangle();
+    CHECK(g_argb_calls == 4 && stub.n_depth_readback == 2 &&
+          stub.bound_tex[0] == stub.last_created_texture &&
+          z[0] == 0x80 && z[1] == 0x00 && z[2] == 0x00 && z[3] == 0x00,
+          "refused: depth 0.5 stored as Z24S8 and decoded (%d readbacks, %02X %02X %02X %02X)",
+          stub.n_depth_readback, z[0], z[1], z[2], z[3]);
+    engine_down();
+}
+
 static void test_color_read_as_float(void)
@@ -1870,2 +1965,3 @@ int main(void)
     test_depth_read_as_color();
+    test_depth_read_as_argb_on_gpu();
     test_color_read_as_float();
