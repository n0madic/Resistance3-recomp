+#!/usr/bin/env python3
+"""Builds and runs libs/video/tests/test_metal_frame_pacing.c (present pacing of the Metal backend)."""
+import os
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def main() -> int:
+    with tempfile.TemporaryDirectory(prefix='metal-pacing-') as tmp:
+        binary = Path(tmp) / 'test'
+        subprocess.run([os.environ.get('CC', 'cc'), '-std=gnu17', '-O1', '-I', str(ROOT / 'libs/video'),
+                        str(ROOT / 'libs/video/tests/test_metal_frame_pacing.c'), '-lm', '-o', str(binary)],
+                       check=True, timeout=60)
+        return subprocess.run([str(binary)], timeout=10).returncode
+
+
+if __name__ == '__main__':
+    sys.exit(main())
