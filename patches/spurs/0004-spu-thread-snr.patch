SPURS: deliver sys_spu_thread_write_snr to the SPU threads of a SPURS instance.

cellSpursGetInfo now reports pseudo ids for spuThreadGroup/spuThreads[]; a signal written to one reaches the resident policy
contexts of that SPU (or waits for the first one). Resistance 3 wakes its own policy module (igPm) this way.

Upstream: not proposed yet.

---

diff --git a/libs/spurs/cellSpurs.c b/libs/spurs/cellSpurs.c
index ea144d0..4ebea4a 100644
--- a/libs/spurs/cellSpurs.c
+++ b/libs/spurs/cellSpurs.c
@@ -464,2 +464,6 @@ static void spurs_scheduler_forget(u32 wid);
 
+/* Pseudo ids of a SPURS instance's SPU threads: instance index and SPU number under a tag byte. */
+#define SPURS_SPU_TID_BASE 0x70000000u
+#define SPURS_SPU_TID(inst, spu) (SPURS_SPU_TID_BASE | ((u32)(inst) << 4) | (u32)(spu))
+
 static struct SpursInst* spurs_inst_find(u32 ea)
@@ -3076,3 +3080,11 @@ s32 cellSpursGetInfo(u64 spurs_ea, u64 info_ea)
         vm_write32((u32)info_ea, si ? si->nspus : 1);   /* nSpus */
-        for (int o = 4; o < 0x28; o += 4) vm_write32((u32)info_ea + o, 0);
+        for (int o = 4; o < 0x48; o += 4) vm_write32((u32)info_ea + o, 0);
+        /* spuThreadGroup (0x24) and spuThreads[8] (0x28): ids the game passes to sys_spu_thread_write_snr to wake the
+         * policy module of its own workload. They are pseudo ids that cellSpurs_post_snr resolves. */
+        if (si) {
+            u32 idx = (u32)(si - s_inst);
+            vm_write32((u32)info_ea + 0x24, SPURS_SPU_TID(idx, 0xF));
+            for (u32 n = 0; n < si->nspus && n < 8; n++)
+                vm_write32((u32)info_ea + 0x28 + 4 * n, SPURS_SPU_TID(idx, n));
+        }
     }
@@ -3081,2 +3093,13 @@ s32 cellSpursGetInfo(u64 spurs_ea, u64 info_ea)
 
+/* sys_spu_thread_write_snr on a pseudo SPU thread id of cellSpursGetInfo (see SPURS_SPU_TID). */
+int cellSpurs_post_snr(u32 tid, u32 num, u32 val)
+{
+    if ((tid & 0xFF000000u) != SPURS_SPU_TID_BASE) return -1;
+    u32 idx = (tid >> 4) & 0xF, n = tid & 0xF;
+    if (idx >= MAX_SPURS_INST) return -1;
+    u32 ea = __atomic_load_n(&s_inst[idx].ea, __ATOMIC_ACQUIRE);
+    if (!ea || n >= s_inst[idx].nspus) return -1;
+    return spurs_policy_post_snr(ea, n, num, val);
+}
+
 s32 cellSpursSetExceptionEventHandler(u64 spurs_ea, u64 handler_ea, u64 arg_ea)
diff --git a/runtime/spu/spu_workload.h b/runtime/spu/spu_workload.h
index f8a726e..2220555 100644
--- a/runtime/spu/spu_workload.h
+++ b/runtime/spu/spu_workload.h
@@ -73,2 +73,3 @@ void spurs_policy_release_instance(uint32_t spurs_ea);
 int spurs_policy_release_workload(uint32_t spurs_ea, uint32_t wid);
+int spurs_policy_post_snr(uint32_t spurs_ea, uint32_t spu_num, uint32_t num, uint32_t val);
 
diff --git a/runtime/spu/spurs_policy.c b/runtime/spu/spurs_policy.c
index 5d1c63d..d793211 100644
--- a/runtime/spu/spurs_policy.c
+++ b/runtime/spu/spurs_policy.c
@@ -52,2 +52,6 @@ static struct PmInstance {
     uint32_t ea;
+    /* SNR values posted by the PPU (sys_spu_thread_write_snr) that no resident context could take yet;
+     * applied when a context for that SPU is created. Guarded by s_pm_directory_lock. */
+    uint32_t snr_val[6][2];
+    uint8_t  snr_set[6][2];
     struct PmSlot slots[16][6];
@@ -85,2 +89,50 @@ static struct PmSlot* policy_slot(uint32_t ea, uint32_t wid, uint32_t lane)
 
+/* Post a signal-notification value from the PPU to a virtual SPU of a SPURS instance. Every resident policy
+ * context of that SPU takes it (a policy module that never reads SNR leaves it unread); with none yet, it waits in
+ * the instance and is applied to the first context created. Returns 0, or -1 for an unknown SPU or register. */
+int spurs_policy_post_snr(uint32_t ea, uint32_t spu_num, uint32_t num, uint32_t val)
+{
+    if (spu_num >= 6 || num > 1) return -1;
+    int rc = -1;
+    AcquireSRWLockExclusive(&s_pm_directory_lock);
+    struct PmInstance* pi = NULL;
+    for (unsigned i = 0; i < SPURS_PM_INSTANCES; i++)
+        if (s_pm_instances[i].used && s_pm_instances[i].ea == ea) { pi = &s_pm_instances[i]; break; }
+    if (!pi)
+        for (unsigned i = 0; i < SPURS_PM_INSTANCES; i++)
+            if (!s_pm_instances[i].used) { pi = &s_pm_instances[i]; pi->used = 1; pi->ea = ea; break; }
+    if (pi && !pi->retiring) {
+        unsigned delivered = 0;
+        /* The directory lock keeps a context from being freed under us; the channel has its own lock. */
+        for (unsigned w = 0; w < 16; w++) {
+            spu_context* ctx = pi->slots[w][spu_num].ctx;
+            if (!ctx) continue;
+            spu_channel_write(&ctx->ch_sig_notify[num], val);
+            spu_ch_wake(ctx);
+            delivered++;
+        }
+        if (!delivered) { pi->snr_val[spu_num][num] = val; pi->snr_set[spu_num][num] = 1; }
+        rc = 0;
+    }
+    ReleaseSRWLockExclusive(&s_pm_directory_lock);
+    return rc;
+}
+
+/* Make `ctx` the slot's resident context (NULL withdraws it while it is being reset); a context taking over gets the
+ * signals posted while there was none. Under the directory lock, so spurs_policy_post_snr sees either no context or
+ * an initialized one: a signal written into a context about to be zeroed would count as delivered and be lost. */
+static void policy_publish_ctx(struct PmSlot* slot, spu_context* ctx, uint32_t spu_num)
+{
+    AcquireSRWLockExclusive(&s_pm_directory_lock);
+    slot->ctx = ctx;
+    struct PmInstance* pi = slot->owner;
+    if (ctx && pi && spu_num < 6)
+        for (unsigned num = 0; num < 2; num++)
+            if (pi->snr_set[spu_num][num]) {
+                spu_channel_write(&ctx->ch_sig_notify[num], pi->snr_val[spu_num][num]);
+                pi->snr_set[spu_num][num] = 0;
+            }
+    ReleaseSRWLockExclusive(&s_pm_directory_lock);
+}
+
 static void policy_slot_release(struct PmSlot* slot)
@@ -200,3 +252,2 @@ int spu_run_policy_module(spu_lifted_entry_fn entry, int image_id,
         if (!ctx) { policy_slot_release(resident); return -1; }
-        resident->ctx = ctx;
         first = 1;
@@ -214,2 +265,3 @@ int spu_run_policy_module(spu_lifted_entry_fn entry, int image_id,
         spu_context_init(ctx, 0);
+        policy_publish_ctx(resident, ctx, spu_num);
     } else if (s_fresh || resident->data != wkl_data ||
@@ -226,2 +278,4 @@ int spu_run_policy_module(spu_lifted_entry_fn entry, int image_id,
         first = 1;
+        /* TODO: a reload on real hardware keeps the SPU's signal channels; this reset drops a signal still unread. */
+        policy_publish_ctx(resident, NULL, spu_num);
         spu_coh_unregister(ctx);
@@ -230,2 +284,3 @@ int spu_run_policy_module(spu_lifted_entry_fn entry, int image_id,
         spu_context_init(ctx, 0);
+        policy_publish_ctx(resident, ctx, spu_num);
     }
diff --git a/runtime/syscalls/lv2_register.c b/runtime/syscalls/lv2_register.c
index a45a555..803dcfb 100644
--- a/runtime/syscalls/lv2_register.c
+++ b/runtime/syscalls/lv2_register.c
@@ -2361,2 +2361,8 @@ static int64_t sys_spu_thread_write_snr_handler(ppu_context* ctx)
     if (!t) {
+        /* A SPU thread of a SPURS instance (ids from cellSpursGetInfo), which has no spu_thread_t of its own. */
+        extern int cellSpurs_post_snr(uint32_t tid, uint32_t num, uint32_t val) __attribute__((weak));
+        if (cellSpurs_post_snr && cellSpurs_post_snr(tid, num, val) == 0) {
+            ctx->gpr[3] = 0;
+            return 0;
+        }
         ctx->gpr[3] = (uint64_t)(int64_t)(int32_t)0x80010005;
