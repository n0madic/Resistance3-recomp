SPURS: reserve 256 MB of stack for the policy-module worker threads.

They run lifted SPU job code, whose brsl chains become deep host call chains. Resistance 3's first level load
overflowed the 1 MB stack inside an Insomniac job (igjob_00DC0200) and the host died with SIGBUS on the guard page.
spu_workload.c already reserves 256 MB for its async SPU thread for the same reason (the Bink decoder).

Upstream: not proposed yet.
---

diff --git a/libs/spurs/cellSpurs.c b/libs/spurs/cellSpurs.c
index 8ed13886..9eef9a0d 100644
--- a/libs/spurs/cellSpurs.c
+++ b/libs/spurs/cellSpurs.c
@@ -2151,2 +2151,10 @@ static s32 spurs_scheduler_start(struct SpursInst* si)
     memset(si->idle, 0, sizeof(si->idle));
+    /* The workers run lifted SPU job code, whose brsl chains are deep host call chains: Resistance 3's level load
+     * overflowed a 1 MB stack in an Insomniac job (igjob_00DC0200) and the host died with SIGBUS on the guard page.
+     * Reserve 256 MB like spu_workload.c's async SPU thread; it is committed only as it is touched. */
+#ifdef _WIN32
+    const DWORD pm_stack_flags = STACK_SIZE_PARAM_IS_A_RESERVATION;
+#else
+    const DWORD pm_stack_flags = 0;
+#endif
     for (u32 sn = 0; sn < si->nspus; sn++) {
@@ -2155,3 +2163,3 @@ static s32 spurs_scheduler_start(struct SpursInst* si)
         slot->instance = si; slot->spu_num = sn;
-        slot->thread = CreateThread(NULL, 1u << 20, spurs_pm_worker, slot, 0, NULL);
+        slot->thread = CreateThread(NULL, 256u << 20, spurs_pm_worker, slot, pm_stack_flags, NULL);
         if (!slot->thread) goto failed;
