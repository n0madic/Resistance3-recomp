cellSpurs: every taskset is a workload of its SPURS instance.

The HLE numbers tasksets in creation order and publishes each as a workload: the taskset EA in wklInfo1[wid].arg and the
workload's bit in wklEnabled (initialised to 0x8000FFFF, as the real initialiser leaves it); the SPU side reads the id
from the taskset. A lock-free queue push finds the task to signal through that table (host/spurs_lfqueue.cpp reads it),
and the real library's own entry points validate the instance against wklEnabled. Workload 0 follows the newest taskset,
which always holds the consumer just created.

Resistance 3 creates one taskset with an LFQueue consumer; without this its task parks in WAIT_SIGNAL and the boot never
leaves it (the SPU side logs "sleeping Ns in WAIT_SIGNAL" for task 0).

Upstream: not proposed.

---

diff --git a/libs/spurs/cellSpurs.c b/libs/spurs/cellSpurs.c
index 015913a..efa3043 100644
--- a/libs/spurs/cellSpurs.c
+++ b/libs/spurs/cellSpurs.c
@@ -454,2 +454,3 @@ static struct SpursInst {
     u32 cursor, pass_no;
+    u32 next_taskset_wid; /* workload id of the next taskset (SPU side reads it from the taskset) */
 } s_inst[MAX_SPURS_INST];
@@ -494,2 +495,24 @@ static DWORD WINAPI spurs_kernel_thread(LPVOID p);
 
+/* Every taskset the HLE creates is a workload of the instance, numbered in creation order.
+ * The SPU side reads the id from the taskset (CSTS_WID) and records it when a task parks on
+ * a queue; the real library finds the taskset of a workload in wklInfo1[wid].arg and checks
+ * the workload's bit in wklEnabled, e.g. when it signals a task waiting on a lock-free queue
+ * (_cellSpursLFQueuePushBody). So publish both, like cellSpursAddWorkload does. */
+static u32 spurs_register_taskset_workload(u32 spurs_ea, u32 taskset_ea)
+{
+    struct SpursInst* si = spurs_inst_find(spurs_ea);
+    u32 wid = si ? si->next_taskset_wid++ : 0;
+    if (wid >= CELL_SPURS_MAX_WORKLOAD) wid = CELL_SPURS_MAX_WORKLOAD - 1;
+    vm_write64(spurs_ea + SPURS_WKL_INFO1 + wid * SPURS_WKL_INFO_SZ + 0x08, taskset_ea);
+    vm_write32(spurs_ea + SPURS_WKL_ENABLED,
+               vm_read32(spurs_ea + SPURS_WKL_ENABLED) | (0x80000000u >> wid));
+    /* A push on a fresh lock-free queue signals (workload 0, task 0): the queue's waiting-consumer
+     * slot is still empty and names nothing else. The real kernel's workload 0 is whatever a title
+     * added first; this one is replaced by a taskset that is shut down and recreated at the same
+     * address, and the signal then reaches a taskset without task 0 and the push fails (SRCH).
+     * Keep workload 0 pointing at the newest taskset, which always has the consumer just created. */
+    if (wid) vm_write64(spurs_ea + SPURS_WKL_INFO1 + 0x08, taskset_ea);
+    return wid;
+}
+
 static s32 spurs_initialize_common(u32 spurs_ea, u32 nspus, const char* prefix)
@@ -517,2 +540,3 @@ static s32 spurs_initialize_common(u32 spurs_ea, u32 nspus, const char* prefix)
     si->nspus = (nspus > 0 && nspus <= CELL_SPURS_MAX_SPU) ? nspus : 1;
+    si->next_taskset_wid = 0;
     memset(si->prefix, 0, sizeof(si->prefix));
@@ -526,2 +550,7 @@ static s32 spurs_initialize_common(u32 spurs_ea, u32 nspus, const char* prefix)
     vm_write64(spurs_ea + SPURS_WKL_FLAG, 0xFFFFFFFFFFFFFFFFull); /* no receiver */
+    /* libsre's own entry points (e.g. _cellSpursLFQueueInitialize, taken from the real
+     * library when a port lifts it) validate the instance before touching it: the
+     * workload must be enabled in wklEnabled and wklEnabled starts at 0xffff as in the
+     * real initialiser. Bit 31 (workload 0) is the first workload a title creates. */
+    vm_write32(spurs_ea + SPURS_WKL_ENABLED, 0x8000FFFFu);
 
@@ -873,3 +902,4 @@ static s32 spurs_create_taskset(CellSpurs* spurs, CellSpursTaskset* taskset,
      * little-endian = garbage to the SPU). Overwrites 0x00-0x80 with BE fields. */
-    spurs_taskset_init(taskset_ea, spurs_ea, args, /*wid*/0,
+    const u32 taskset_wid = spurs_register_taskset_workload(spurs_ea, taskset_ea);
+    spurs_taskset_init(taskset_ea, spurs_ea, args, taskset_wid,
                        taskset_size, /*evf1*/0, /*evf2*/0);
