+                uint32_t* n = &ctx->resident_code[slot].n_holes;
+                uint32_t (*holes)[2] = ctx->resident_code[slot].holes;
+                uint32_t h = 0;
+                while (h < *n && !(lo <= holes[h][1] && hi >= holes[h][0])) ++h;   /* touching or overlapping */
+                if (h == *n && *n == SPU_RESIDENT_CODE_HOLES) h = *n - 1;           /* full: widen the last */
+                if (h == *n) { holes[h][0] = lo; holes[h][1] = hi; ++*n; }
