+    /* A span owns its LS addresses except where another DMA wrote since its
+     * load: there the bytes are not its, and the address resolves as if the
+     * span were not resident (a span loaded into it, then task, overlay and
+     * image), as all of it did when such a DMA dropped the whole span. */
     for (unsigned slot = 0; slot < SPU_RESIDENT_CODE_SLOTS; ++slot)
@@ -1731,2 +1742,3 @@ static spu_lifted_fn spu_lifted_lookup_full(const spu_context* ctx, uint32_t lsa
             lsa - ctx->resident_code[slot].lsa < ctx->resident_code[slot].size) {
+            if (spu_resident_hole(ctx, slot, lsa)) continue;
             /* A region registered with its code bytes owns its span even when
@@ -1953,4 +1965,14 @@ static int spu_overlay_resident_verified(spu_context* ctx, unsigned slot)
         int match = 1;
+        /* Byte runs between the holes: what another DMA overwrote is not code
