diff --git a/runtime/spu/tests/test_spu_lifted_start.c b/runtime/spu/tests/test_spu_lifted_start.c
index a04da3c4..594992f9 100644
--- a/runtime/spu/tests/test_spu_lifted_start.c
+++ b/runtime/spu/tests/test_spu_lifted_start.c
@@ -452,2 +452,72 @@ static void test_many_resident_code_regions(void)
 
+/* A DMA from elsewhere into a resident span (job data, a smaller module loaded
+ * into the bigger one's data area) takes over only the bytes it wrote: the rest
+ * of the span keeps dispatching its lift. Resistance 3's job modules at 0x100
+ * have their data and the dispatcher's module buffers inside their span; when
+ * any such DMA dropped the whole span, the module ran in the interpreter. */
+static void hole_big_a(spu_context* ctx) { ctx->gpr[3]._u32[0] = 101; }
+static void hole_big_b(spu_context* ctx) { ctx->gpr[3]._u32[0] = 102; }
+static void hole_small(spu_context* ctx) { ctx->gpr[3]._u32[0] = 103; }
+static void test_resident_code_holes(void)
+{
+    spu_context* ctx = (spu_context*)calloc(1, sizeof *ctx);
+    if (!ctx) { check(0, "allocate hole context"); return; }
+    spu_context_init(ctx, 0);
+    const uint32_t big = 0x30000, small = 0x34000;
+    spu_begin_image(101); spu_register_function(big + 0x100, hole_big_a); spu_register_function(big + 0x5000, hole_big_b);
+    spu_register_function(big + 0x300, hole_big_b);
+    spu_register_function(small, hole_big_a);
+    spu_begin_image(103); spu_register_function(small, hole_small);
+    spu_begin_image(0);
+    spu_overlay_register_region(0xB00000, 0x8000, 101);
+    uint8_t code[0x40];
+    for (unsigned i = 0; i < sizeof code; ++i) code[i] = (uint8_t)(0x90 + i);
+    const spu_overlay_code_segment seg = {small, sizeof code, code};
+    check(spu_overlay_register_verified_region(0xC00000, small, 0x400, 103, &seg, 1), "small module registers");
+    ctx->image_id = 100;
+    spu_overlay_note_get(ctx, 0xB00000, ctx->ls + big, 0x4000);
+    spu_overlay_note_get(ctx, 0xB04000, ctx->ls + big + 0x4000, 0x4000);
+    spu_overlay_note_get(ctx, 0x4AA00000, ctx->ls + big + 0x6000, 0x800);              /* job data */
+    check(spu_lifted_lookup(ctx, big + 0x100) == hole_big_a, "data DMA leaves the code below it resident");
+    check(spu_lifted_lookup(ctx, big + 0x5000) == hole_big_b, "and the code above it");
+    check(spu_lifted_lookup(ctx, big + 0x6100) == NULL, "the bytes it wrote are interpreted");
+    memcpy(ctx->ls + small, code, sizeof code);
+    spu_overlay_note_get(ctx, 0xC00000, ctx->ls + small, 0x400);                       /* a module in the data area */
+    check(spu_lifted_lookup(ctx, small) == hole_small, "a module loaded into the span dispatches its own lift");
+    check(spu_lifted_lookup(ctx, big + 0x100) == hole_big_a, "the big module stays resident around it");
+    for (int i = 0; i < 12; ++i)                                                       /* more holes than kept */
+        spu_overlay_note_get(ctx, 0x4AB00000u + 0x1000u * (uint32_t)i, ctx->ls + big + 0x200 + 0x100 * (uint32_t)i, 0x10);
+    check(spu_lifted_lookup(ctx, big + 0x100) == hole_big_a, "merged holes do not reach code before them");
+    check(spu_lifted_lookup(ctx, big + 0xD08) == NULL, "merged holes cover every write");
+    check(spu_lifted_lookup(ctx, big + 0x300) == NULL, "a hole hides the code it overwrote");
+    spu_overlay_note_get(ctx, 0xB00000, ctx->ls + big, 0x4000);                       /* reload */
+    check(spu_lifted_lookup(ctx, big + 0x300) == hole_big_b, "a reload of the module clears its holes");
+    g_spu_trampoline_fn = 0;
+    free(ctx);
+}
+
+/* A verified load whose data area another DMA wrote before the first dispatch
+ * still verifies: only the bytes outside the holes are compared. */
+static void test_verified_with_holes(void)
+{
+    spu_context* ctx = (spu_context*)calloc(1, sizeof *ctx);
+    if (!ctx) { check(0, "allocate verified hole context"); return; }
+    spu_context_init(ctx, 0);
+    const uint32_t base = 0x38000;
+    uint8_t code[0x100];
+    for (unsigned i = 0; i < sizeof code; ++i) code[i] = (uint8_t)(0x20 + i);
+    spu_begin_image(104); spu_register_function(base, hole_small);
+    spu_begin_image(0);
+    const spu_overlay_code_segment seg = {base, sizeof code, code};
+    check(spu_overlay_register_verified_region(0xD00000, base, sizeof code, 104, &seg, 1), "region registers");
+    ctx->image_id = 100;
+    memcpy(ctx->ls + base, code, sizeof code);
+    spu_overlay_note_get(ctx, 0xD00000, ctx->ls + base, sizeof code);
+    memset(ctx->ls + base + 0x80, 0xEE, 0x20);
+    spu_overlay_note_get(ctx, 0x4AC00000, ctx->ls + base + 0x80, 0x20);
+    check(spu_lifted_lookup(ctx, base) == hole_small, "bytes outside the hole verify");
+    g_spu_trampoline_fn = 0;
+    free(ctx);
+}
+
 /* A streamed region registered with its code bytes dispatches by residency
@@ -491,4 +561,6 @@ static void test_verified_resident_code_regions(void)
 
-    spu_overlay_note_get(ctx, 0x900000, ctx->ls + base + 0x80, 0x80);
-    check(spu_lifted_lookup(ctx, base) != code_verified, "foreign DMA into the span clears residency");
+    spu_overlay_note_get(ctx, 0x900000, ctx->ls + base + 0x20, 0x10);
+    check(spu_lifted_lookup(ctx, base) == code_verified, "foreign DMA beside the code leaves it resident");
+    spu_overlay_note_get(ctx, 0x900000, ctx->ls + base, 0x10);
+    check(spu_lifted_lookup(ctx, base) != code_verified, "foreign DMA over the code drops it there");
 
@@ -1092,2 +1164,4 @@ int main(void)
     test_many_resident_code_regions();
+    test_resident_code_holes();
+    test_verified_with_holes();
     test_resident_interpreter_rejoin();
