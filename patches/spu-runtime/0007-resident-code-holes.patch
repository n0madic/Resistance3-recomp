         for (unsigned i = 0; match && i < o->code_count; ++i)
-            match = !memcmp(ctx->ls + o->code[i].lsa, o->code[i].bytes, o->code[i].size);
+            for (uint32_t a = o->code[i].lsa, end = o->code[i].lsa + o->code[i].size; match && a < end;) {
+                uint32_t run = end;
+                for (uint32_t h = 0; h < ctx->resident_code[slot].n_holes; ++h) {
+                    const uint32_t lo = ctx->resident_code[slot].holes[h][0], hi = ctx->resident_code[slot].holes[h][1];
+                    if (a >= lo && a < hi) { run = a; a = hi; break; }
+                    if (lo > a && lo < run) run = lo;
+                }
+                if (run > a) { match = !memcmp(ctx->ls + a, o->code[i].bytes + (a - o->code[i].lsa), run - a); a = run; }
+            }
