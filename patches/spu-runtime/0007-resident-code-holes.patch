+/* Was `lsa` of this resident span overwritten by another DMA since the load? */
+static int spu_resident_hole(const spu_context* ctx, unsigned slot, uint32_t lsa)
+{
+    for (uint32_t h = 0; h < ctx->resident_code[slot].n_holes; ++h)
+        if (lsa >= ctx->resident_code[slot].holes[h][0] && lsa < ctx->resident_code[slot].holes[h][1]) return 1;
+    return 0;
+}
