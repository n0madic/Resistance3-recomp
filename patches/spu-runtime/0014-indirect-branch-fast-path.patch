+}
 spu_lifted_fn spu_lifted_lookup(const spu_context* ctx, uint32_t lsa)
@@ -1870,6 +1881,4 @@ spu_lifted_fn spu_lifted_lookup(const spu_context* ctx, uint32_t lsa)
     const uint32_t rgen = __atomic_load_n(&s_registry_count, __ATOMIC_ACQUIRE);
-    spu_dcache_ent* e = &t_dcache[((lsa >> 2) ^ (id * 0x9E3779B1u)) & (SPU_DCACHE_ENTRIES - 1)];
-    if (e->fn && e->id == id && e->lsa == lsa && e->rgen == rgen &&
-        e->residency == c->dcache_residency && e->image == c->image_id &&
-        e->ovl == c->resident_ovl && e->task == c->resident_task) {
+    spu_dcache_ent* e = spu_dcache_slot(lsa, id);
+    if (spu_dcache_hit(e, c, id, lsa, rgen)) {
         if (e->reloc) c->reloc_delta = e->reloc_delta;
@@ -2760,3 +2769,52 @@ static int spu_smc_microstep(spu_context* ctx)
 
+static void spu_indirect_branch_full(spu_context* ctx);
+
+/* Every guest indirect branch and every return through a register comes here. Most targets
+ * are a lifted function the dispatch cache knows, and none of the special cases below
+ * applies to them; checking that up front skips the rest of the resolver, whose frame and
+ * one-by-one tests cost about as much as the lookup in a Resistance 3 firefight. Anything
+ * else (an interrupt return pending, a kernel-service or job-return address, a taskset with
+ * registered tasks above its task region, a diagnostic variable set, a target that is not
+ * lifted) takes the full resolver from the top. */
 void spu_indirect_branch(spu_context* ctx)
+{
+    static int s_diag = -1;
+    if (__builtin_expect(s_diag < 0, 0))
+        s_diag = getenv("SPU_IBCOV") || getenv("SPU_POLLTRACE") || getenv("SPU_JOBTRACE") ||
+                 getenv("LBP_HLE_JOBDONE") || getenv("SPU_JOBEXEC");
+    const uint32_t pc = (ctx->pc &= SPU_LS_MASK);
+    if (!s_diag && !ctx->irq_saved && ctx->image_id != SPU_RESOLVER_ONLY_IMAGE_ID &&
+        pc != SPURS_PM_EXIT_TO_KERNEL_LS && pc != SPURS_PM_SELECT_WORKLOAD_LS &&
+        pc != SPURS_TASKSET_PM_SYSCALL_LS && pc != 0xA00u && pc != SPU_JOB_RETURN_LS &&
+        (pc < SPU_TASKSET_TASK_LO || (!s_task_elf_count && !s_task_entry_count))) {
+        if (pc < SPU_TASKSET_TASK_LO) ctx->resident_task = 0;
+        /* The dispatch cache's hit, inline; anything else asks spu_lifted_lookup. */
+        spu_fn fn = NULL;
+        const uint32_t id = ctx->dcache_id;
+        if (id && spu_dcache_mode() == 1) {
+            const spu_dcache_ent* e = spu_dcache_slot(pc, id);
+            if (spu_dcache_hit(e, ctx, id, pc, __atomic_load_n(&s_registry_count, __ATOMIC_ACQUIRE))) {
+                if (e->reloc) ctx->reloc_delta = e->reloc_delta;   /* relocatable code: its placement */
+                fn = (spu_fn)e->fn;
+            }
+        }
+        if (!fn) fn = spu_lifted_lookup(ctx, pc);
+        if (fn) {
+            if (spu_stack_reset_needed(ctx)) spu_check_stack_reset(ctx, fn);
+#if defined(__clang__)
+            __attribute__((musttail)) return fn(ctx);
+#else
+            fn(ctx);
+            return;
+#endif
+        }
+    }
+#if defined(__clang__)
+    __attribute__((musttail)) return spu_indirect_branch_full(ctx);
+#else
+    spu_indirect_branch_full(ctx);
+#endif
+}
+
+__attribute__((noinline)) static void spu_indirect_branch_full(spu_context* ctx)
 {
diff --git a/runtime/spu/tests/test_spu_lifted_start.c b/runtime/spu/tests/test_spu_lifted_start.c
index 98569962..37e51de7 100644
--- a/runtime/spu/tests/test_spu_lifted_start.c
+++ b/runtime/spu/tests/test_spu_lifted_start.c
@@ -1339,2 +1339,92 @@ static void test_overlay_source_prefilter(void)
 
+/* spu_indirect_branch resolves a lifted target before its special cases only where none of
+ * them applies: each case below has a lifted function registered at its address, which the
+ * shortcut would run instead. Runs before any task ELF or task entry is registered: with
+ * one, every target in the task region takes the full resolver anyway. */
+extern void spu_taskset_register_task_entry(uint32_t entry, int image_id);
+static int s_fp_ran;
+static void fp_primary(spu_context* c) { (void)c; s_fp_ran = 1; }
+static void fp_task(spu_context* c) { (void)c; s_fp_ran = 2; }
+static void test_indirect_fast_path_guards(void)
+{
+    spu_context* c = (spu_context*)calloc(1, sizeof *c);
+    if (!c) { check(0, "allocate fast path context"); return; }
+    spu_context_init(c, 0);
+    spu_begin_image(126);
+    spu_register_function(0x2200, fp_primary); spu_register_function(0x9D0, fp_primary);
+    spu_register_function(0x9C0, fp_primary);
+    spu_register_function(0x3FF00, fp_primary); spu_register_function(0x2100, fp_primary);
+    spu_register_function(0x3E100, fp_primary);
+    spu_begin_image(127); spu_register_function(0x2100, fp_task); spu_register_function(0x3E100, fp_task);
+    spu_begin_image(0);
+    c->image_id = 126;
+
+    s_fp_ran = 0; c->pc = 0x2200;
+    spu_indirect_branch(c);
+    check(s_fp_ran == 1, "fast path: a lifted target runs");
+
+    /* The interrupt return: the saved register file comes back before the target runs. */
+    s_fp_ran = 0; c->pc = 0x2200; c->int_enable = 1;
+    c->irq_saved = 1; c->irq_resume_pc = 0x2200;
+    memcpy(c->irq_gpr, c->gpr, sizeof c->irq_gpr);
+    c->irq_gpr[7]._u32[0] = 42; c->gpr[7]._u32[0] = 1;
+    spu_indirect_branch(c);
+    check(s_fp_ran == 1 && c->gpr[7]._u32[0] == 42 && !c->irq_saved,
+          "fast path: an interrupt return restores the registers first");
+
+    /* A policy module's kernel services: exit to the kernel, then selectWorkload. */
+    s_fp_ran = 0; c->pc = 0x9C0; c->policy_mode = 1; c->status = 0;
+    spu_indirect_branch(c);
+    check(!s_fp_ran && c->status == SPU_STATUS_STOPPED_BY_STOP,
+          "fast path: the policy's exit to the kernel stops it");
+    s_fp_ran = 0; c->pc = 0x9D0;
+    c->gpr[0]._u32[0] = 0x2200; c->gpr[3]._u32[0] = 7;
+    spu_indirect_branch(c);
+    check(!s_fp_ran && c->gpr[3]._u32[0] == 0 && c->pc == 0x2200,
+          "fast path: the policy kernel service is not dispatched as code");
+    c->policy_mode = 0;
+
+    /* A job returning through the link the manager planted. */
+    s_fp_ran = 0; c->pc = 0x3FF00; c->status = 0;
+    spu_indirect_branch(c);
+    check(!s_fp_ran, "fast path: the job-return address ends the job");
+
+    /* Below the task region the resident task is dropped. */
+    s_fp_ran = 0; c->pc = 0x2100; c->resident_task = 127;
+    spu_indirect_branch(c);
+    check(s_fp_ran == 1 && c->resident_task == 0, "fast path: below the task region the task is not resident");
+
+    /* Above it, a registered task entry makes its task resident. */
+    spu_taskset_register_task_entry(0x3E100, 127);
+    s_fp_ran = 0; c->pc = 0x3E100;
+    spu_indirect_branch(c);
+    check(s_fp_ran == 2 && c->resident_task == 127, "fast path: a task entry selects its task");
+    g_spu_trampoline_fn = 0;
+    free(c);
+}
+
+/* Relocatable code (spu_overlay_register_region_reloc) reached through the fast path: a
+ * dispatch cache hit there restores ctx->reloc_delta like spu_lifted_lookup's own hit. The
+ * copy sits below the task region, so the fast path applies whatever tasks are registered. */
+static void fp_reloc(spu_context* c) { c->gpr[9]._u32[0] = (uint32_t)c->reloc_delta; }
+static void test_indirect_fast_path_reloc(void)
+{
+    spu_context* c = (spu_context*)calloc(1, sizeof *c);
+    if (!c) { check(0, "allocate fast path reloc context"); return; }
+    spu_context_init(c, 0); c->image_id = 121;
+    spu_begin_image(151); spu_register_function(0x10000, fp_reloc);
+    spu_begin_image(0);
+    spu_overlay_register_region_reloc(0x940000, 0x100, 0x10000, 151);
+    spu_overlay_note_get(c, 0x940000, c->ls + 0x2400, 16);
+    int all = 1;
+    for (int round = 0; round < 3; ++round) {     /* a miss, then cache hits */
+        c->reloc_delta = 0; c->gpr[9]._u32[0] = 0; c->pc = 0x2400;
+        spu_indirect_branch(c);
+        if (c->gpr[9]._u32[0] != 0x2400u - 0x10000u) all = 0;
+    }
+    check(all, "fast path: relocatable code runs with its placement's delta, cache hits too");
+    g_spu_trampoline_fn = 0;
+    free(c);
+}
+
 int main(void)
@@ -1358,2 +1448,4 @@ int main(void)
     test_dispatch_cache();
+    test_indirect_fast_path_guards();
+    test_indirect_fast_path_reloc();
     test_lle_taskset_syscall();
