+}
+static inline int spu_dcache_hit(const spu_dcache_ent* e, const spu_context* c, uint32_t id, uint32_t lsa,
+                                 uint32_t rgen)
+{
+    return e->fn && e->id == id && e->lsa == lsa && e->rgen == rgen &&
+           e->residency == c->dcache_residency && e->image == c->image_id &&
