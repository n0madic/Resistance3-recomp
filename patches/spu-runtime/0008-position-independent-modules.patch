+/* Register a position-independent code module: a verified region the title
+ * loads anywhere in local store, often at a new address each time. Its
+ * functions are lifted once at link_lsa with spu_lifter.py --pic, and its code
+ * segments are given at link addresses. A GET from content_ea into local store
+ * at L makes [L, L + span) resident, verified once against the segments moved
+ * to L; dispatch to an address A there runs the function lifted at
+ * A - L + link_lsa, which finds L from the pc it is entered at. Returns 1 on
+ * success, 0 on invalid input or a full registry. */
+int spu_overlay_register_pic_region(uint32_t content_ea, uint32_t link_lsa,
+    uint32_t span, int image_id, const spu_overlay_code_segment* code,
+    unsigned count);
