+/* A position-independent module lifted once (spu_lifter.py --pic, generated by
+ * tools/test_spu_lifter_pic.py into pic_lifted.c) runs from wherever it is
+ * loaded. The module (link address 0):
+ *
+ *   0x00 brsl $r0, 0x10      internal call: the link is the copy's address
+ *   0x04 lqr  $r4, 0x40      pc-relative load of the copy's constant
+ *   0x08 stqr $r4, 0x50      pc-relative store into the copy
+ *   0x0C br   0x20           transfer to another lifted function
+ *   0x10 lqr  $r5, 0x40      (callee) the same constant, from the callee
+ *   0x14 ori  $r6, $r0, 0    the link it was called with
+ *   0x18 bi   $r0            return
+ *   0x20 bisl $r0, $r7       indirect call out of the module (to 0x300)
+ *   0x24 ori  $r8, $r0, 0    the link of that call
+ *   0x28 bra  0x240          absolute branch out of the module: finish
+ *   0x40 constant, 0x50 store target
+ *
+ * Usage: test_spu_pic_lift <load address>. The link address holds a decoy
+ * constant, so a lift reading its own link addresses shows. */
+#include "../spu_helpers.h"
+#include "../spu_interp.h"
+#include "../spu_overlay_residency.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+extern void spu_begin_image(int);
+extern void spu_register_function(uint32_t, void (*)(spu_context*));
+extern int spu_run_with_halt(void (*)(spu_context*), spu_context*);
+extern void spu_halt(spu_context*);
+extern void pic_spu_recomp_register(void);
+extern void spu_overlay_note_get(spu_context*, uint32_t, const uint8_t*, uint32_t);
+
+static const uint32_t module[24] = {
+    0x33000200, 0x33800784, 0x23800904, 0x32000280,
+    0x33800605, 0x04000006, 0x35000000, 0x00200000,
+    0x35200380, 0x04000008, 0x30004800, 0x00200000,
+    0x00200000, 0x00200000, 0x00200000, 0x00200000,
+    0xDEADBEEF, 0x01234567, 0x89ABCDEF, 0x0F1E2D3C,
+    0, 0, 0, 0,
+};
+static const uint32_t constant[4] = {0xDEADBEEF, 0x01234567, 0x89ABCDEF, 0x0F1E2D3C};
+static spu_context ctx;
+static uint32_t base;
+
+static uint32_t ls_word(uint32_t a) {
+    return ((uint32_t)ctx.ls[a] << 24) | ((uint32_t)ctx.ls[a+1] << 16) |
+           ((uint32_t)ctx.ls[a+2] << 8) | ctx.ls[a+3];
+}
+static void put_words(uint32_t a, const uint32_t* w, unsigned n) {
+    for (unsigned i = 0; i < n; ++i) {
+        ctx.ls[a+4*i] = w[i] >> 24; ctx.ls[a+4*i+1] = w[i] >> 16;
+        ctx.ls[a+4*i+2] = w[i] >> 8; ctx.ls[a+4*i+3] = w[i];
+    }
+}
+static void callee(spu_context* c) {
+    c->gpr[9] = c->gpr[0];
+    SPU_RET(c);
+}
+static void finish(spu_context* c) {
+    c->gpr[11]._u32[0]++;
+    c->status = SPU_STATUS_STOPPED_BY_STOP;
+    spu_halt(c);
+}
+static void start(spu_context* c) {
+    c->pc = base; g_spu_trampoline_fn = spu_indirect_branch;
+}
+static int same_quad(const u128* r) {
+    for (int i = 0; i < 4; ++i)
+        if (r->_u32[i] != constant[i]) return 0;
+    return 1;
+}
+
+int main(int argc, char** argv) {
+    assert(argc == 2);
+    base = (uint32_t)strtoul(argv[1], 0, 0);
+    spu_context_init(&ctx, 0);
+    ctx.image_id = 77;
+    ctx.policy_mode = 1;
+    ctx.status = SPU_STATUS_RUNNING;
+    spu_begin_image(77);
+    spu_register_function(0x240, finish);
+    spu_register_function(0x300, callee);
+    spu_begin_image(78);
+    pic_spu_recomp_register();
+    spu_begin_image(0);
+    uint8_t bytes[sizeof module];
+    for (unsigned i = 0; i < 24; ++i) {
+        bytes[4*i] = module[i] >> 24; bytes[4*i+1] = module[i] >> 16;
+        bytes[4*i+2] = module[i] >> 8; bytes[4*i+3] = module[i];
+    }
+    const spu_overlay_code_segment seg = {0, 0x30, bytes};
+    assert(spu_overlay_register_pic_region(0xE00000, 0, sizeof bytes, 78, &seg, 1));
+    if (base) {
+        const uint32_t decoy[4] = {1, 2, 3, 4};
+        put_words(0x40, decoy, 4);
+    }
+    put_words(base, module, 24);
+    spu_overlay_note_get(&ctx, 0xE00000, ctx.ls + base, sizeof bytes);
+    ctx.gpr[7]._u32[0] = 0x300;
+
+    int halted = spu_run_with_halt(start, &ctx);
+    printf("base 0x%05X: halted=%d finish=%u r6=0x%X r8=0x%X r9=0x%X stored=%08X\n", base, halted,
+           ctx.gpr[11]._u32[0], ctx.gpr[6]._u32[0], ctx.gpr[8]._u32[0], ctx.gpr[9]._u32[0],
+           ls_word(base + 0x50));
+    int ok = 1;
+#define EXPECT(c, what) do { if (!(c)) { printf("  FAIL: %s\n", what); ok = 0; } } while (0)
+    EXPECT(ctx.gpr[11]._u32[0] == 1, "the absolute branch out of the module reached finish");
+    EXPECT(same_quad(&ctx.gpr[4]), "lqr read the copy's constant");
+    EXPECT(same_quad(&ctx.gpr[5]), "the callee's lqr read it too");
+    EXPECT(ls_word(base + 0x50) == constant[0] && ls_word(base + 0x5C) == constant[3], "stqr wrote into the copy");
+    EXPECT(!base || ls_word(0x50) == 0, "nothing was written at the link address");
+    EXPECT(ctx.gpr[6]._u32[0] == base + 4, "the internal call's link is the copy's return address");
+    EXPECT(ctx.gpr[9]._u32[0] == base + 0x24, "the outgoing call's link is the copy's return address");
+    EXPECT(ctx.gpr[8]._u32[0] == base + 0x24, "and execution came back to the copy after it");
+    puts(ok ? "PASS" : "FAILED");
+    return ok ? 0 : 1;
+}
