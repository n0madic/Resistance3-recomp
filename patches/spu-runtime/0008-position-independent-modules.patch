diff --git a/tools/test_spu_lifter_pic.py b/tools/test_spu_lifter_pic.py
new file mode 100644
index 0000000..f79db8b
--- /dev/null
+++ b/tools/test_spu_lifter_pic.py
@@ -0,0 +1,77 @@
+#!/usr/bin/env python3
+"""Self-check: a position-independent SPU lift runs from wherever it is loaded.
+
+Lifts a small module with spu_lifter --pic at link address 0, builds it with the
+real runtime (runtime/spu/tests/test_spu_pic_lift.c) and runs it loaded at the
+link address and at two others: pc-relative loads and stores, link values,
+transfers between its functions and calls out of it all follow the copy.
+
+Run: python tools/test_spu_lifter_pic.py
+"""
+import os
+import struct
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from spu_disasm import disassemble_spu  # noqa: E402
+from spu_lifter import SPULifter, compute_bi_r0_jumps, compute_link_returns  # noqa: E402
+
+if os.name == 'nt':
+    print('SKIP: fixture currently requires the POSIX compiler/linker')
+    raise SystemExit(0)
+
+ROOT = Path(__file__).resolve().parents[1]
+SPU = ROOT / 'runtime/spu'
+# The module of test_spu_pic_lift.c: code up to 0x30, then data.
+CODE = struct.pack('>12I', 0x33000200, 0x33800784, 0x23800904, 0x32000280,
+                   0x33800605, 0x04000006, 0x35000000, 0x00200000,
+                   0x35200380, 0x04000008, 0x30004800, 0x00200000)
+BOUNDS = [(0x00, 0x10), (0x10, 0x20), (0x20, 0x30)]
+SOURCES = ['spu_channels.c', 'spu_drain.c', 'spu_lockstep.c', 'spu_coherency.c',
+           'spu_workload.c', 'spurs_policy.c', 'spurs_job.c', 'spu_tsp_weak.c',
+           'spu_vm_pagemap.c', 'spurs_policy_blob_weak.c', 'spu_interp.c']
+
+
+def lift(out: Path) -> None:
+    insns = disassemble_spu(CODE, 0)
+    lifter = SPULifter(prefix='pic_', pic=True)
+    lifter.bi_r0_jump = compute_bi_r0_jumps(insns, BOUNDS)
+    lifter.link_return = compute_link_returns(insns, BOUNDS)
+    lifter.func_starts = {s for s, _ in BOUNDS}
+    for s, e in BOUNDS:
+        lifter.lift_function(insns, s, e)
+    (out / 'pic_lifted.h').write_text(lifter.emit_header().replace('../../runtime/spu/', ''))
+    (out / 'pic_lifted.c').write_text(lifter.emit_source('pic_lifted.h').replace('../../runtime/spu/', ''))
+
+
+def main() -> int:
+    with tempfile.TemporaryDirectory(prefix='spu-pic-lift-') as tmp:
+        out = Path(tmp)
+        lift(out)
+        binary = out / 'test'
+        subprocess.run([os.environ.get('CC', 'cc'), '-std=gnu17', '-O1', '-UNDEBUG', '-w',
+                        '-I' + str(ROOT / 'include'), '-I' + str(SPU), '-I' + str(ROOT / 'runtime/platform'),
+                        str(SPU / 'tests/test_spu_pic_lift.c'), str(out / 'pic_lifted.c'),
+                        *[str(SPU / name) for name in SOURCES],
+                        str(ROOT / 'runtime/platform/win32_compat.c'), '-pthread', '-lm',
+                        '-o', str(binary)], check=True)
+        env = {k: v for k, v in os.environ.items() if not k.startswith(('SPU_', 'SPURS_'))}
+        failed = []
+        for base in ('0', '0x11B60', '0x2A400'):
+            r = subprocess.run([str(binary), base], capture_output=True, text=True, timeout=10, cwd=tmp, env=env)
+            print(r.stdout.strip())
+            if r.returncode:
+                print(r.stderr[-2000:])
+                failed.append(base)
+    if failed:
+        print('FAILED at ' + ', '.join(failed))
+        return 1
+    print('ok: the position-independent lift runs from every load address')
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
