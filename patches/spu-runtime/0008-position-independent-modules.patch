+/* A position-independent module is lifted once, at its link address, and the
+ * title loads it anywhere: every load dispatches to the same lift, verified
+ * against the bytes where the load put them. Copies come and go at new
+ * addresses, mostly over an earlier one, and must not use up the slots. */
+static void pic_entry(spu_context* ctx) { ctx->gpr[3]._u32[0] = 105; ctx->gpr[4]._u32[0] = ctx->pc; }
+static void pic_inner(spu_context* ctx) { ctx->gpr[3]._u32[0] = 106; ctx->gpr[4]._u32[0] = ctx->pc; }
+static void test_pic_resident_code(void)
+{
+    spu_context* ctx = (spu_context*)calloc(1, sizeof *ctx);
+    if (!ctx) { check(0, "allocate pic context"); return; }
+    spu_context_init(ctx, 0);
+    const uint32_t ea = 0xE00000, link = 0x0, first = 0x11B60;
+    uint8_t code[0x100];
+    for (unsigned i = 0; i < sizeof code; ++i) code[i] = (uint8_t)(0x60 + i);
+    spu_begin_image(105); spu_register_function(link, pic_entry); spu_register_function(link + 0x80, pic_inner);
+    spu_begin_image(0);
+    const spu_overlay_code_segment seg = {link, sizeof code, code};
+    check(spu_overlay_register_pic_region(ea, link, sizeof code, 105, &seg, 1), "pic module registers");
+    ctx->image_id = 100;
+    memcpy(ctx->ls + link, code, sizeof code);          /* the link address holds the code too: not what is verified */
+
+    memcpy(ctx->ls + first, code, sizeof code);
+    spu_overlay_note_get(ctx, ea, ctx->ls + first, sizeof code);
+    check(spu_lifted_lookup(ctx, first) == pic_entry, "a load away from the link address dispatches the lift");
+    check(spu_lifted_lookup(ctx, first + 0x80) == pic_inner, "every function of it, at its offset");
+    check(spu_lifted_lookup(ctx, first + sizeof code) == NULL, "the end of the copy is not its code");
+    ctx->gpr[4]._u32[0] = 0; spu_dispatch(ctx, first + 0x80);
+    check(ctx->gpr[3]._u32[0] == 106 && ctx->gpr[4]._u32[0] == first + 0x80,
+          "dispatch enters the lift with the pc of the copy");
+
+    const uint32_t second = 0x14600;
+    memcpy(ctx->ls + second, code, sizeof code);
+    spu_overlay_note_get(ctx, ea, ctx->ls + second, sizeof code);
+    check(spu_lifted_lookup(ctx, second) == pic_entry && spu_lifted_lookup(ctx, first) == pic_entry,
+          "two copies are resident together");
+
+    const uint32_t over = first + 0x80;                 /* the next copy lands over half of the first */
+    memcpy(ctx->ls + over, code, sizeof code);
+    spu_overlay_note_get(ctx, ea, ctx->ls + over, sizeof code);
+    check(spu_lifted_lookup(ctx, over) == pic_entry, "a copy over an earlier one dispatches");
+    check(spu_lifted_lookup(ctx, first) == pic_entry, "the part of the earlier copy it left still does");
+    unsigned held = 0;
+    for (unsigned slot = 0; slot < SPU_RESIDENT_CODE_SLOTS; ++slot) held += ctx->resident_code[slot].image_id == 105;
+    check(held == 3, "both keep a slot");
+    memcpy(ctx->ls + first - 0x10, code, sizeof code);   /* this one covers the whole first copy... */
+    memcpy(ctx->ls + first - 0x10 + sizeof code, code, 0x20);
+    spu_overlay_note_get(ctx, ea, ctx->ls + first - 0x10, sizeof code + 0x20);
+    held = 0;
+    for (unsigned slot = 0; slot < SPU_RESIDENT_CODE_SLOTS; ++slot) held += ctx->resident_code[slot].image_id == 105;
+    check(held == 3, "...and takes its slot");
+    check(spu_lifted_lookup(ctx, first - 0x10) == pic_entry, "where it dispatches");
+
+    const uint32_t bad = 0x16000;
+    memcpy(ctx->ls + bad, code, sizeof code);
+    ctx->ls[bad + 0x10] ^= 0xFF;
+    spu_overlay_note_get(ctx, ea, ctx->ls + bad, sizeof code);
+    check(spu_lifted_lookup(ctx, bad) == NULL, "a copy whose bytes differ is interpreted");
+
+    for (uint32_t i = 0; i < 2 * SPU_RESIDENT_CODE_SLOTS; ++i) {
+        const uint32_t at = 0x20000 + i * 0x200;
+        memcpy(ctx->ls + at, code, sizeof code);
+        spu_overlay_note_get(ctx, ea, ctx->ls + at, sizeof code);
+    }
+    const uint32_t last = 0x20000 + (2 * SPU_RESIDENT_CODE_SLOTS - 1) * 0x200;
+    check(spu_lifted_lookup(ctx, last) == pic_entry, "more copies than slots: the newest is resident");
+
+    /* All slots held by copies: a copy later loads overwrote in part goes before
+     * an older one left whole (the title still runs that one). */
+    memset(ctx->resident_code, 0, sizeof ctx->resident_code);
+    const uint32_t oldest = 0x2C000, holed = 0x2C200, newest = 0x36000;
+    for (uint32_t i = 0; i < SPU_RESIDENT_CODE_SLOTS; ++i) {
+        const uint32_t at = oldest + i * 0x200;
+        memcpy(ctx->ls + at, code, sizeof code);
+        spu_overlay_note_get(ctx, ea, ctx->ls + at, sizeof code);
+    }
+    spu_overlay_note_get(ctx, 0x4AD00000, ctx->ls + holed + 0x80, 0x10);   /* data over a younger copy */
+    memcpy(ctx->ls + newest, code, sizeof code);
+    spu_overlay_note_get(ctx, ea, ctx->ls + newest, sizeof code);
+    check(spu_lifted_lookup(ctx, newest) == pic_entry, "a copy loaded with every slot taken dispatches");
+    check(spu_lifted_lookup(ctx, oldest) == pic_entry, "the oldest copy, left whole, keeps its slot");
+    check(spu_lifted_lookup(ctx, holed) == NULL, "the one a later load overwrote in part gave its slot up");
+
+    /* All slots held by copies: a fixed-address module still gets one. */
+    const uint32_t fixed = 0x3A000;
+    spu_begin_image(107); spu_register_function(fixed, pic_inner);
+    spu_begin_image(0);
+    spu_overlay_register_region(0xF00000, 0x400, 107);
+    spu_overlay_note_get(ctx, 0xF00000, ctx->ls + fixed, 0x400);
+    check(spu_lifted_lookup(ctx, fixed) == pic_inner, "copies do not keep a fixed-address module out");
+    g_spu_trampoline_fn = 0;
+    free(ctx);
+}
