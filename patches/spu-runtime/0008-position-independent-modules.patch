+/* The slot for a code load that wrote [lsa, lsa + size): the one of a load at
+ * the same address, else one whose whole span it overwrote, else a free slot,
+ * else the one of a copy of a position-independent module: one that later
+ * loads overwrote in part first (the title has moved on from it), the oldest
+ * first. Those copies come and go at a new address each time, so they must
+ * neither use up the slots nor keep fixed-address code out; a copy a load
+ * overwrote only in part keeps the rest (its holes) while a slot is free.
+ * N when none is left. */
+static unsigned spu_resident_slot(const spu_context* ctx, uint32_t lsa, uint32_t size)
+{
+    unsigned free_slot = SPU_RESIDENT_CODE_SLOTS, pic_slot = SPU_RESIDENT_CODE_SLOTS;
+    for (unsigned slot = 0; slot < SPU_RESIDENT_CODE_SLOTS; ++slot) {
+        const uint32_t base = ctx->resident_code[slot].lsa, span = ctx->resident_code[slot].size;
+        if (!ctx->resident_code[slot].image_id) {
+            if (free_slot == SPU_RESIDENT_CODE_SLOTS) free_slot = slot;
+            continue;
+        }
+        if (base == lsa || (base >= lsa && base - lsa <= size && span <= size - (base - lsa))) return slot;
+        if (!s_ovl_src[ctx->resident_code[slot].source_index].pic) continue;
+        if (pic_slot == SPU_RESIDENT_CODE_SLOTS) { pic_slot = slot; continue; }
+        const int holed = ctx->resident_code[slot].n_holes != 0, best_holed = ctx->resident_code[pic_slot].n_holes != 0;
+        if (holed != best_holed ? holed
+                                : (int32_t)(ctx->resident_code[slot].loaded - ctx->resident_code[pic_slot].loaded) < 0)
+            pic_slot = slot;
+    }
+    return free_slot != SPU_RESIDENT_CODE_SLOTS ? free_slot : pic_slot;
+}
