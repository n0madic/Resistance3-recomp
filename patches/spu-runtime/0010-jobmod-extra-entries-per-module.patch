+def parse_extra_funcs(items):
+    """[(sha or None, LS address)] from EXTRA_FUNCS-style items."""
+    out = []
+    for item in items:
+        sha, _, addr = item.rpartition(":")
+        out.append((sha.lower() or None, int(addr, 0)))
+    return out
+
+
+def check_extra_funcs(extra, spans):
+    """Error for a keyed entry whose module is missing or does not span it
+    (spans: sha -> (link base, image size)): a typo would otherwise drop it
+    silently."""
+    for sha, addr in extra:
+        if sha is None:
+            continue
+        if sha not in spans:
+            return f"LBP_JOBMOD_EXTRA_FUNCS: no module {sha} for 0x{addr:X}"
+        base, size = spans[sha]
+        if not base <= addr < base + size:
+            return (f"LBP_JOBMOD_EXTRA_FUNCS: 0x{addr:X} is outside module {sha} "
+                    f"(0x{base:X}..0x{base + size:X})")
+    return None
+
+
+def extra_funcs_for(extra, sha, size, base=BASE):
+    """The entries offered to module `sha`, of `size` bytes at `base` (a module
+    named by no sha gets the bare ones only)."""
+    return [a for s, a in extra if s in (None, sha) and base <= a < base + size]
+
