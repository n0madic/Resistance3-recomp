+#!/usr/bin/env python3
+"""LBP_JOBMOD_EXTRA_FUNCS: a bare address splits every module that spans it, `<sha>:<addr>` only that module."""
+import os
+from pathlib import Path
+import struct
+import subprocess
+import sys
+import tempfile
+
+NOP, BI_R0 = 0x40200000, 0x35000000
+SPLIT = 0x4040                          # inside the straight-line code of both modules
+
+
+def module(nops):
+    # 0x30-byte job header with the entry offset at 0x10, then the code: nops and `bi $r0`.
+    header = bytearray(0x30)
+    struct.pack_into(">I", header, 0x10, 0x30)
+    return bytes(header) + struct.pack(f">{nops + 1}I", *([NOP] * nops + [BI_R0]))
+
+
+def lift(root, extra):
+    out = root / "out"
+    r = subprocess.run([sys.executable, str(Path(__file__).with_name("lift_jobmods.py")),
+                        "--jobmods", str(root / "jobmods"), "--out", str(out)],
+                       env={**os.environ, "LBP_JOBMOD_EXTRA_FUNCS": extra},
+                       stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+    split = {sha for sha in ("aaaaaaaaaaaa", "bbbbbbbbbbbb")
+             if r.returncode == 0 and f"spu_func_{SPLIT:08X}" in
+             (out / f"jobmod_{sha}_e0030" / "spu_recomp.c").read_text()}
+    return r, split
+
+
+def main():
+    with tempfile.TemporaryDirectory() as tmp:
+        root = Path(tmp)
+        (root / "jobmods").mkdir()
+        (root / "jobmods" / "jobmod_aaaaaaaaaaaa_e0030.bin").write_bytes(module(8))
+        (root / "jobmods" / "jobmod_bbbbbbbbbbbb_e0030.bin").write_bytes(module(9))
+        for extra, want in (("", set()), (hex(SPLIT), {"aaaaaaaaaaaa", "bbbbbbbbbbbb"}),
+                            (f"bbbbbbbbbbbb:{SPLIT:#x}", {"bbbbbbbbbbbb"}),
+                            (f"AAAAAAAAAAAA:{SPLIT:#x}", {"aaaaaaaaaaaa"})):
+            r, split = lift(root, extra)
+            assert r.returncode == 0, r.stderr
+            assert split == want, (extra, split)
+        for extra, message in (("cccccccccccc:0x4040", "no module cccccccccccc"),
+                               ("aaaaaaaaaaaa:0x5000", "outside module aaaaaaaaaaaa")):
+            r, _ = lift(root, extra)
+            assert r.returncode != 0 and message in r.stderr, (extra, r.returncode, r.stderr)
+    print("PASS: jobmod extra entries, bare and per module")
+
+
+if __name__ == "__main__":
+    main()
