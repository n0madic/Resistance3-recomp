+    """The 12 hex digits of a jobmod_<sha>_e<entry> name, the key of
+    LBP_JOBMOD_EXTRA_FUNCS (None for any other name)."""
+    parts = name.split("_")
+    return parts[1].lower() if len(parts) >= 3 and parts[0] == "jobmod" else None
+
