+def check_extra_funcs(extra, sizes):
+    """Error for a keyed entry whose module is missing or does not span it
+    (sizes: sha -> image size): a typo would otherwise drop it silently."""
+    for sha, addr in extra:
+        if sha is None:
+            continue
+        if sha not in sizes:
+            return f"LBP_JOBMOD_EXTRA_FUNCS: no module {sha} for 0x{addr:X}"
