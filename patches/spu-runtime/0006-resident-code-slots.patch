+/* Nine code buffers resident together (Resistance 3's job dispatcher keeps
+ * modules in that many LS buffers): each dispatches its own lift. With four
+ * slots the fifth load found none free and its code was interpreted. */
+static void code_many(spu_context* ctx) { ctx->gpr[3]._u32[0] = 90 + (ctx->pc >> 12) % 16; }
+static void test_many_resident_code_regions(void)
+{
+    spu_context* ctx = (spu_context*)calloc(1, sizeof *ctx);
+    if (!ctx) { check(0, "allocate many-region context"); return; }
+    spu_context_init(ctx, 0);
+    enum { N = 9 };
+    for (int i = 0; i < N; ++i) {
+        spu_begin_image(90 + i); spu_register_function(0x20000u + 0x1000u * (uint32_t)i, code_many);
+        spu_overlay_register_region(0xA00000u + 0x10000u * (uint32_t)i, 0x400, 90 + i);
+    }
+    spu_begin_image(0);
+    ctx->image_id = 89;
+    for (int i = 0; i < N; ++i)
+        spu_overlay_note_get(ctx, 0xA00000u + 0x10000u * (uint32_t)i, ctx->ls + 0x20000u + 0x1000u * (uint32_t)i, 0x100);
+    int all = 1;
+    for (int i = 0; i < N; ++i) {
+        ctx->gpr[3]._u32[0] = 0;
+        ctx->pc = 0x20000u + 0x1000u * (uint32_t)i; spu_indirect_branch(ctx);
+        if (ctx->gpr[3]._u32[0] != 90u + (uint32_t)(0x20 + i) % 16u) all = 0;
+    }
+    check(all, "nine streamed code buffers stay resident together");
+    g_spu_trampoline_fn = 0;
+    free(ctx);
+}
+
 /* A streamed region registered with its code bytes dispatches by residency
@@ -1101,2 +1130,3 @@ int main(void)
     test_registry_lookup_memo();
+    test_many_resident_code_regions();
     test_resident_interpreter_rejoin();
