diff --git a/runtime/spu/tests/test_spu_lifted_start.c b/runtime/spu/tests/test_spu_lifted_start.c
index 9538ebd..94e3bc1 100644
--- a/runtime/spu/tests/test_spu_lifted_start.c
+++ b/runtime/spu/tests/test_spu_lifted_start.c
@@ -936,2 +936,51 @@ static void test_guest_stack_reset(void)
 
+/* Each trampoline step passes spu_task_launch_check: a job that branches to
+ * LS 0 after its first step has finished (its crt tail-jumps to the job
+ * manager) and halts there, at the top level and in a nested drain; a first
+ * step at 0 is the entry; a policy module's 0 is not an end; an armed PM flow
+ * trace records every step it lets run. */
+extern uint32_t g_pm_flow_buf[8192];
+extern volatile unsigned g_pm_flow_n;
+extern void* volatile g_pm_flow_ctx;
+static int s_le_ran;
+static void le_at_zero(spu_context* c) { (void)c; s_le_ran |= 2; }
+static void le_first(spu_context* c) { s_le_ran |= 1; c->pc = 0; g_spu_trampoline_fn = le_at_zero; }
+static void le_entry(spu_context* c) { c->pc = 0x4000; g_spu_trampoline_fn = le_first; }
+static void le_nested(spu_context* c)
+{
+    c->host_depth++; c->pc = 0x4000; g_spu_trampoline_fn = le_first;
+    spu_drain_call(c, 0x5000);
+    s_le_ran |= 8;
+}
+static void le_entry_at_zero(spu_context* c) { c->pc = 0; g_spu_trampoline_fn = le_at_zero; }
+static int le_run(void (*entry)(spu_context*), int policy, int* ran)
+{
+    spu_context* c = (spu_context*)calloc(1, sizeof *c);
+    if (!c) return -1;
+    spu_context_init(c, 0);
+    c->image_id = 130; c->policy_mode = policy;
+    s_le_ran = 0;
+    const int halted = spu_run_with_halt(entry, c);
+    *ran = s_le_ran;
+    free(c);
+    return halted;
+}
+static void test_job_end_at_ls0(void)
+{
+    int ran;
+    check(le_run(le_entry, 0, &ran) == 1 && ran == 1, "a job that branches to LS 0 ends there");
+    check(le_run(le_nested, 0, &ran) == 1 && ran == 1, "a job that branches to LS 0 in a nested drain ends there");
+    check(le_run(le_entry_at_zero, 0, &ran) == 0 && ran == 2, "a first step at LS 0 is the entry");
+    check(le_run(le_entry, 1, &ran) == 0 && ran == 3, "a policy module's LS 0 is not a job end");
+    spu_context* c = (spu_context*)calloc(1, sizeof *c);
+    if (!c) { check(0, "allocate PM flow context"); return; }
+    spu_context_init(c, 0);
+    c->image_id = 130; c->policy_mode = 1;
+    g_pm_flow_n = 0; g_pm_flow_ctx = c;
+    spu_run_with_halt(le_entry, c);
+    g_pm_flow_ctx = 0;
+    check(g_pm_flow_n == 2 && g_pm_flow_buf[0] == 0x4000 && g_pm_flow_buf[1] == 0, "the PM flow trace records each step");
+    free(c);
+}
+
 static void nested_task_resume(spu_context* ctx)
