+/* Sources are found by EA or signature through hash buckets, in registration
+ * order: the first source that matches a GET takes it, as the scan of the
+ * whole table did. */
+static int resident_image_at(const spu_context* ctx, uint32_t lsa)
+{
+    for (unsigned s = 0; s < SPU_RESIDENT_CODE_SLOTS; ++s)
+        if (ctx->resident_code[s].image_id && ctx->resident_code[s].lsa == lsa) return ctx->resident_code[s].image_id;
+    return 0;
+}
+static void test_overlay_source_order(void)
+{
+    extern void spu_overlay_register_sig(const uint8_t sig[16], int image_id);
+    extern int spu_overlay_match_sig(const uint8_t hdr[16]);
+    spu_context* ctx = (spu_context*)calloc(1, sizeof *ctx);
+    if (!ctx) { check(0, "allocate source order context"); return; }
+    spu_context_init(ctx, 0);
+    const uint32_t base = 0x14000, ea = 0xC80000;
+    uint8_t code[0x40];
+    for (unsigned i = 0; i < sizeof code; ++i) code[i] = (uint8_t)(0x60 + i);
+    const spu_overlay_code_segment far = {base + 0x1000, sizeof code, code}, near = {base, sizeof code, code};
+    check(spu_overlay_register_verified_region(ea, base + 0x1000, 0x400, 110, &far, 1)
+          && spu_overlay_register_verified_region(ea, base, 0x400, 111, &near, 1),
+          "two verified regions share an EA");
+    spu_overlay_note_get(ctx, ea, ctx->ls + base, 0x200);
+    check(resident_image_at(ctx, base) == 111, "a load passes over a same-EA source lifted for another address");
+
+    spu_overlay_register_region(0xC90000, 0x400, 112);
+    spu_overlay_register_region(0xC90000, 0x400, 113);
+    spu_overlay_note_get(ctx, 0xC90000, ctx->ls + 0x16000, 0x100);
+    check(resident_image_at(ctx, 0x16000) == 112, "of two sources with one EA the first takes the load");
+
+    uint8_t s1[16], s2[16];
+    for (unsigned i = 0; i < 16; ++i) { s1[i] = (uint8_t)(0x50 + i); s2[i] = (uint8_t)(0xC0 + i); }
+    spu_overlay_register_sig(s1, 114);
+    spu_overlay_register_region(0xCA0000, 0x400, 115);
+    memcpy(ctx->ls + 0x18000, s1, 16);
+    ctx->resident_ovl = 0;
+    spu_overlay_note_get(ctx, 0xCA0000, ctx->ls + 0x18000, 0x200);
+    check(ctx->resident_ovl == 114 && !resident_image_at(ctx, 0x18000), "an earlier signature beats a later EA");
+    spu_overlay_register_region(0xCB0000, 0x400, 116);
+    spu_overlay_register_sig(s2, 117);
+    memcpy(ctx->ls + 0x19000, s2, 16);
+    spu_overlay_note_get(ctx, 0xCB0000, ctx->ls + 0x19000, 0x200);
+    check(resident_image_at(ctx, 0x19000) == 116 && ctx->resident_ovl == 114, "an earlier EA beats a later signature");
+    ctx->resident_ovl = 0;
+    spu_overlay_note_get(ctx, 0xCC0000, ctx->ls + 0x18000, 0x100);
+    check(ctx->resident_ovl == 0, "a signature needs a GET of 512 bytes");
+    spu_overlay_note_get(ctx, 0xCC0000, ctx->ls + 0x18000, 0x200);
+    check(ctx->resident_ovl == 114, "a signature matches at any EA");
+    static const uint8_t none[16];
+    check(spu_overlay_match_sig(s1) == 114 && spu_overlay_match_sig(s2) == 117 && !spu_overlay_match_sig(none),
+          "a module header is matched by its signature");
+    g_spu_trampoline_fn = 0;
+    free(ctx);
+}
