SPU: cfltu/csflt/cuflt four lanes at a time with NEON (cflts is upstream's, #677).

In a Resistance 3 firefight the SPU float conversions took ~10% of the SPU threads' time (`sample`: spu_cflts,
spu_cuflt, spu_cfltu next to the lifted code). The per-lane forms were too big to inline into the lifted
functions, so every conversion was a call with the vector passed through general registers (131 out-of-line
copies in the module). v0.19.0's ARM64 branch (#677) does fi and cflts in NEON and keeps the per-lane references
for the other three; this adds those: cfltu scales in single precision and converts truncating and saturating
(every scale stays in the vector); csflt/cuflt convert in double and truncate exactly (spu__ifl_trunc), and only a
lane outside the single range (a scale the ISA leaves undefined) is redone one by one.

Test: tools/test_spu_convert_vector.py (runtime/spu/tests/test_spu_convert_vector.c: every i8 on boundary and
pseudo-random words, on ARM64 also under round-toward-zero plus flush-to-zero as #677's test does; `full` runs all
2^32 words at i8 173/155). On v0.18.0 (with this patch's own cflts) `full` agreed on 25.8G lanes, and a
float->int->float micro-benchmark went from 4.5 to 2.3 ns per pair (throughput; latency 9.3 -> 9.4 ns). In the game
(`sample`, 25 s of the Haven firefight, 2 runs each) the conversions' share of the SPU threads went from 7-9% to
none and the lifted code's rose by the same amount: no gain shows at that resolution.
tests/bench/spu (run_spu_bench.sh --only cfltu,csflt,cuflt) measures each op lifted.

Upstream: not proposed yet.
---

diff --git a/runtime/spu/spu_helpers.h b/runtime/spu/spu_helpers.h
index 9691a152..8d302953 100644
--- a/runtime/spu/spu_helpers.h
+++ b/runtime/spu/spu_helpers.h
@@ -1793,4 +1793,5 @@ SPU__XE_INLINE u128 spu_cuflt(u128 a, int i8) {
 #include <arm_neon.h>
-/* fi and cflts four lanes at a time on ARM64 (the others keep their references).
- * test_spu_float_est.c checks both against the scalar references.
+/* fi and the conversions four lanes at a time on ARM64 (frest/frsqest keep their references).
+ * test_spu_fi_cflts_neon.c checks fi and cflts against the scalar references,
+ * test_spu_convert_vector.c the four conversions.
  *
@@ -1835,5 +1836,66 @@ static inline u128 spu_cflts(u128 a, int i8) {
 }
-static inline u128 spu_cfltu(u128 a, int i8)   { return spu_cfltu_ref(a, i8); }
-static inline u128 spu_csflt(u128 a, int i8)   { return spu_csflt_ref(a, i8); }
-static inline u128 spu_cuflt(u128 a, int i8)   { return spu_cuflt_ref(a, i8); }
+/* cfltu, csflt, cuflt: the per-lane references were not inlined either (a call per
+ * instruction; with cflts ~10% of the SPU threads' time in a Resistance 3 firefight). */
+static inline uint32_t spu__ifl_lane(uint32_t v, int i8, int is_unsigned) {
+    const int neg = !is_unsigned && (v >> 31);
+    return v ? spu__sf_pack(neg ? 0x80000000u : 0, neg ? 0u - v : v, -(155 - (i8 & 0xFF))) : 0;
+}
+SPU__NV_INLINE float64x2_t spu__nv_pow2(int e) {                 /* 2^e, -1022 <= e <= 1023 */
+    return vreinterpretq_f64_u64(vdupq_n_u64((uint64_t)(1023 + e) << 52));
+}
+/* cfltu: scale by 2^(173-i8) in single precision (exact: a power of two; an overflow is an
+ * infinity, or FLT_MAX under round-toward-zero, which saturates like the true value; an
+ * underflow is below 1 and truncates to 0 either way), then convert truncating toward zero and
+ * saturating (FCVTZU). A scale above 127 is applied in two factors. The SPU reads exponent 0 as
+ * zero and exponent 255 as an ordinary binade (at least 2^128, which saturates): the input
+ * clears the first and turns the second into an infinity, so every scale stays in the vector. */
+SPU__NV_INLINE float32x4_t spu__nv_cfl_in(uint32x4_t x, int scale) {
+    const uint32x4_t ext = vcgtq_u32(vshlq_n_u32(x, 1), vdupq_n_u32(0xFEFFFFFFu));      /* exponent 255 */
+    x = vbicq_u32(vandq_u32(x, vtstq_u32(x, vdupq_n_u32(0x7F800000u))), vandq_u32(ext, vdupq_n_u32(0x7FFFFFu)));
+    float32x4_t f = vreinterpretq_f32_u32(x);
+    if (scale > 127) { f = vmulq_n_f32(f, 0x1p127f); scale -= 127; }
+    return vmulq_f32(f, vreinterpretq_f32_u32(vdupq_n_u32((uint32_t)(127 + scale) << 23)));   /* 2^scale */
+}
+SPU__NV_INLINE u128 spu_cfltu(u128 a, int i8) {
+    return spu__nv_u128(vcvtq_u32_f32(spu__nv_cfl_in(vld1q_u32(a._u32), 173 - (i8 & 0xFF))));
+}
+/* csflt/cuflt: the integer in double (exact), scaled by 2^(i8-155) (exact), then truncated to
+ * single (the SPU rounds toward zero): the low 29 bits of the double's significand dropped, so
+ * the conversion is exact in any rounding mode. Only a scale outside 0..127 (undefined by the
+ * ISA) can leave the single range (zero aside); *ok clears those lanes and they are redone one
+ * by one. */
+SPU__NV_INLINE float32x2_t spu__ifl_trunc(float64x2_t d, uint32x2_t* ok) {
+    const uint64x2_t u = vreinterpretq_u64_f64(d);
+    const uint64x2_t az = vceqzq_u64(vshlq_n_u64(u, 1));                  /* +-0 */
+    const int64x2_t e = vsubq_s64(vreinterpretq_s64_u64(vandq_u64(vshrq_n_u64(u, 52), vdupq_n_u64(0x7FF))), vdupq_n_s64(1023));
+    const uint64x2_t good = vandq_u64(vcgeq_s64(e, vdupq_n_s64(-126)), vcleq_s64(e, vdupq_n_s64(127)));
+    *ok = vmovn_u64(vorrq_u64(good, az));
+    return vcvt_f32_f64(vreinterpretq_f64_u64(vandq_u64(u, vdupq_n_u64(~0x1FFFFFFFull))));
+}
+SPU__NV_SLOW uint32x4_t spu__ifl_fix(uint32x4_t r, uint32x4_t ok, uint32x4_t a, int i8, int is_unsigned) {
+    SPU__NV_LANES(r, o); SPU__NV_LANES(ok, m); SPU__NV_LANES(a, x);
+    for (int i = 0; i < 4; i++) if (!m[i]) o[i] = spu__ifl_lane(x[i], i8, is_unsigned);
+    return vld1q_u32(o);
+}
+SPU__NV_INLINE u128 spu__nv_ifl(u128 a, int i8, int is_unsigned) {
+    const uint32x4_t x = vld1q_u32(a._u32);
+    const float64x2_t s = spu__nv_pow2((i8 & 0xFF) - 155);
+    float64x2_t dlo, dhi;
+    if (is_unsigned) {
+        dlo = vcvtq_f64_u64(vmovl_u32(vget_low_u32(x)));
+        dhi = vcvtq_f64_u64(vmovl_high_u32(x));
+    } else {
+        dlo = vcvtq_f64_s64(vmovl_s32(vget_low_s32(vreinterpretq_s32_u32(x))));
+        dhi = vcvtq_f64_s64(vmovl_high_s32(vreinterpretq_s32_u32(x)));
+    }
+    uint32x2_t oklo, okhi;
+    const float32x2_t lo = spu__ifl_trunc(vmulq_f64(dlo, s), &oklo);
+    const float32x2_t hi = spu__ifl_trunc(vmulq_f64(dhi, s), &okhi);
+    const uint32x4_t ok = vcombine_u32(oklo, okhi);
+    uint32x4_t r = vreinterpretq_u32_f32(vcombine_f32(lo, hi));
+    if (!spu__nv_all4(ok)) r = spu__ifl_fix(r, ok, x, i8, is_unsigned);
+    return spu__nv_u128(r);
+}
+SPU__NV_INLINE u128 spu_csflt(u128 a, int i8) { return spu__nv_ifl(a, i8, 0); }
+SPU__NV_INLINE u128 spu_cuflt(u128 a, int i8) { return spu__nv_ifl(a, i8, 1); }
 #else
diff --git a/runtime/spu/tests/test_spu_convert_vector.c b/runtime/spu/tests/test_spu_convert_vector.c
new file mode 100644
index 00000000..dec7527f
--- /dev/null
+++ b/runtime/spu/tests/test_spu_convert_vector.c
@@ -0,0 +1,76 @@
+/* The vector cflts/cfltu/csflt/cuflt against the per-lane reference, for every i8 (0..255) on
+ * boundary words and pseudo-random words, on ARM64 once in the default FPCR and once with
+ * round-toward-zero plus flush-to-zero (the mode SPU_FLOAT_RZ runs lifted code in). `full`
+ * instead runs every 32-bit word through the float-to-integer pair at i8 = 173 (scale 0) and
+ * 155 (scale 2^18), and the integer-to-float pair at i8 = 155. Prints "OK: <n> lanes" or the
+ * first mismatches. */
+#include "spu_helpers.h"
+#include <stdio.h>
+#include <string.h>
+
+static unsigned long long lanes;
+static int failed;
+
+static void check(const char* op, u128 got, u128 want, u128 in, int i8) {
+    lanes += 4;
+    for (int i = 0; i < 4; i++)
+        if (got._u32[i] != want._u32[i] && failed++ < 20)
+            printf("FAIL %s i8=%d in=0x%08X got=0x%08X want=0x%08X\n", op, i8, in._u32[i], got._u32[i], want._u32[i]);
+}
+static void check_all(u128 a, int i8) {
+    check("cflts", spu_cflts(a, i8), spu_cflts_ref(a, i8), a, i8);
+    check("cfltu", spu_cfltu(a, i8), spu_cfltu_ref(a, i8), a, i8);
+    check("csflt", spu_csflt(a, i8), spu_csflt_ref(a, i8), a, i8);
+    check("cuflt", spu_cuflt(a, i8), spu_cuflt_ref(a, i8), a, i8);
+}
+static uint32_t rng = 0x9E3779B9u;
+static uint32_t next(void) { rng ^= rng << 13; rng ^= rng >> 17; rng ^= rng << 5; return rng; }
+
+static void run_edges(void) {
+    /* sign x {zero, denormal, smallest normal, 1.0, 1.5, around 2^23/2^31/2^32, largest IEEE,
+     * extended range (exponent 255)}, and integers around 0, 2^24, 2^31, 2^32 */
+    static const uint32_t edge[] = {
+        0x00000000, 0x00000001, 0x007FFFFF, 0x00800000, 0x3F000000, 0x3F7FFFFF, 0x3F800000, 0x3FC00000,
+        0x4B000000, 0x4B7FFFFF, 0x4EFFFFFF, 0x4F000000, 0x4F7FFFFF, 0x4F800000, 0x7F7FFFFF, 0x7F800000,
+        0x7F800001, 0x7FC00000, 0x7FFFFFFF, 0x00000002, 0x00FFFFFF, 0x01000000, 0x01000001, 0x0000FFFF};
+    const int n = (int)(sizeof edge / sizeof edge[0]);
+    for (int i8 = 0; i8 < 256; i8++) {
+        for (int s = 0; s < 2; s++)
+            for (int k = 0; k < n; k++) {
+                u128 a;
+                for (int i = 0; i < 4; i++) a._u32[i] = edge[(k + i * 7) % n] ^ (s ? 0x80000000u : 0);
+                check_all(a, i8);
+            }
+        for (int k = 0; k < 20000; k++) {
+            u128 a;
+            for (int i = 0; i < 4; i++) a._u32[i] = next();
+            check_all(a, i8);
+        }
+    }
+}
+
+int main(int argc, char** argv) {
+    if (argc > 1 && !strcmp(argv[1], "full")) {
+        for (uint64_t w = 0; w < (1ull << 32); w += 4) {
+            u128 a;
+            for (int i = 0; i < 4; i++) a._u32[i] = (uint32_t)(w + i);
+            check("cflts", spu_cflts(a, 173), spu_cflts_ref(a, 173), a, 173);
+            check("cfltu", spu_cfltu(a, 173), spu_cfltu_ref(a, 173), a, 173);
+            check("cflts", spu_cflts(a, 155), spu_cflts_ref(a, 155), a, 155);
+            check("cfltu", spu_cfltu(a, 155), spu_cfltu_ref(a, 155), a, 155);
+            check("csflt", spu_csflt(a, 155), spu_csflt_ref(a, 155), a, 155);
+            check("cuflt", spu_cuflt(a, 155), spu_cuflt_ref(a, 155), a, 155);
+        }
+    } else {
+        run_edges();
+#if defined(__aarch64__)
+        uint64_t fpcr; __asm__ volatile("mrs %0, fpcr" : "=r"(fpcr));
+        __asm__ volatile("msr fpcr, %0" :: "r"(fpcr | (3ull << 22) | (1ull << 24)));   /* RZ + FZ */
+        run_edges();
+        __asm__ volatile("msr fpcr, %0" :: "r"(fpcr));
+#endif
+    }
+    if (failed) { printf("%d mismatching lanes of %llu\n", failed, lanes); return 1; }
+    printf("OK: %llu lanes\n", lanes);
+    return 0;
+}
diff --git a/tools/test_spu_convert_vector.py b/tools/test_spu_convert_vector.py
new file mode 100644
index 00000000..3bd7bf93
--- /dev/null
+++ b/tools/test_spu_convert_vector.py
@@ -0,0 +1,29 @@
+#!/usr/bin/env python3
+"""The vector cflts/cfltu/csflt/cuflt (runtime/spu/spu_helpers.h) agree with the per-lane reference
+for every i8 on boundary and pseudo-random words; with the scalar helpers forced, too."""
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def main():
+    cc = shutil.which(os.environ.get("CC", "clang"))
+    assert cc, "C compiler required"
+    with tempfile.TemporaryDirectory() as tmp:
+        for defs in ([], ["-DSPU_SCALAR_HELPERS"]):
+            exe = Path(tmp) / "convert"
+            subprocess.run([cc, "-std=gnu17", "-O2", "-fwrapv", *defs, "-I", str(ROOT / "include"),
+                            "-I", str(ROOT / "runtime/spu"), "-I", str(ROOT / "runtime/platform"),
+                            str(ROOT / "runtime/spu/tests/test_spu_convert_vector.c"), "-o", str(exe)],
+                           check=True, capture_output=True, text=True)
+            p = subprocess.run([str(exe)], capture_output=True, text=True, timeout=120)
+            assert p.returncode == 0 and p.stdout.startswith("OK:"), (defs, p.stdout, p.stderr)
+    print("PASS: vector float conversions match the per-lane reference")
+
+
+if __name__ == "__main__":
+    main()
