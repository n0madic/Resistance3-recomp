@@ -0,0 +1,231 @@
+#!/usr/bin/env python3
+"""The SPU register cache (spu_regcache.py) must not change what lifted code computes.
+
+The fixture loops ten times: it stores its counter to local store and loads
+it back (an LS store is what made the compiler re-read every register from
+the context), adds it to r4, and calls a subroutine that adds 100 to r4 and
+counts the calls in r9. The caller's r4 must see the callee's write (reload
+after the call), the callee must see the caller's r4 (store-back before it),
+and the stop must see the final registers (store-back before leaving).
+The same program is lifted with and without the cache and both runs must
+match each other and the expected values. Only the looping caller is cached.
+
+Usage:
+    python3 tools/test_spu_lifter_regcache.py
+"""
+
+from __future__ import annotations
+
+import os
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parent
+RUNTIME = TOOLS.parent / 'runtime' / 'spu'
+sys.path.insert(0, str(TOOLS))
+
+from spu_disasm import disassemble_spu  # noqa: E402
+from spu_lifter import SPULifter  # noqa: E402
+import spu_regcache  # noqa: E402
+
+
+def ri16(op9: int, i16: int, rt: int) -> int:
+    return (op9 << 23) | ((i16 & 0xFFFF) << 7) | rt
+
+
+def ri10(op8: int, i10: int, ra: int, rt: int) -> int:
+    return (op8 << 24) | ((i10 & 0x3FF) << 14) | (ra << 7) | rt
+
+
+def rr(op11: int, rb: int, ra: int, rt: int) -> int:
+    return (op11 << 21) | (rb << 14) | (ra << 7) | rt
+
+
+PROGRAM = [
+    ri16(0x081, 0, 3),                    # 0x00 il   $3, 0
+    ri16(0x081, 0, 4),                    # 0x04 il   $4, 0
+    ri16(0x081, 0x1000, 1),               # 0x08 il   $1, 0x1000
+    ri10(0x24, 0, 1, 3),                  # 0x0C stqd $3, 0($1)       <- loop
+    ri10(0x34, 0, 1, 8),                  # 0x10 lqd  $8, 0($1)
+    rr(0x0C0, 8, 4, 4),                   # 0x14 a    $4, $4, $8
+    ri16(0x066, (0x30 - 0x18) >> 2, 0),   # 0x18 brsl $0, 0x30
+    ri10(0x1C, 1, 3, 3),                  # 0x1C ai   $3, $3, 1
+    ri10(0x7C, 10, 3, 6),                 # 0x20 ceqi $6, $3, 10
+    ri16(0x040, (0x0C - 0x24) >> 2, 6),   # 0x24 brz  $6, 0x0C
+    ri10(0x24, 1, 1, 4),                  # 0x28 stqd $4, 16($1)
+    0x00003FFF,                           # 0x2C stop 0x3FFF
+    ri10(0x1C, 100, 4, 4),                # 0x30 ai   $4, $4, 100   (subroutine)
+    ri10(0x1C, 1, 9, 9),                  # 0x34 ai   $9, $9, 1
+    rr(0x1A8, 0, 0, 0),                   # 0x38 bi   $0
+]
+BOUNDS = [(0x00, 0x30), (0x30, 0x3C)]
+
+DRIVER = r'''
+#include "lifted.h"
+#include <stdio.h>
+#include <stdlib.h>
+SPU_THREAD_LOCAL void (*g_spu_trampoline_fn)(spu_context*);
+volatile int g_spu_direct = 0;
+uint8_t g_spu_stack_reset_hint[1024];
+int g_spu_ls_watch_n = 0;   /* LS watch off */
+void spu_ls_watch_slow(uint32_t lsa, int is_write, const uint8_t* p, uint32_t pc, uint32_t lr)
+{ (void)lsa; (void)is_write; (void)p; (void)pc; (void)lr; }
+static uint8_t ls[256 * 1024];
+static int stopped;
+void spu_indirect_branch(spu_context* ctx) { (void)ctx; abort(); }
+void spu_register_function(uint32_t addr, void (*fn)(spu_context*)) { (void)addr; (void)fn; }
+void spu_img_restore(spu_context* ctx, int32_t saved) { (void)ctx; (void)saved; }
+void spu_stop(spu_context* ctx) { (void)ctx; stopped = 1; }
+void spu_drain_call(spu_context* ctx, uint32_t ret) {
+    (void)ret;
+    while (g_spu_trampoline_fn) {
+        void (*fn)(spu_context*) = g_spu_trampoline_fn;
+        g_spu_trampoline_fn = 0;
+        fn(ctx);
+    }
+}
+int main(void) {
+    static spu_context c;
+    c.ls = ls;
+    spu_func_00000000(&c);
+    spu_drain_call(&c, 0);
+    uint32_t w = (uint32_t)ls[0x1010] << 24 | (uint32_t)ls[0x1011] << 16 |
+                 (uint32_t)ls[0x1012] << 8 | ls[0x1013];
+    printf("%d %u %u %u %u\n", stopped, c.gpr[3]._u32[0], c.gpr[4]._u32[0],
+           c.gpr[9]._u32[0], w);
+    return 0;
+}
+'''
+
+# 10 iterations: r4 = (0 + 1 + ... + 9) + 10 * 100
+EXPECTED = ['1', '10', '1045', '10', '1045']
+
+
+def lift(regcache: bool, trace: bool = False) -> SPULifter:
+    insns = disassemble_spu(b''.join(struct.pack('>I', w) for w in PROGRAM), 0)
+    lifter = SPULifter(trace=trace)
+    lifter.regcache = regcache
+    lifter.func_starts = {s for s, _ in BOUNDS}
+    for s, e in BOUNDS:
+        lifter.lift_function(insns, s, e)
+    return lifter
+
+
+class RegisterCache(unittest.TestCase):
+    def test_cached_body_keeps_registers_in_locals(self) -> None:
+        src = lift(True).emit_source('lifted.h')
+        body = src[src.index('void spu_func_00000000('):]
+        body = body[:body.index('\n}\n')]
+        lines = body.split('\n')[2:]        # past the head and the locals' declaration
+        self.assertFalse([ln for ln in lines if 'ctx->gpr' in ln], body)
+        self.assertIn('SPU_RC_STORE; spu_func_00000030(ctx);', body)
+        self.assertIn('} SPU_RC_LOAD;', body)
+        self.assertIn('SPU_RC_STORE; spu_stop(ctx); return;', body.replace('ctx->stop_code = 0x3FFFu; '
+                                                               'ctx->status = SPU_STATUS_STOPPED_BY_STOP; ', ''))
+
+    def test_function_without_loop_is_left_alone(self) -> None:
+        src = lift(True).emit_source('lifted.h')
+        callee = src[src.index('void spu_func_00000030('):]
+        callee = callee[:callee.index('\n}\n')]
+        self.assertIn('ctx->gpr[4] = spu_ai(ctx->gpr[4], 100);', callee)
+        self.assertNotIn('S_4', callee)
+
+    def test_function_with_unexpected_shape_is_left_alone(self) -> None:
+        body = ['loc_00000000:', '    if (ctx->gpr[3]._u32[0]) {', '        ctx->gpr[4] = ctx->gpr[3];',
+                '    }', '    goto loc_00000000;']
+        self.assertIsNone(spu_regcache.transform_function(body))
+
+    def test_call_the_reload_may_not_follow_is_refused(self) -> None:
+        call = ('{ int32_t _si = (int32_t)ctx->image_id; ctx->host_depth++; spu_func_00000030(ctx); '
+                'spu_drain_call(ctx, 0x8u); ctx->host_depth--; spu_img_restore(ctx, _si); }')
+        for line in ('if (ctx->gpr[5]._u32[0] != 0) ' + call,                  # not on every path
+                     call + ' ctx->gpr[6] = ctx->gpr[3];',                     # a register after the call
+                     '{ spu_func_00000030(ctx); if (ctx->gpr[3]._u32[0]) goto loc_00000000; }'):
+            body = ['loc_00000000:', '    ctx->gpr[3] = spu_ai(ctx->gpr[3], 1);', '    ' + line,
+                    '    goto loc_00000000;']
+            self.assertIsNone(spu_regcache.transform_function(body), line)
+        body = ['loc_00000000:', '    ctx->gpr[3] = spu_ai(ctx->gpr[3], 1);', '    ' + call,
+                '    goto loc_00000000;']
+        self.assertIsNotNone(spu_regcache.transform_function(body))
+
+    def test_no_store_back_between_a_call_and_its_reload(self) -> None:
+        # the drain in the next block would otherwise store the stale locals over what the call left
+        body = ['loc_00000000:', '    ctx->gpr[3] = spu_ai(ctx->gpr[3], 1);',
+                '    { ctx->host_depth++; spu_func_00000030(ctx); } { spu_drain_call(ctx, 0x8u); ctx->host_depth--; }',
+                '    goto loc_00000000;']
+        _, out = spu_regcache.transform_function(body)
+        self.assertIn('    { ctx->host_depth++; SPU_RC_STORE; spu_func_00000030(ctx); } '
+                      '{ spu_drain_call(ctx, 0x8u); ctx->host_depth--; } SPU_RC_LOAD;', out)
+
+    def test_store_back_after_one_is_dropped_until_a_write_or_label(self) -> None:
+        body = ['loc_00000000:',
+                '    ctx->gpr[3] = spu_ai(ctx->gpr[3], 1);',
+                '    spu_wrch(ctx, MFC_LSA, ctx->gpr[3]);',       # a write since the label: store back
+                '    spu_wrch(ctx, MFC_EAL, ctx->gpr[3]);',       # nothing written since: none
+                '    ctx->gpr[4] = ctx->gpr[3];',
+                '    spu_wrch(ctx, MFC_Size, ctx->gpr[4]);',      # after a write: store back
+                'loc_00000014:',
+                '    spu_wrch(ctx, MFC_TagID, ctx->gpr[4]);',     # after a label: store back
+                '    goto loc_00000000;']
+        _, out = spu_regcache.transform_function(body)
+        flushed = [ln.strip().startswith('SPU_RC_STORE;') for ln in out if 'spu_wrch' in ln]
+        self.assertEqual(flushed, [True, False, True, True], out)
+
+    def test_comment_is_not_code(self) -> None:
+        body = ['loc_00000000:', '    ctx->gpr[3] = spu_ai(ctx->gpr[3], 1);',
+                '    /* x; y */ spu_wrch(ctx, MFC_LSA, ctx->gpr[3]);', '    goto loc_00000000;']
+        _, out = spu_regcache.transform_function(body)
+        self.assertIn('    SPU_RC_STORE; /* x; y */ spu_wrch(ctx, MFC_LSA, S_3);', out)
+
+    def test_trace_lift_is_not_cached(self) -> None:
+        src = lift(True, trace=True).emit_source('lifted.h')
+        self.assertNotIn('SPU_RC_STORE', src)
+        self.assertIn('spu_trace_rt(ctx, 4);', src)
+
+    def test_transform_is_idempotent(self) -> None:
+        src = lift(True).emit_source('lifted.h')
+        self.assertEqual(spu_regcache.transform_source(src)[0], src)
+        # without the marker the cached function itself is refused
+        again, stats = spu_regcache.transform_source(src.replace(spu_regcache.MARK + '\n', ''))
+        self.assertEqual(again, src)
+        self.assertEqual((stats['cached'], stats['skipped']), (0, 1))
+
+    def run_program(self, regcache: bool) -> list[str]:
+        cc = shutil.which('clang') or shutil.which('cc')
+        if not cc:
+            if os.environ.get('CI'):
+                self.fail('C compiler required in CI')
+            self.skipTest('C compiler unavailable')
+        lifter = lift(regcache)
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            context = (RUNTIME / 'spu_context.h').as_posix()
+            helpers = (RUNTIME / 'spu_helpers.h').as_posix()
+            (root / 'lifted.h').write_text(lifter.emit_header().replace(
+                '../../runtime/spu/spu_context.h', context))
+            (root / 'lifted.c').write_text(lifter.emit_source('lifted.h').replace(
+                '../../runtime/spu/spu_helpers.h', helpers))
+            (root / 'driver.c').write_text(DRIVER)
+            exe = root / ('proof.exe' if sys.platform == 'win32' else 'proof')
+            built = subprocess.run([cc, '-O2', '-fno-strict-aliasing', '-I', str(RUNTIME),
+                                    '-o', str(exe), str(root / 'lifted.c'), str(root / 'driver.c')],
+                                   capture_output=True, text=True)
+            self.assertEqual(built.returncode, 0, built.stderr)
+            ran = subprocess.run([str(exe)], capture_output=True, text=True, timeout=30)
+            self.assertEqual(ran.returncode, 0, ran.stderr)
+            return ran.stdout.split()
+
+    def test_uncached_program(self) -> None:
+        self.assertEqual(self.run_program(False), EXPECTED)
+
+    def test_cached_program(self) -> None:
+        self.assertEqual(self.run_program(True), EXPECTED)
+
+
+if __name__ == '__main__':
+    unittest.main()
