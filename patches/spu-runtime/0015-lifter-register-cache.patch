@@ -0,0 +1,273 @@
+#!/usr/bin/env python3
+"""Register cache for lifted SPU functions.
+
+The lifter writes every SPU register access as ctx->gpr[n]. Local-store stores
+go through ctx->ls (bytes), and with -fno-strict-aliasing every store may alias
+the context, so the compiler re-reads each register from ctx after every LS
+store and writes each result back at once: the code moves through memory.
+
+This pass gives each function with a loop local copies (S_n) of the registers
+it names (see has_loop for why only those):
+  - entry: S_n = ctx->gpr[n] for every register the function uses;
+  - writes and reads use S_n only;
+  - before a statement that hands ctx to code that may read the registers
+    (a lifted function, the drain, spu_indirect_branch, stop/halt, the channel
+    ops, SPU_DIRECT / SPU_RET, any return) the registers the function writes
+    are stored back (SPU_RC_STORE);
+  - at the end of a line with a statement that may run other SPU code (a
+    lifted function call, spu_drain_call, spu_indirect_branch) every register
+    the function uses is re-read (SPU_RC_LOAD).
+LS reads/writes (spu_ls_read128/spu_ls_write128 ...) and spu_img_restore only
+look at ctx->ls / image state and need neither. Code that reads ctx->gpr by
+itself between store-backs sees the values of the last one: the LS
+diagnostics (SPU_LS_WATCH prints r0, SPU_LS_LOWREAD r1-r4). spu_trace_rt does
+too, so the lifter does not cache a --trace lift.
+
+The lifter emits one complete statement per body line (balanced braces, no
+else, no switch), and a call that may run SPU code sits in plain blocks with
+no register access or goto after it on its line, so the reload at the end of
+the line follows the call on every path. A function with anything else is
+left as it is.
+
+Idea: the Resistance 2 port's spu_regcache.py / spu_writeback.py (MIT,
+github.com/miroslavdanutalexandru-alt/Resistance2Port); this is a separate
+implementation over this lifter's output.
+
+  spu_regcache.py in.c [out.c]     (out defaults to in)
+"""
+from __future__ import annotations
+
+import logging
+import re
+import sys
+
+LOG = logging.getLogger(__name__)
+
+STORE = 'SPU_RC_STORE'          # macro: the registers the function writes, back to ctx
+LOAD = 'SPU_RC_LOAD'            # macro: every register the function uses, from ctx
+STORE_STMT = STORE + '; '
+FHEAD = re.compile(r'^void (\w+)\(spu_context\* ctx\) \{$')
+GPR = re.compile(r'ctx->gpr\[(\d+)\]')
+GPR_WRITE = re.compile(r'ctx->gpr\[(\d+)\]\s*=(?!=)')
+# Statements that let other code see the context's registers: store back first.
+FLUSH = re.compile(r'\breturn\b|\bSPU_DIRECT\(|\bSPU_RET(?:_REG)?\(|\bspu_(?:stop|halt|wrch|rdch|rchcnt|'
+                   r'indirect_branch|drain_call)\(|\b(?:\w+_)?spu_func_[0-9A-Fa-f]+\(ctx\)')
+# Statements after which the registers may have changed: re-read.
+CLOBBER = re.compile(r'\bspu_(?:indirect_branch|drain_call)\(|\b(?:\w+_)?spu_func_[0-9A-Fa-f]+\(ctx\)')
+# Shapes the pass does not handle: a register by address or computed index, the
+# pass's own names (an already cached function), compound and lane writes.
+UNHANDLED = re.compile(rf'&\s*ctx->gpr|ctx->gpr(?!\[\d+\])|\bS_\d+\b|\b(?:{STORE}|{LOAD})\b'
+                       r'|ctx->gpr\[\d+\](?:\.\w+\[\d+\])?\s*(?:\+\+|--|[-+*/|&^%]=|<<=|>>=)'
+                       r'|ctx->gpr\[\d+\]\.\w+\[\d+\]\s*=(?!=)')
+NON_CODE = re.compile(r'/\*.*?\*/|"(?:\\.|[^"\\])*"')
+MARK = '/* spu regcache */'
+LABEL = re.compile(r'^(loc_[0-9A-Fa-f]+):')
+GOTO = re.compile(r'\bgoto (loc_[0-9A-Fa-f]+);')
+
+
+def _code(line: str) -> str:
+    """The line with its comments and string literals blanked (same length),
+    so a ; or a brace in them is not taken for code."""
+    return NON_CODE.sub(lambda m: ' ' * len(m.group()), line)
+
+
+def _stmt_start(code: str, pos: int) -> int:
+    """Index where the statement holding `pos` starts (after the last ; { or }
+    outside parentheses before it)."""
+    depth = 0
+    start = 0
+    for i in range(pos):
+        c = code[i]
+        if c == '(':
+            depth += 1
+        elif c == ')':
+            depth -= 1
+        elif depth == 0 and c in ';{}':
+            start = i + 1
+    return start
+
+
+def _in_plain_blocks(code: str, pos: int) -> bool:
+    """Every brace block open at `pos` is a plain one (not the body of an if,
+    a loop or an else), so a statement there runs whenever the line does."""
+    depth = 0
+    plain: list[bool] = []
+    for i in range(pos):
+        c = code[i]
+        if c == '(':
+            depth += 1
+        elif c == ')':
+            depth -= 1
+        elif depth == 0 and c == '{':
+            before = code[:i].rstrip()
+            plain.append(not before or before[-1] in ';{}')
+        elif depth == 0 and c == '}':
+            if not plain:
+                return False
+            plain.pop()
+    return all(plain)
+
+
+def _reload_follows_calls(code: str) -> bool:
+    """The reload at the end of the line runs after every call on it that may
+    run SPU code, and nothing from the first such call on reads or writes a
+    register or jumps (the locals are stale until the reload)."""
+    calls = list(CLOBBER.finditer(code))
+    if not all(_in_plain_blocks(code, m.start()) for m in calls):
+        return False
+    return not re.search(r'ctx->gpr|\bgoto\b', code[calls[0].end():])
+
+
+def _insert_flushes(line: str) -> str:
+    """Put a store-back before each statement on this line that matches FLUSH.
+    A statement in the same brace block as the previous flushed one, with no
+    register write between them, needs none of its own (extra store-backs are
+    only redundant). None goes after a call that may run SPU code: the locals
+    are stale until the reload at the end of the line, and storing them back
+    would undo what the call left in ctx."""
+    code = _code(line)
+    first_call = min((m.start() for m in CLOBBER.finditer(code)), default=len(code))
+    starts = sorted({_stmt_start(code, m.start()) for m in FLUSH.finditer(code)})
+    keep: list[int] = []
+    for s in starts:
+        if s > first_call:
+            break
+        if keep:
+            seg = code[keep[-1]:s]
+            if '{' not in seg and '}' not in seg and not GPR_WRITE.search(seg):
+                continue
+        keep.append(s)
+    for s in reversed(keep):
+        while s < len(line) and line[s] == ' ':
+            s += 1
+        line = line[:s] + STORE_STMT + line[s:]
+    return line
+
+
+def has_loop(body: list[str]) -> bool:
+    """A goto back to a label above it. Only loops gain: a straight chunk
+    loads every register it names on entry and stores back every one it
+    writes on each exit, which costs about what it saves (Resistance 3: a
+    chunk with five exits ran the same, and caching every function grew the
+    lifted SPU code by 61%)."""
+    seen: set[str] = set()
+    for ln in body:
+        m = LABEL.match(ln)
+        if m:
+            seen.add(m.group(1))
+        for g in GOTO.findall(ln):
+            if g in seen:
+                return True
+    return False
+
+
+def transform_function(body: list[str]) -> tuple[list[str], list[str]] | None:
+    """body: the lines between the function's '{' and '}' lines. Returns None
+    for a shape the pass does not handle, else (the store-back and reload macro
+    lines, the new body)."""
+    text = '\n'.join(body)
+    used = sorted({int(n) for n in GPR.findall(text)})
+    written = sorted({int(n) for n in GPR_WRITE.findall(text)})
+    if not used or UNHANDLED.search(text):
+        return None
+    for ln in body:
+        code = _code(ln).strip()
+        if code.count('{') != code.count('}') or code.count('(') != code.count(')'):
+            return None
+        if re.match(r'(else|switch|case|default)\b', code):
+            return None
+        if CLOBBER.search(code) and not _reload_follows_calls(code):
+            return None
+
+    out = ['    u128 ' + ', '.join(f'S_{n} = ctx->gpr[{n}]' for n in used) + ';']
+    # clean: the locals equal the context (entry, after a store-back at the
+    # start of a line or a reload, with no register write since). A label
+    # ends it: other paths may arrive there with written locals.
+    clean = True
+    for ln in body:
+        if not ln.strip():
+            out.append(ln)
+            continue
+        if ln.rstrip().endswith(':'):
+            out.append(ln)
+            clean = False
+            continue
+        code = _code(ln)
+        new = _insert_flushes(ln) if written and FLUSH.search(code) else ln
+        lead = len(new) - len(new.lstrip(' '))
+        flush_first = new.startswith(STORE_STMT, lead)
+        if clean and flush_first:
+            new = new[:lead] + new[lead + len(STORE_STMT):]
+        new = GPR.sub(r'S_\1', new)
+        if CLOBBER.search(code):
+            new = f'{new.rstrip()} {LOAD};'
+            clean = True
+        elif flush_first or clean:
+            clean = not GPR_WRITE.search(ln)
+        out.append(new)
+    store = ' '.join(f'ctx->gpr[{n}] = S_{n};' for n in written)
+    load = ' '.join(f'S_{n} = ctx->gpr[{n}];' for n in used)
+    # falling off the end of the function: store back
+    out.append(f'    {STORE};')
+    return ([f'#define {STORE} do {{ {store} }} while (0)', f'#define {LOAD} do {{ {load} }} while (0)'], out)
+
+
+def transform_source(src: str) -> tuple[str, dict[str, int]]:
+    if MARK in src:
+        return src, {'already': 1}
+    lines = src.split('\n')
+    res: list[str] = []
+    stats = {'cached': 0, 'unchanged': 0, 'skipped': 0}
+    i = 0
+    while i < len(lines):
+        ln = lines[i]
+        if not FHEAD.match(ln):
+            res.append(ln)
+            i += 1
+            continue
+        j = i + 1
+        while j < len(lines) and lines[j] != '}':
+            j += 1
+        body = lines[i + 1:j]
+        if not has_loop(body) or not any(GPR.search(ln) for ln in body):
+            stats['unchanged'] += 1
+            res.extend(lines[i:j + 1])
+        elif (r := transform_function(body)) is None:
+            stats['skipped'] += 1
+            res.extend(lines[i:j + 1])
+        else:
+            defs, nb = r
+            stats['cached'] += 1
+            res.extend(defs)
+            res.append(ln)
+            res.extend(nb)
+            res.append('}')
+            res.append(f'#undef {STORE}')
+            res.append(f'#undef {LOAD}')
+        i = j + 1
+    out = '\n'.join(res)
+    k = out.find('#include')
+    if k >= 0:
+        e = out.find('\n', k) + 1
+        out = out[:e] + MARK + '\n' + out[e:]
+    return out, stats
+
+
+def main(argv: list[str]) -> int:
+    logging.basicConfig(level=logging.INFO, format='%(message)s')
+    if len(argv) < 2:
+        LOG.error('usage: spu_regcache.py in.c [out.c]')
+        return 2
+    inp = argv[1]
+    outp = argv[2] if len(argv) > 2 else inp
+    with open(inp, encoding='utf-8', errors='surrogateescape') as f:
+        src = f.read()
+    out, stats = transform_source(src)
+    with open(outp, 'w', encoding='utf-8', errors='surrogateescape') as f:
+        f.write(out)
+    LOG.info('%s %s', inp, stats)
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main(sys.argv))
