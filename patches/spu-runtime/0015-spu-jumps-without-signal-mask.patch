diff --git a/runtime/spu/tests/test_spu_lifted_start.c b/runtime/spu/tests/test_spu_lifted_start.c
index f0219fc..83ce467 100644
--- a/runtime/spu/tests/test_spu_lifted_start.c
+++ b/runtime/spu/tests/test_spu_lifted_start.c
@@ -1305,2 +1305,24 @@ static void test_indirect_fast_path_guards(void)
 
+/* The halt's jump out of lifted code leaves the signal mask as the code left it: saving and
+ * restoring it cost a sigprocmask system call per jump on Darwin (spu_channels.c, SPU_SETJMP). */
+static void sm_block_and_halt(spu_context* ctx)
+{
+    sigset_t s; sigemptyset(&s); sigaddset(&s, SIGUSR2);
+    pthread_sigmask(SIG_BLOCK, &s, NULL);
+    spu_halt(ctx);
+}
+static void test_halt_leaves_signal_mask(void)
+{
+    spu_context* ctx = (spu_context*)calloc(1, sizeof *ctx);
+    if (!ctx) { check(0, "allocate signal mask context"); return; }
+    spu_context_init(ctx, 0);
+    sigset_t before, after, s;
+    sigemptyset(&s); sigaddset(&s, SIGUSR2);
+    pthread_sigmask(SIG_UNBLOCK, &s, &before);
+    check(spu_run_with_halt(sm_block_and_halt, ctx) == 1, "signal mask: the run halted");
+    pthread_sigmask(SIG_SETMASK, &before, &after);
+    check(sigismember(&after, SIGUSR2) == 1, "signal mask: the halt does not restore it");
+    free(ctx);
+}
+
 int main(void)
@@ -1330,2 +1352,3 @@ int main(void)
     test_nonzero_link_return();
+    test_halt_leaves_signal_mask();
 
