+#define PADKEY_F SDL_SCANCODE_F
+#define PADKEY_G SDL_SCANCODE_G
+#define PADKEY_H SDL_SCANCODE_H
 #endif
@@ -265,3 +298,8 @@ static void pad_poll_keyboard(void)
         { PADKEY_RETURN, CELL_PAD_CTRL_START },   { PADKEY_TAB,   CELL_PAD_CTRL_SELECT },
+        { PADKEY_C,      CELL_PAD_CTRL_L3 },      { PADKEY_V,     CELL_PAD_CTRL_R3 },
