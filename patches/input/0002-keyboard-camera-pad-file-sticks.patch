         if (pad_key_down(map[i].vk)) btns |= map[i].btn;
+    u16 arrows = btns & dpad_bits;
+    if (arrows_stick_only) {
+        btns &= (u16)~dpad_bits;
+        if (pad_key_down(dpad_keys[0])) btns |= CELL_PAD_CTRL_UP;
+        if (pad_key_down(dpad_keys[1])) btns |= CELL_PAD_CTRL_DOWN;
