+    static const int dpad_keys[4] = { PADKEY_T, PADKEY_G, PADKEY_F, PADKEY_H };   /* up, down, left, right */
+    static const u16 dpad_bits = CELL_PAD_CTRL_UP | CELL_PAD_CTRL_DOWN | CELL_PAD_CTRL_LEFT | CELL_PAD_CTRL_RIGHT;
+    static int arrows_stick_only = -1;
