diff --git a/libs/input/pad_keymap.h b/libs/input/pad_keymap.h
new file mode 100644
index 00000000..9f267f3f
--- /dev/null
+++ b/libs/input/pad_keymap.h
@@ -0,0 +1,59 @@
+/*
+ * ps3recomp - the keyboard fallback's shooter layout as a table the host can replace
+ *
+ * PAD_KEYBOARD_LAYOUT=fps (cellPad.c) reads its keys, mouse buttons and wheel through a table of bindings: a source
+ * (a key, a mouse button, one way of the wheel) that presses an action (a pad button, a direction of the left stick, or
+ * a button that depends on whether a menu is up). cellPad.c carries a built-in table, the layout described there. A
+ * host that lets the player remap starts from cellPad_default_key_bindings, changes what it wants and hands the whole
+ * table back with cellPad_set_key_bindings, before the first poll.
+ *
+ * Plain C, no system headers: cellPad.c cannot include them (see the macOS keyboard block there).
+ */
+#ifndef PS3RECOMP_PAD_KEYMAP_H
+#define PS3RECOMP_PAD_KEYMAP_H
+
+#include "pad_mouse.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* What a binding reads (PadBinding.src) and what its code is. */
+#define PAD_SRC_KEY    1   /* a key: the host's key code, the one cellPad.c's pad_key_down takes
+                            * (macOS virtual key codes, SDL scancodes, Windows VK codes) */
+#define PAD_SRC_MOUSE  2   /* a mouse button: PAD_MOUSE_LEFT, PAD_MOUSE_RIGHT or PAD_MOUSE_MIDDLE */
+#define PAD_SRC_WHEEL  3   /* a wheel click, held for a moment so a title polling slowly sees it: +1 away from the
+                            * user, -1 toward, 0 either way */
+
+/* What a binding presses (PadBinding.action): a CELL_PAD_CTRL_* bit (the low 16 bits), or one of these. */
+#define PAD_ACT_MOVE_LEFT   0x00010000u   /* the left stick, to the left ... */
+#define PAD_ACT_MOVE_RIGHT  0x00020000u
+#define PAD_ACT_MOVE_UP     0x00040000u   /* ... and forward */
+#define PAD_ACT_MOVE_DOWN   0x00080000u   /* ... and back; opposite directions cancel */
+#define PAD_ACT_CONFIRM     0x00100000u   /* CROSS while a menu is up (cellPad_set_menu_query), START otherwise */
+#define PAD_ACT_BACK        0x00200000u   /* CIRCLE while a menu is up, START otherwise */
+/* Either of the two keeps the button it got when the key went down until the key is released: Esc pauses, the pause
+ * menu opens while it is still held, and it must not turn into CIRCLE there and close the menu again. */
+
+#define PAD_BINDINGS_MAX 128
+
+typedef struct PadBinding {
+    int      src;      /* PAD_SRC_* */
+    int      code;     /* what it is: see the source */
+    unsigned action;   /* CELL_PAD_CTRL_* or PAD_ACT_* */
+} PadBinding;
+
+/* Copies the built-in table to out[0..max) and returns its size (all of it, even when max is smaller; out may be NULL
+ * to ask only for the size). */
+int cellPad_default_key_bindings(PadBinding* out, int max);
+
+/* Replaces the table with the n bindings of b, copied; at most PAD_BINDINGS_MAX of them are taken, and one with an
+ * unknown source or no action is skipped. NULL or n < 0 goes back to the built-in table. Call before the title polls
+ * the pad: the table is not locked. */
+void cellPad_set_key_bindings(const PadBinding* b, int n);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_PAD_KEYMAP_H */
