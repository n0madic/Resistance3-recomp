+/* The table of bindings: the built-in one can be copied out, a host's replaces it whole (skipping entries that name
+ * no source or no action), the aim scale follows L1 wherever it is bound, and NULL brings the built-in one back. */
+static void test_bindings(void)
+{
+    PadHostState hs;
+    memset(&hs, 0, sizeof hs);
+    memset(s_keys, 0, sizeof s_keys);
+
+    PadBinding def[PAD_BINDINGS_MAX];
+    const int nd = cellPad_default_key_bindings(NULL, 0);
+    assert(nd > 20 && nd <= PAD_BINDINGS_MAX);
+    assert(cellPad_default_key_bindings(def, PAD_BINDINGS_MAX) == nd);
+    assert(cellPad_default_key_bindings(def, 3) == nd);                 /* the whole size, 3 copied */
+    int w = 0;
+    for (int i = 0; i < nd; i++)
+        if (def[i].src == PAD_SRC_KEY && def[i].code == PADKEY_W && def[i].action == PAD_ACT_MOVE_UP) w++;
+    assert(w == 1);
+
+    const PadBinding mine[] = {
+        { PAD_SRC_KEY, PADKEY_Z, CELL_PAD_CTRL_CROSS },
+        { PAD_SRC_KEY, PADKEY_I, PAD_ACT_MOVE_UP },    { PAD_SRC_KEY, PADKEY_UP, PAD_ACT_MOVE_UP },   /* two keys */
+        { PAD_SRC_KEY, PADKEY_K, PAD_ACT_MOVE_DOWN },
+        { PAD_SRC_MOUSE, PAD_MOUSE_LEFT, CELL_PAD_CTRL_L2 },
+        { PAD_SRC_WHEEL, 1, CELL_PAD_CTRL_SQUARE },    { PAD_SRC_WHEEL, -1, CELL_PAD_CTRL_TRIANGLE },
+        { PAD_SRC_KEY, PADKEY_X, CELL_PAD_CTRL_L1 },
+        { 0, PADKEY_C, CELL_PAD_CTRL_L3 },                                /* no source: skipped */
+        { PAD_SRC_KEY, PADKEY_V, 0 },                                     /* no action: skipped */
+    };
+    cellPad_set_key_bindings(mine, (int)(sizeof mine / sizeof mine[0]));
+
+    s_keys[PADKEY_SPACE] = s_keys[PADKEY_W] = s_keys[PADKEY_C] = s_keys[PADKEY_V] = 1;   /* none of them is bound */
+    s_mouse.buttons = PAD_MOUSE_RIGHT | PAD_MOUSE_MIDDLE;
+    assert(pad_keyboard_fps(&hs) == 0 && hs.analog_ly == 128);
+    memset(s_keys, 0, sizeof s_keys);
+
+    s_keys[PADKEY_Z] = 1;
+    assert(pad_keyboard_fps(&hs) == CELL_PAD_CTRL_CROSS);
+    memset(s_keys, 0, sizeof s_keys);
+    s_keys[PADKEY_UP] = 1;                                              /* a key can be the stick and not the d-pad */
+    assert(pad_keyboard_fps(&hs) == 0 && hs.analog_ly == 0);
+    s_keys[PADKEY_K] = 1;                                               /* forward and back cancel */
+    assert(pad_keyboard_fps(&hs) == 0 && hs.analog_ly == 128);
+    memset(s_keys, 0, sizeof s_keys);
+    s_keys[PADKEY_I] = 1;
+    pad_keyboard_fps(&hs);
+    assert(hs.analog_ly == 0 && hs.analog_lx == 128);
+    memset(s_keys, 0, sizeof s_keys);
+
+    s_mouse.buttons = PAD_MOUSE_LEFT | PAD_MOUSE_RIGHT;                 /* the left button is L2 now, R1 is gone */
+    assert(pad_keyboard_fps(&hs) == CELL_PAD_CTRL_L2);
+    s_mouse.wheel = 1;                                                  /* a wheel direction of its own */
+    assert(pad_keyboard_fps(&hs) == CELL_PAD_CTRL_SQUARE);
+    sleep_s(PAD_MOUSE_WHEEL_HOLD_S + 0.02);
+    s_mouse.wheel = -1;
