diff --git a/libs/input/pad_mouse.h b/libs/input/pad_mouse.h
new file mode 100644
index 00000000..5029b9c8
--- /dev/null
+++ b/libs/input/pad_mouse.h
@@ -0,0 +1,39 @@
+/*
+ * ps3recomp - host mouse for the cellPad keyboard fallback
+ *
+ * The keyboard fallback's shooter layout (PAD_KEYBOARD_LAYOUT=fps in cellPad.c)
+ * turns mouse motion into right-stick deflection and the mouse buttons into pad
+ * buttons. This is the host side of it: relative motion with the cursor held in
+ * the game window. Implemented for macOS in pad_mouse_macos.m; other hosts have
+ * no mouse yet and cellPad.c compiles a stub there.
+ *
+ * Plain C on purpose: cellPad.c cannot include the system headers (see the
+ * macOS keyboard block there).
+ */
+#ifndef PS3RECOMP_PAD_MOUSE_H
+#define PS3RECOMP_PAD_MOUSE_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define PAD_MOUSE_LEFT   1u
+#define PAD_MOUSE_RIGHT  2u
+#define PAD_MOUSE_MIDDLE 4u
+
+typedef struct PadMouseInput {
+    double   dx, dy;    /* motion since the previous call, in points; +x right, +y down */
+    int      wheel;     /* wheel clicks since the previous call; + = away from the user */
+    unsigned buttons;   /* PAD_MOUSE_* held now */
+} PadMouseInput;
+
+/* Captures the mouse while `capture` is non-zero (cursor hidden and held over the
+ * game window) and releases it otherwise. Fills `out` with what happened since the
+ * previous call; all zero while released. Safe to call from any thread. */
+void pad_mouse_poll(int capture, PadMouseInput* out);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_PAD_MOUSE_H */
diff --git a/libs/input/pad_mouse_macos.m b/libs/input/pad_mouse_macos.m
new file mode 100644
index 00000000..ce813017
--- /dev/null
+++ b/libs/input/pad_mouse_macos.m
@@ -0,0 +1,136 @@
+/*
+ * ps3recomp - host mouse for the cellPad keyboard fallback, macOS
+ *
+ * A local NSEvent monitor sees the mouse events the RSX backend's message pump
+ * hands to NSApp. While captured, the cursor is hidden and detached from the
+ * mouse (CGAssociateMouseAndMouseCursorPosition), so it stays over the game
+ * window and mouse events carry only motion in deltaX/deltaY -- the way SDL's
+ * relative mode works on macOS. Capture follows what cellPad asks for on every
+ * poll: on while this process is in the foreground, off when it is not, so
+ * Cmd+Tab gives the cursor back.
+ *
+ * The monitor and the cursor live on the main thread; the pad polls from a guest
+ * thread. They share the accumulators under a lock.
+ */
+#import <AppKit/AppKit.h>
+#include <os/lock.h>
+#include <stdatomic.h>
+
+#include "pad_mouse.h"
+
+/* Trackpads report the wheel in points, not clicks: this many make one click. */
+#define PAD_MOUSE_PRECISE_POINTS_PER_CLICK 12.0
+/* A capture asked for while no window is key yet (start-up) is asked for again this often. */
+#define PAD_MOUSE_RETRY_S 0.5
+
+static os_unfair_lock s_lock = OS_UNFAIR_LOCK_INIT;
+static double   s_dx, s_dy, s_wheel;   /* under s_lock */
+static unsigned s_buttons;             /* under s_lock: pressed while captured */
+
+static atomic_int s_captured;          /* written on the main thread */
+static id         s_monitor;           /* main thread */
+
+static unsigned button_bit(NSEvent* ev)
+{
+    switch ([ev buttonNumber]) {
+    case 0:  return PAD_MOUSE_LEFT;
+    case 1:  return PAD_MOUSE_RIGHT;
+    case 2:  return PAD_MOUSE_MIDDLE;
+    default: return 0;
+    }
+}
+
+static void install_monitor(void)
+{
+    const NSEventMask mask =
+        NSEventMaskMouseMoved | NSEventMaskLeftMouseDragged | NSEventMaskRightMouseDragged |
+        NSEventMaskOtherMouseDragged | NSEventMaskLeftMouseDown | NSEventMaskLeftMouseUp |
+        NSEventMaskRightMouseDown | NSEventMaskRightMouseUp | NSEventMaskOtherMouseDown |
+        NSEventMaskOtherMouseUp | NSEventMaskScrollWheel;
+    s_monitor = [NSEvent addLocalMonitorForEventsMatchingMask:mask handler:^NSEvent*(NSEvent* ev) {
+        const int captured = atomic_load(&s_captured);
+        os_unfair_lock_lock(&s_lock);
+        switch ([ev type]) {
+        case NSEventTypeLeftMouseDown:
+        case NSEventTypeRightMouseDown:
+        case NSEventTypeOtherMouseDown:
+            /* The click that brings the window to the front is not a shot. */
+            if (captured) s_buttons |= button_bit(ev);
+            break;
+        case NSEventTypeLeftMouseUp:
+        case NSEventTypeRightMouseUp:
+        case NSEventTypeOtherMouseUp:
+            s_buttons &= ~button_bit(ev);
+            break;
+        case NSEventTypeScrollWheel:
+            if (captured)
+                s_wheel += [ev hasPreciseScrollingDeltas]
+                         ? [ev scrollingDeltaY] / PAD_MOUSE_PRECISE_POINTS_PER_CLICK
+                         : [ev scrollingDeltaY];
+            break;
+        default:   /* moved / dragged */
+            if (captured) { s_dx += [ev deltaX]; s_dy += [ev deltaY]; }
+            break;
+        }
+        os_unfair_lock_unlock(&s_lock);
+        return ev;
+    }];
+}
+
+static void set_capture(int on)
+{
+    if (on == atomic_load(&s_captured)) return;
+    if (on) {
+        NSWindow* w = [NSApp keyWindow];
+        if (!w) return;   /* asked again after PAD_MOUSE_RETRY_S */
+        if (!s_monitor) install_monitor();
+        [w setAcceptsMouseMovedEvents:YES];
+        /* Park the cursor in the middle of the window first: detached, it stays
+         * where it is, and clicks land wherever that is. Quartz global
+         * coordinates start at the top left of the primary screen. */
+        const NSRect r = [w convertRectToScreen:[[w contentView] frame]];
+        const CGFloat top = NSMaxY([[NSScreen screens][0] frame]);
+        CGWarpMouseCursorPosition(CGPointMake(NSMidX(r), top - NSMidY(r)));
+        CGAssociateMouseAndMouseCursorPosition(false);
+        [NSCursor hide];
+        os_unfair_lock_lock(&s_lock);
+        s_dx = s_dy = s_wheel = 0;
+        s_buttons = 0;
+        os_unfair_lock_unlock(&s_lock);
+    } else {
+        CGAssociateMouseAndMouseCursorPosition(true);
+        [NSCursor unhide];
+        os_unfair_lock_lock(&s_lock);
+        s_buttons = 0;
+        os_unfair_lock_unlock(&s_lock);
+    }
+    atomic_store(&s_captured, on);
+}
+
+void pad_mouse_poll(int capture, PadMouseInput* out)
+{
+    static atomic_int s_asked = -1;    /* the last request sent to the main thread */
+    static double     s_asked_at;
+    capture = capture != 0;
+    const double now = [NSProcessInfo processInfo].systemUptime;
+    if (capture != atomic_load(&s_captured) &&
+        (capture != atomic_load(&s_asked) || now - s_asked_at >= PAD_MOUSE_RETRY_S)) {
+        atomic_store(&s_asked, capture);
+        s_asked_at = now;
+        dispatch_async(dispatch_get_main_queue(), ^{ set_capture(capture); });
+    }
+
+    os_unfair_lock_lock(&s_lock);
+    out->dx = s_dx;
+    out->dy = s_dy;
+    out->wheel = (int)s_wheel;           /* whole clicks; the rest waits for more */
+    s_wheel -= out->wheel;
+    out->buttons = s_buttons;
+    s_dx = s_dy = 0;
+    os_unfair_lock_unlock(&s_lock);
+    if (!atomic_load(&s_captured)) {
+        out->dx = out->dy = 0;
+        out->wheel = 0;
+        out->buttons = 0;
+    }
+}
