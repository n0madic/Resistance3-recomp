+
+static double pad_now_s(void)
+{
+#ifdef _WIN32
+    return (double)GetTickCount64() / 1000.0;
+#else
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (double)ts.tv_sec + (double)ts.tv_nsec / 1e9;
+#endif
+}
+
+/* Mouse look for the fps layout. A title turns the view at a rate that is some
+ * function of the stick's deflection, usually with a dead zone and a curve.
+ * PAD_MOUSE_CURVE_X / PAD_MOUSE_CURVE_Y describe that function as points
+ * "deflection:rate,..." (deflection 0-127 from the centre, increasing; rate in
+ * any unit per second, non-decreasing, the first one 0), and PAD_MOUSE_SENS is
+ * that unit per point of mouse motion. Each poll the stick gets the deflection
+ * whose rate matches the mouse's speed since the previous poll, so the view
+ * turns by PAD_MOUSE_SENS per point -- up to the title's top rate, which a stick
+ * cannot exceed. Without a curve the stick is linear and full at
+ * PAD_MOUSE_DEFAULT_FULL_RATE points per second. */
+#define PAD_MOUSE_MAX_POINTS        32
+#define PAD_MOUSE_DEFAULT_FULL_RATE 1000.0
+/* The mouse's speed is its motion over the time since the previous poll, with
+ * that time clamped: two polls close together must not turn a twitch into a
+ * full deflection, and a title that stopped polling for a while (loading) must
+ * not see the motion spread over seconds as a crawl. */
+#define PAD_MOUSE_MIN_DT_S          0.008
+#define PAD_MOUSE_MAX_DT_S          0.1
+/* A wheel click holds TRIANGLE this long, so a title polling at a few frames a
+ * second still sees it. */
+#define PAD_MOUSE_WHEEL_HOLD_S      0.1
+
+typedef struct {
+    int    n;
+    double defl[PAD_MOUSE_MAX_POINTS];
+    double rate[PAD_MOUSE_MAX_POINTS];
+} PadStickCurve;
+
+/* Parses "deflection:rate,..."; 0 (and *c untouched) if it is not a valid curve. */
+static int pad_curve_parse(const char* s, PadStickCurve* c)
+{
+    PadStickCurve t;
+    t.n = 0;
+    while (s && *s) {
+        char* end;
+        const double d = strtod(s, &end);
+        if (end == s || *end != ':') return 0;
+        s = end + 1;
+        const double r = strtod(s, &end);
+        if (end == s || t.n == PAD_MOUSE_MAX_POINTS) return 0;
+        if (d < 0 || d > 127 || r < 0) return 0;
+        if (t.n == 0 ? r != 0 : (d <= t.defl[t.n - 1] || r < t.rate[t.n - 1])) return 0;
+        t.defl[t.n] = d;
+        t.rate[t.n] = r;
+        t.n++;
+        s = end;
+        while (*s == ',' || *s == ' ') s++;
+    }
+    if (t.n < 2 || t.rate[t.n - 1] <= 0) return 0;
+    *c = t;
+    return 1;
+}
+
+/* The deflection (0-127) at which the curve turns at `rate` (>= 0); the last
+ * point's beyond the top rate. No motion is the centre, not the dead zone's edge. */
+static double pad_curve_deflection(const PadStickCurve* c, double rate)
+{
+    if (rate <= 0) return 0;
+    for (int i = 1; i < c->n; i++) {
+        if (rate <= c->rate[i]) {
+            const double span = c->rate[i] - c->rate[i - 1];
+            const double f = span > 0 ? (rate - c->rate[i - 1]) / span : 1.0;
+            return c->defl[i - 1] + f * (c->defl[i] - c->defl[i - 1]);
+        }
+    }
+    return c->defl[c->n - 1];
+}
+
+/* -127..127 from the centre -> the stick byte; full left is 0, full right 255. */
+static u8 pad_stick_byte(double defl)
+{
+    const double v = defl < 0 ? 128.0 + defl * (128.0 / 127.0) : 128.0 + defl;
+    const long b = lround(v);
+    return (u8)(b < 0 ? 0 : b > 255 ? 255 : b);
+}
+
+static void pad_mouse_curve_env(const char* name, PadStickCurve* c)
+{
+    c->n = 2;
+    c->defl[0] = 0;   c->rate[0] = 0;
+    c->defl[1] = 127; c->rate[1] = PAD_MOUSE_DEFAULT_FULL_RATE;
+    const char* e = getenv(name);
+    if (e && *e && !pad_curve_parse(e, c))
+        printf("[cellPad] %s=\"%s\" is not a curve (\"deflection:rate,...\", both increasing, "
+               "first rate 0): the stick stays linear\n", name, e);
+}
+
+/* Mouse motion `dx`, `dy` (points) over `dt` seconds -> right stick. */
+static void pad_mouse_stick(double dx, double dy, double dt, u8* rx, u8* ry)
+{
+    static int init;
+    static PadStickCurve cx, cy;
+    static double sens = 1.0;
+    if (!init) {
+        init = 1;
+        pad_mouse_curve_env("PAD_MOUSE_CURVE_X", &cx);
+        pad_mouse_curve_env("PAD_MOUSE_CURVE_Y", &cy);
+        const char* e = getenv("PAD_MOUSE_SENS");
+        if (e && strtod(e, NULL) > 0) sens = strtod(e, NULL);
+    }
+    if (dt < PAD_MOUSE_MIN_DT_S) dt = PAD_MOUSE_MIN_DT_S;
+    if (dt > PAD_MOUSE_MAX_DT_S) dt = PAD_MOUSE_MAX_DT_S;
+    const double vx = dx * sens / dt, vy = dy * sens / dt;
+    const double ax = pad_curve_deflection(&cx, fabs(vx));
+    const double ay = pad_curve_deflection(&cy, fabs(vy));
+    *rx = pad_stick_byte(vx < 0 ? -ax : ax);
+    *ry = pad_stick_byte(vy < 0 ? -ay : ay);
+}
+
+/* PAD_KEYBOARD_LAYOUT=fps: a PC shooter's keyboard and mouse in place of the
+ * pad-shaped layout above. WASD = left stick, mouse = right stick (see
+ * pad_mouse_stick), left/right/middle button = R1/L1/R3, wheel = TRIANGLE,
+ * Space = CROSS, C/Ctrl/Backspace = CIRCLE, E/R = SQUARE, Q = TRIANGLE,
+ * G/F = L2/R2, Shift = L3, V = R3, arrows and 1/2/3/4 = d-pad (up, right,
+ * down, left), Esc/Enter = START, Tab = SELECT. What a button does is the
+ * title's; this follows the usual shooter one (R1 fires, L1 aims, L3 sprints,
+ * R3 melees). The cursor is captured while the window is in the foreground. */
+static u16 pad_keyboard_fps(PadHostState* hs)
+{
+    static const struct { int vk; u16 btn; } map[] = {
+        { PADKEY_SPACE,  CELL_PAD_CTRL_CROSS },   { PADKEY_C,      CELL_PAD_CTRL_CIRCLE },
+        { PADKEY_CTRL,   CELL_PAD_CTRL_CIRCLE },  { PADKEY_BACKSPACE, CELL_PAD_CTRL_CIRCLE },
+        { PADKEY_E,      CELL_PAD_CTRL_SQUARE },  { PADKEY_R,      CELL_PAD_CTRL_SQUARE },
+        { PADKEY_Q,      CELL_PAD_CTRL_TRIANGLE },
+        { PADKEY_G,      CELL_PAD_CTRL_L2 },      { PADKEY_F,      CELL_PAD_CTRL_R2 },
+        { PADKEY_SHIFT,  CELL_PAD_CTRL_L3 },      { PADKEY_V,      CELL_PAD_CTRL_R3 },
+        { PADKEY_UP,     CELL_PAD_CTRL_UP },      { PADKEY_1,      CELL_PAD_CTRL_UP },
+        { PADKEY_RIGHT,  CELL_PAD_CTRL_RIGHT },   { PADKEY_2,      CELL_PAD_CTRL_RIGHT },
+        { PADKEY_DOWN,   CELL_PAD_CTRL_DOWN },    { PADKEY_3,      CELL_PAD_CTRL_DOWN },
+        { PADKEY_LEFT,   CELL_PAD_CTRL_LEFT },    { PADKEY_4,      CELL_PAD_CTRL_LEFT },
+        { PADKEY_ESCAPE, CELL_PAD_CTRL_START },   { PADKEY_RETURN, CELL_PAD_CTRL_START },
+        { PADKEY_TAB,    CELL_PAD_CTRL_SELECT },
+    };
+    static double last_s, wheel_until;
+    u16 btns = 0;
+    for (unsigned i = 0; i < sizeof map / sizeof map[0]; i++)
+        if (pad_key_down(map[i].vk)) btns |= map[i].btn;
+
+    const int lx = pad_key_down(PADKEY_D) - pad_key_down(PADKEY_A);
+    const int ly = pad_key_down(PADKEY_S) - pad_key_down(PADKEY_W);
+    hs->analog_lx = (u8)(lx < 0 ? 0 : lx > 0 ? 255 : 128);
+    hs->analog_ly = (u8)(ly < 0 ? 0 : ly > 0 ? 255 : 128);
+
+    PadMouseInput m;
+    pad_mouse_poll(1, &m);
+    const double now = pad_now_s();
+    pad_mouse_stick(m.dx, m.dy, last_s ? now - last_s : PAD_MOUSE_MAX_DT_S, &hs->analog_rx, &hs->analog_ry);
+    last_s = now;
+    if (m.buttons & PAD_MOUSE_LEFT)   btns |= CELL_PAD_CTRL_R1;
+    if (m.buttons & PAD_MOUSE_RIGHT)  btns |= CELL_PAD_CTRL_L1;
+    if (m.buttons & PAD_MOUSE_MIDDLE) btns |= CELL_PAD_CTRL_R3;
+    if (m.wheel) wheel_until = now + PAD_MOUSE_WHEEL_HOLD_S;
+    if (now < wheel_until) btns |= CELL_PAD_CTRL_TRIANGLE;
+    return btns;
+}
+
