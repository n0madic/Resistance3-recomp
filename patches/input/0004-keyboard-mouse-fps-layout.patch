diff --git a/libs/input/tests/test_pad_keyboard_fps.c b/libs/input/tests/test_pad_keyboard_fps.c
new file mode 100644
index 00000000..5b5f3405
--- /dev/null
+++ b/libs/input/tests/test_pad_keyboard_fps.c
@@ -0,0 +1,166 @@
+/* The keyboard fallback's shooter layout (PAD_KEYBOARD_LAYOUT=fps): the key and
+ * mouse-button map, WASD on the left stick, and mouse motion turned into
+ * right-stick deflection through the title's stick curve (PAD_MOUSE_CURVE_*).
+ *
+ *   clang -std=gnu17 -I include $(sdl2-config --cflags) -I "$(sdl2-config --prefix)/include" \
+ *         libs/input/tests/test_pad_keyboard_fps.c $(sdl2-config --libs) -o /tmp/test_pad_keyboard_fps \
+ *         && /tmp/test_pad_keyboard_fps
+ *
+ * The keyboard and the mouse are fakes: the test defines the call pad_key_down
+ * makes on this host and pad_mouse_poll (pad_mouse.h).
+ */
+#include "../cellPad.c"
+#include <assert.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+u32 cellGcm_flip_request_count(void) { return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+
+/* The fake keyboard, indexed by this host's PADKEY_* codes. */
+static unsigned char s_keys[512];
+#ifdef __APPLE__
+unsigned char CGEventSourceKeyState(int stateID, unsigned short key) { (void)stateID; return s_keys[key & 511]; }
+#else
+const Uint8* SDL_GetKeyboardState(int* n) { if (n) *n = 512; return s_keys; }
+#endif
+
+/* The fake mouse: what the next poll returns, and what the last one asked for. */
+static PadMouseInput s_mouse;
+static int s_capture = -1;
+void pad_mouse_poll(int capture, PadMouseInput* out)
+{
+    s_capture = capture;
+    *out = s_mouse;
+    memset(&s_mouse, 0, sizeof s_mouse);
+}
+
+static void sleep_s(double s)
+{
+    struct timespec ts = { (time_t)s, (long)((s - (double)(time_t)s) * 1e9) };
+    nanosleep(&ts, NULL);
+}
+
+static void test_curve_parse(void)
+{
+    PadStickCurve c;
+    assert(pad_curve_parse("22:0, 28:1.6,127:206", &c) && c.n == 3);
+    assert(c.defl[1] == 28 && c.rate[1] == 1.6 && c.defl[2] == 127 && c.rate[2] == 206);
+    c.n = 99;
+    assert(!pad_curve_parse("", &c));
+    assert(!pad_curve_parse("0:0", &c));                 /* one point is no curve */
+    assert(!pad_curve_parse("10:5,20:6", &c));           /* the first rate must be 0 (no motion) */
+    assert(!pad_curve_parse("20:0,10:5", &c));           /* deflection must increase */
+    assert(!pad_curve_parse("0:0,20:5,30:4", &c));       /* rate must not fall */
+    assert(!pad_curve_parse("0:0,200:5", &c));           /* deflection is 0-127 */
+    assert(!pad_curve_parse("0:0,50", &c));
+    assert(!pad_curve_parse("0:0,50:0", &c));            /* never turns */
+    assert(c.n == 99);                                    /* left alone on failure */
+}
+
+static void test_curve_deflection(void)
+{
+    PadStickCurve c;
+    assert(pad_curve_parse("22:0,28:1.6,96:46.5,127:206", &c));
+    assert(pad_curve_deflection(&c, 0) == 0);            /* no motion: centred, not at the dead zone's edge */
+    assert(fabs(pad_curve_deflection(&c, 0.8) - 25) < 1e-9);   /* inside the first span */
+    assert(fabs(pad_curve_deflection(&c, 1.6) - 28) < 1e-9);
+    assert(fabs(pad_curve_deflection(&c, 46.5) - 96) < 1e-9);
+    assert(fabs(pad_curve_deflection(&c, 126.25) - 111.5) < 1e-9);
+    assert(pad_curve_deflection(&c, 1000) == 127);       /* past the top rate: full */
+}
+
+static void test_stick_byte(void)
+{
+    assert(pad_stick_byte(0) == 128);
+    assert(pad_stick_byte(127) == 255);
+    assert(pad_stick_byte(-127) == 0);                   /* full left reaches 0 */
+    assert(pad_stick_byte(10) == 138);
+    assert(pad_stick_byte(-63.5) == 64);                 /* left is scaled by 128/127 */
+}
+
+/* Needs PAD_MOUSE_* set before the first call (read once). */
+static void test_mouse_stick(void)
+{
+    u8 rx, ry;
+    /* x: dead zone 22, then linear to 105/s at full; y: no curve (linear, full at 1000/s); 0.5 per point */
+    pad_mouse_stick(10, -5, 0.05, &rx, &ry);             /* x 100/s -> 22 + 100 = 122; y -50/s -> -6.35 */
+    assert(rx == 250 && ry == 122);
+    pad_mouse_stick(0, 0, 0.05, &rx, &ry);
+    assert(rx == 128 && ry == 128);
+    pad_mouse_stick(-1000, 1000, 0.05, &rx, &ry);        /* beyond the top rate */
+    assert(rx == 0 && ry == 255);
+    pad_mouse_stick(0.08, 0, 0.001, &rx, &ry);           /* a gap under the minimum counts as the minimum: 5/s */
+    assert(rx == 155);
+    pad_mouse_stick(1, 0, 5.0, &rx, &ry);                /* and one over the maximum as the maximum: 5/s */
+    assert(rx == 155);
+}
+
+static void test_fps_layout(void)
+{
+    PadHostState hs;
+    memset(&hs, 0, sizeof hs);
+    memset(s_keys, 0, sizeof s_keys);
+
+    s_keys[PADKEY_W] = s_keys[PADKEY_D] = 1;
+    s_keys[PADKEY_SPACE] = s_keys[PADKEY_SHIFT] = s_keys[PADKEY_ESCAPE] = 1;
+    s_mouse.buttons = PAD_MOUSE_LEFT | PAD_MOUSE_RIGHT;
+    u16 b = pad_keyboard_fps(&hs);
+    assert(s_capture == 1);
+    assert(b == (CELL_PAD_CTRL_CROSS | CELL_PAD_CTRL_L3 | CELL_PAD_CTRL_START |
+                 CELL_PAD_CTRL_R1 | CELL_PAD_CTRL_L1));
+    assert(hs.analog_lx == 255 && hs.analog_ly == 0);    /* forward and right */
+    assert(hs.analog_rx == 128 && hs.analog_ry == 128);  /* the mouse did not move */
+
+    memset(s_keys, 0, sizeof s_keys);
+    s_keys[PADKEY_A] = s_keys[PADKEY_S] = s_keys[PADKEY_W] = 1;   /* W and S cancel */
+    s_keys[PADKEY_2] = s_keys[PADKEY_LEFT] = s_keys[PADKEY_E] = s_keys[PADKEY_CTRL] = 1;
+    s_mouse.buttons = PAD_MOUSE_MIDDLE;
+    s_mouse.wheel = -1;
+    b = pad_keyboard_fps(&hs);
+    assert(b == (CELL_PAD_CTRL_RIGHT | CELL_PAD_CTRL_LEFT | CELL_PAD_CTRL_SQUARE | CELL_PAD_CTRL_CIRCLE |
+                 CELL_PAD_CTRL_R3 | CELL_PAD_CTRL_TRIANGLE));
+    assert(hs.analog_lx == 0 && hs.analog_ly == 128);
+
+    memset(s_keys, 0, sizeof s_keys);
+    b = pad_keyboard_fps(&hs);                           /* the wheel click is still held... */
+    assert(b == CELL_PAD_CTRL_TRIANGLE);
+    sleep_s(PAD_MOUSE_WHEEL_HOLD_S + 0.02);
+    assert(pad_keyboard_fps(&hs) == 0);                  /* ...for PAD_MOUSE_WHEEL_HOLD_S */
+
+    s_mouse.dx = 100;                                    /* fast to the right: full */
+    pad_keyboard_fps(&hs);
+    assert(hs.analog_rx == 255);
+}
+
+/* The whole poll, unfocused (no window here): everything released, the mouse too. */
+static void test_unfocused_releases_mouse(void)
+{
+    s_capture = -1;
+    s_keys[PADKEY_SPACE] = 1;
+    s_host_state[0].buttons = 0xFFFF;
+    pad_poll_keyboard();
+    assert(s_capture == 0);
+    assert(s_host_state[0].buttons == 0 && s_host_state[0].analog_rx == 128);
+}
+
+int main(void)
+{
+    setenv("PAD_KEYBOARD_LAYOUT", "fps", 1);
+    setenv("PAD_MOUSE_CURVE_X", "22:0,127:105", 1);
+    setenv("PAD_MOUSE_SENS", "0.5", 1);
+    test_curve_parse();
+    test_curve_deflection();
+    test_stick_byte();
+    test_mouse_stick();
+    test_fps_layout();
+    test_unfocused_releases_mouse();
+    printf("test_pad_keyboard_fps: ok\n");
+    return 0;
+}
